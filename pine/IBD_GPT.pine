//@version=6
indicator("IBD Market School [Rules Engine]", shorttitle="IBD MS", overlay=true, max_labels_count=500, max_lines_count=500)

// =============================================================================
// Original reimplementation of the IBD Market School rule set (B1-B10, HH, ED,
// S1-S14, Circuit Breaker, Distribution/Stalling Days, Power Trend, Exposure,
// Restraint) built from the public tradeviZion user guide. Not copied from any
// closed-source script. Apply directly to a major index daily chart
// (e.g. NASDAQ Composite, S&P 500) so volume is meaningful.
//
// Known simplifications (search "APPROX" below to find them in the code):
//   - HH trigger math is inferred, not documented in full detail.
//   - B10 threshold ("distribution count drops significantly") is a tunable
//     guess: default = drop of 2+ from a warning-level count.
//   - Stalling Day "near new highs" proxied as within 3% of the 20-day high.
//   - Volume source is the chart's own volume, not IXIC/TVOL cross-reference.
// =============================================================================

// ============================== INPUTS ======================================
g_ftd = "Follow-Through Day (B1/B2)"
autoVolatility = input.bool(true, "Auto Volatility-Based FTD Threshold", group=g_ftd)
manualFTDPct   = input.float(1.245, "Manual FTD Gain % (if auto off)", step=0.01, group=g_ftd)
volLookback    = input.int(200, "Volatility Lookback (bars)", group=g_ftd)
rallyMaxDays   = input.int(25, "Normal Rally Window (days)", group=g_ftd)
allowLateFTD   = input.bool(true, "Allow Late B1 via Trailing Low After Window", group=g_ftd)

g_dd = "Distribution / Stalling Days"
ddDeclineThresh = input.float(0.2, "Distribution: Min Decline %", step=0.05, group=g_dd)
sdMaxGain       = input.float(0.4, "Stalling: Max Gain %", step=0.05, group=g_dd)
ddExpireDays    = input.int(25, "Signal Expiration (trading days)", group=g_dd)
useIndexRise    = input.bool(true, "Clear DD/SD on Index Rise %", group=g_dd)
indexRisePct    = input.float(6.0, "Index Rise % Threshold", step=0.5, group=g_dd)
fullDDCount     = input.int(6, "Full Distribution Count (S4)", group=g_dd)

g_ema = "21-EMA Rules"
emaBreakPct = input.float(0.2, "S5/S6 Break Threshold %", step=0.05, group=g_ema)
overdueDays = input.int(30, "S6 Overdue Days (since last B3)", group=g_ema)

g_s10 = "Bad Break / Reversal"
badBreakPct      = input.float(2.25, "S10: Min Decline %", step=0.05, group=g_s10)
badBreakRangeLoc = input.float(0.25, "S10: Max Close Location in Range", step=0.05, group=g_s10)
reversalSpread   = input.float(1.75, "S11/B9: Min High-Low Spread %", step=0.05, group=g_s10)
newHighLookback  = input.int(65, "S11: 'New High' Lookback (approx 13 weeks)", group=g_s10)

g_cluster = "Distribution Cluster (S13)"
clusterCount  = input.int(4, "Cluster Count", group=g_cluster)
clusterWindow = input.int(8, "Cluster Window (sessions)", group=g_cluster)

g_cb = "Circuit Breaker"
cbDropPct = input.float(10.0, "Drop From High Since FTD %", step=0.5, group=g_cb)
cbMA50Pct = input.float(5.0, "Intraday % Below 50-SMA", step=0.5, group=g_cb)

g_pt = "Power Trend"
ptDaysAbove21   = input.int(10, "Consecutive Days Low Above 21-EMA Required", group=g_pt)
ptDays21Above50 = input.int(5, "Consecutive Days 21-EMA Above 50-SMA Required", group=g_pt)
ptResumeDays    = input.int(10, "Resume: Clean Days Required", group=g_pt)

g_piv = "Pivot Detection (B8 / S12 / S14)"
pivotLeft  = input.int(5, "Pivot Left Bars", group=g_piv)
pivotRight = input.int(5, "Pivot Right Bars", group=g_piv)

g_b10 = "B10 Threshold"
b10DropAmount = input.int(2, "B10: Min Drop in Distribution Count", group=g_b10)

g_disp = "Display"
showTable    = input.bool(true, "Show Status Table", group=g_disp)
tablePos     = input.string("Top Right", "Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=g_disp)
showLabels   = input.bool(true, "Show Signal Labels", group=g_disp)
showMAs      = input.bool(true, "Show 21/50/200 MAs", group=g_disp)
showBarColor = input.bool(true, "Color Bars (purple=DD/SD, lime=confirmed up)", group=g_disp)
showBg       = input.bool(true, "Shade Background (rally search / distribution zone)", group=g_disp)

// ============================== CORE DATA ====================================
ema21  = ta.ema(close, 21)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

pctChg    = (close - close[1]) / close[1] * 100
rangeLoc  = (high - low) != 0 ? (close - low) / (high - low) : 0.5
higherVol = volume > volume[1]
upDay     = close > close[1]
downDay   = close < close[1]

// ============================== VOLATILITY-BASED FTD THRESHOLD ===============
var float[] upGainsArr = array.new_float(0)
gainVal = upDay ? pctChg : na
if not na(gainVal)
    array.push(upGainsArr, gainVal)
    if array.size(upGainsArr) > volLookback
        array.shift(upGainsArr)

avgVol = array.size(upGainsArr) > 0 ? array.sum(upGainsArr) / array.size(upGainsArr) : 0.0
ftdReqPct = not autoVolatility ? manualFTDPct :
     avgVol < 0.4 ? 0.7 :
     avgVol < 0.55 ? 0.85 :
     avgVol < 1.0 ? 1.0 :
     1.245

// ============================== DISTRIBUTION / STALLING DAYS =================
nearHighs20 = close >= ta.highest(high, 20) * 0.97  // APPROX: "near new highs" proxy
isDD = downDay and higherVol and pctChg <= -ddDeclineThresh
isSD = higherVol and pctChg >= 0 and pctChg < sdMaxGain and rangeLoc < 0.5 and nearHighs20

var float[] ddCloseArr = array.new_float(0)
var int[]   ddBarArr   = array.new_int(0)
var int[]   ddTypeArr  = array.new_int(0)  // 0 = DD, 1 = SD

if isDD or isSD
    array.push(ddCloseArr, close)
    array.push(ddBarArr, bar_index)
    array.push(ddTypeArr, isSD ? 1 : 0)

int expiredToday = 0
if array.size(ddBarArr) > 0
    i = array.size(ddBarArr) - 1
    while i >= 0
        entryClose = array.get(ddCloseArr, i)
        entryBar   = array.get(ddBarArr, i)
        age        = bar_index - entryBar
        risenAway  = useIndexRise and close > entryClose * (1 + indexRisePct / 100)
        agedOut    = age > ddExpireDays
        if agedOut or risenAway
            array.remove(ddCloseArr, i)
            array.remove(ddBarArr, i)
            array.remove(ddTypeArr, i)
            expiredToday += 1
        i -= 1

ddCount = array.size(ddBarArr)

int clusterN = 0
if array.size(ddBarArr) > 0
    for i = 0 to array.size(ddBarArr) - 1
        if bar_index - array.get(ddBarArr, i) <= clusterWindow
            clusterN += 1

var int prevDdCount   = 0
var int prevClusterN  = 0

isS3   = ddCount == (fullDDCount - 1) and ddCount > prevDdCount
isS4   = ddCount >= fullDDCount and ddCount > prevDdCount
isS13  = clusterN >= clusterCount and prevClusterN < clusterCount
isB10  = ddCount <= math.max(prevDdCount - b10DropAmount, 0) and prevDdCount >= (fullDDCount - 1) and ddCount < prevDdCount

// ============================== RALLY ATTEMPT / MAJOR LOW / B1 / B2 ==========
var bool  buySwitch      = false
var bool  restraint      = false
var int   exposure       = 0

var bool  rallyActive     = false
var int   rallyDay        = 0
var float rallyLow        = na
var int   rallyStartBar   = na
var float rallySinceHigh  = na

var float majorLow        = na
var float ftdLow          = na
var float ftdClose        = na
var int   ftdBarIndex     = na

var bool  trailingLowActive = false
var float trailingLow       = na

var bool  minorLowActive    = false
var bool  minorLowConfirmed = false
var float minorLow          = na

var bool  hhActive = false
var float hhLevel  = na

bool dayOneToday = false

if not rallyActive and not buySwitch
    isPinkRally = downDay and rangeLoc >= 0.5
    if (upDay or isPinkRally) and close[1] < close[2]
        rallyActive    := true
        rallyDay       := 1
        rallyLow       := low
        rallyStartBar  := bar_index
        rallySinceHigh := high
        dayOneToday    := true
else if rallyActive and not buySwitch
    if low < rallyLow
        rallyActive := false
        rallyDay    := 0
    else
        rallyDay       := rallyDay + 1
        rallySinceHigh := math.max(nz(rallySinceHigh, high), high)

if allowLateFTD and rallyActive and not buySwitch and rallyDay > rallyMaxDays
    trailingLowActive := true
    trailingLow := na(trailingLow) ? low : math.min(trailingLow, low)

ftdDayCandidate = rallyActive and not buySwitch and rallyDay >= 4 and
     (rallyDay <= rallyMaxDays or (allowLateFTD and trailingLowActive))

bool isB1 = ftdDayCandidate and pctChg >= ftdReqPct and higherVol

// HH: buy switch turns on without an FTD if price exceeds the rally's running high (APPROX)
bool isHH = false
if not buySwitch and rallyActive and not na(rallySinceHigh) and close > rallySinceHigh[1] and not isB1
    isHH    := true
    hhActive := true
    hhLevel  := rallySinceHigh[1]

if hhActive and not na(hhLevel) and close < hhLevel and buySwitch and not isB1
    hhActive  := false
    buySwitch := false

bool isB2 = buySwitch and not isB1 and not na(rallyStartBar) and
     (bar_index - rallyStartBar <= rallyMaxDays) and not na(ftdLow) and
     close > ftdLow and pctChg >= ftdReqPct and higherVol

if isB1
    buySwitch      := true
    restraint      := true
    ftdClose       := close
    ftdLow         := low
    ftdBarIndex    := bar_index
    majorLow       := trailingLowActive ? trailingLow : rallyLow
    rallyActive    := false
    rallyDay       := 0
    trailingLowActive := false
    trailingLow    := na
    hhActive       := false
    exposure       := 2
    array.clear(ddCloseArr)
    array.clear(ddBarArr)
    array.clear(ddTypeArr)

// S1: FTD undercut
bool isS1 = buySwitch and not na(ftdLow) and close < ftdLow and close[1] >= ftdLow

// S2: major low undercut -> full reset
bool isS2 = buySwitch and not na(majorLow) and low < majorLow

// Minor low lifecycle (starts on S4, confirmed by next B1/B2, checked for undercut)
if isS4
    minorLowActive     := true
    minorLowConfirmed  := false
    minorLow           := low
else if minorLowActive and not minorLowConfirmed
    minorLow := math.min(nz(minorLow, low), low)

if minorLowActive and not minorLowConfirmed and (isB1 or isB2)
    minorLowConfirmed := true

bool isS2ml = buySwitch and minorLowActive and minorLowConfirmed and not na(minorLow) and low < minorLow
if isS2ml
    minorLowActive    := false
    minorLowConfirmed := false

// ============================== 21-EMA RULES (B3/B4/B5, S5/S6/S7/S8) =========
var bool emaArmedUp   = false   // true after B3, reset by S5/S6
var bool emaArmedDown = false   // true after S5/S6, reset by B3
var int  daysAboveEma      = 0  // consecutive, for B4
var int  daysBelowEma      = 0  // consecutive down-days with high<EMA, for S7
var int  totalDaysAboveEma = 0  // non-consecutive, for B5
var int  totalDaysBelowEma = 0  // non-consecutive, for S8
var int  barsSinceB3       = na

lowAboveEma  = low >= ema21
highBelowEma = high < ema21

if not na(barsSinceB3)
    barsSinceB3 := barsSinceB3 + 1

if lowAboveEma
    daysAboveEma += 1
else
    daysAboveEma := 0

if highBelowEma and downDay
    daysBelowEma += 1
else if not highBelowEma
    daysBelowEma := 0

bool isB3 = buySwitch and (upDay or close == close[1]) and lowAboveEma and not emaArmedUp
if isB3
    emaArmedUp        := true
    emaArmedDown       := false
    barsSinceB3        := 0
    totalDaysAboveEma  := 0

if lowAboveEma
    totalDaysAboveEma += 1

bool isB4 = buySwitch and emaArmedUp and daysAboveEma == 5
bool isB5 = buySwitch and emaArmedUp and totalDaysAboveEma >= 10 and totalDaysAboveEma % 5 == 0

belowEmaThresh = close < ema21 * (1 - emaBreakPct / 100)
bool isBreakEvent = buySwitch and emaArmedUp and belowEmaThresh
bool isS6 = isBreakEvent and not na(barsSinceB3) and barsSinceB3 > overdueDays
bool isS5 = isBreakEvent and not isS6

if isBreakEvent
    emaArmedUp        := false
    emaArmedDown       := true
    totalDaysBelowEma  := 0

if highBelowEma
    totalDaysBelowEma += 1

bool isS7 = buySwitch and emaArmedDown and daysBelowEma == 5
bool isS8 = buySwitch and emaArmedDown and totalDaysBelowEma >= 10 and totalDaysBelowEma % 5 == 0

// ============================== 50-SMA RULES (B6/S9) ==========================
var bool above50Latched = false
var bool b6EverFired    = false

bool isB6 = buySwitch and close > sma50 and sma50 > sma50[1] and not above50Latched
if close < sma50
    above50Latched := false
if isB6
    above50Latched := true
    b6EverFired    := true

bool isS9 = buySwitch and b6EverFired and close < sma50 and close[1] >= sma50
if isS9
    b6EverFired := false

// ============================== B7 ACCUMULATION DAY ===========================
bool isB7 = buySwitch and not na(rallyStartBar) and (bar_index - rallyStartBar > rallyMaxDays) and
     higherVol and pctChg >= ftdReqPct and rangeLoc >= 0.75

// ============================== PIVOT-BASED (B8/S12/S14, S11/B9) =============
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPivotHigh  = na
var float lastPivotLow   = na
var float lastHigherHigh = na

if not na(ph)
    lastPivotHigh := ph
if not na(pl)
    lastPivotLow := pl

bool isB8 = buySwitch and not na(lastPivotHigh) and close > lastPivotHigh and close[1] <= lastPivotHigh
if isB8
    lastHigherHigh := lastPivotHigh

bool isS14 = buySwitch and not na(lastHigherHigh) and close < lastHigherHigh and close[1] >= lastHigherHigh
bool isS12 = buySwitch and not na(lastPivotLow) and close < lastPivotLow and close[1] >= lastPivotLow

var float reversalTop = na
newHigh13w = high >= ta.highest(high, newHighLookback)
spreadPct  = low != 0 ? (high - low) / low * 100 : 0.0
bool isS11 = buySwitch and newHigh13w and downDay and rangeLoc <= 0.25 and spreadPct >= reversalSpread
if isS11
    reversalTop := high

bool isB9 = buySwitch and not na(reversalTop) and close > reversalTop and close[1] <= reversalTop

// ============================== S10 BAD BREAK =================================
bool isS10 = buySwitch and pctChg <= -badBreakPct and rangeLoc < badBreakRangeLoc and (close < sma50 or high < ema21)

// ============================== CIRCUIT BREAKER ================================
var float highSinceFTD = na
if isB1
    highSinceFTD := high
else if buySwitch
    highSinceFTD := math.max(nz(highSinceFTD, high), high)

dropCond = buySwitch and not na(highSinceFTD) and
     (close <= highSinceFTD * (1 - cbDropPct / 100) or low <= highSinceFTD * (1 - cbDropPct / 100))
ma50Cond = low <= sma50 * (1 - cbMA50Pct / 100)
bool isCB = dropCond and ma50Cond

// ============================== POWER TREND =====================================
var string ptState           = "OFF"
var int    daysCleanForResume = 0
var int    days21Above50Cnt   = 0

if ema21 > sma50
    days21Above50Cnt += 1
else
    days21Above50Cnt := 0

ptFullConditions = buySwitch and daysAboveEma >= ptDaysAbove21 and days21Above50Cnt >= ptDays21Above50 and sma50 > sma50[1]
pressureFloorTrig   = isS2ml or isS13
pressureNoFloorTrig = isS9
offTrig             = isS2 or ta.crossunder(ema21, sma50) or isCB

if ptFullConditions and ptState != "ON" and ptState != "RESUME"
    ptState := "ON"

if pressureFloorTrig
    ptState := "PRESSURE_FLOOR"
    daysCleanForResume := 0
if pressureNoFloorTrig
    ptState := "PRESSURE_NOFLOOR"
    daysCleanForResume := 0
if offTrig
    ptState := "OFF"
    daysCleanForResume := 0

if ptState == "PRESSURE_FLOOR" or ptState == "PRESSURE_NOFLOOR"
    if not (pressureFloorTrig or pressureNoFloorTrig or offTrig)
        daysCleanForResume += 1
    if daysCleanForResume >= ptResumeDays and ptFullConditions
        ptState := "RESUME"

ptMaxExposure   = ptState == "ON" or ptState == "RESUME" ? 7 : 5
ptFloorExposure = ptState == "ON" or ptState == "RESUME" ? 2 : ptState == "PRESSURE_FLOOR" ? 1 : 0

// ============================== RESTRAINT RULE ==================================
if restraint and not na(ftdClose) and (isB4 or close > ftdClose * 1.01)
    restraint := false

// ============================== EXPOSURE AGGREGATION ============================
int chg = 0
if isB2 or isB3 or isB4 or isB5 or isB6 or isB7 or isB8 or isB9 or isB10 or isHH
    chg += 1
if isS1
    chg -= 2
if isS2ml
    chg -= 2
if isS3
    chg -= 1
if isS4
    chg -= 1
if isS5
    chg -= 1
if isS6
    chg -= 1
if isS7
    chg -= 1
if isS8
    chg -= 1
if isS9
    chg -= 1
if isS10
    chg -= 1
if isS11
    chg -= 1
if isS12
    chg -= 1
if isS13
    chg -= 1
if isS14
    chg -= 1

if buySwitch and not isB1
    exposure := math.max(0, exposure + chg)

if restraint
    exposure := math.min(exposure, 2)

exposure := math.min(exposure, ptMaxExposure)
if ptFloorExposure > 0 and buySwitch
    exposure := math.max(exposure, ptFloorExposure)

if isS2
    exposure       := 0
    buySwitch       := false
    restraint       := false
    ptState         := "OFF"
    rallyActive     := false
    rallyDay        := 0
    minorLowActive  := false

if isCB
    exposure       := 0
    buySwitch       := false
    restraint       := false
    ptState         := "OFF"
    rallyActive     := false
    rallyDay        := 0
    minorLowActive  := false

prevDdCount  := ddCount
prevClusterN := clusterN

// ============================== VISUALS =========================================
plot(showMAs ? ema21 : na, "21 EMA", color=color.green, linewidth=1)
plot(showMAs ? sma50 : na, "50 SMA", color=color.red, linewidth=1)
plot(showMAs ? sma200 : na, "200 SMA", color=color.black, linewidth=2)

string labelsTxt = (isB1 ? "B1: Follow-Through Day (+2)\n" : "") +
                   (isB2 ? "B2: Additional FTD (+1)\n" : "") +
                   (isB3 ? "B3: Low >= 21EMA (+1)\n" : "") +
                   (isB4 ? "B4: Trending Above 21EMA (+1)\n" : "") +
                   (isB5 ? "B5: Living Above 21EMA (+1)\n" : "") +
                   (isB6 ? "B6: Close > Rising 50SMA (+1)\n" : "") +
                   (isB7 ? "B7: Accumulation Day (+1)\n" : "") +
                   (isB8 ? "B8: Higher High (+1)\n" : "") +
                   (isB9 ? "B9: Reversal Recovery (+1)\n" : "") +
                   (isB10 ? "B10: Distribution Falling (+1)\n" : "") +
                   (isHH ? "HH: Higher High, No FTD\n" : "") +
                   (isS1 ? "S1: FTD Undercut (-2)\n" : "") +
                   (isS2 ? "S2: Major Low Undercut (RESET)\n" : "") +
                   (isS2ml ? "S2ml: Minor Low Undercut (-2)\n" : "") +
                   (isS3 ? "S3: Full Distribution - 1 (-1)\n" : "") +
                   (isS4 ? "S4: Full Distribution (-1)\n" : "") +
                   (isS5 ? "S5: Break Below 21EMA (-1)\n" : "") +
                   (isS6 ? "S6: Overdue Break 21EMA (-1)\n" : "") +
                   (isS7 ? "S7: Trending Below 21EMA (-1)\n" : "") +
                   (isS8 ? "S8: Living Below 21EMA (-1)\n" : "") +
                   (isS9 ? "S9: Break Below 50SMA (-1)\n" : "") +
                   (isS10 ? "S10: Bad Break (-1)\n" : "") +
                   (isS11 ? "S11: Downside Reversal (-1)\n" : "") +
                   (isS12 ? "S12: Lower Low (-1)\n" : "") +
                   (isS13 ? "S13: Distribution Cluster (-1)\n" : "") +
                   (isS14 ? "S14: Break Below Higher High (-1)\n" : "") +
                   (isCB ? "CB: CIRCUIT BREAKER (RESET)\n" : "")

string markerIds = (isB1 ? "B1 " : "") +
                   (isB2 ? "B2 " : "") +
                   (isB3 ? "B3 " : "") +
                   (isB4 ? "B4 " : "") +
                   (isB5 ? "B5 " : "") +
                   (isB6 ? "B6 " : "") +
                   (isB7 ? "B7 " : "") +
                   (isB8 ? "B8 " : "") +
                   (isB9 ? "B9 " : "") +
                   (isB10 ? "B10 " : "") +
                   (isHH ? "HH " : "") +
                   (isS1 ? "S1 " : "") +
                   (isS2 ? "S2 " : "") +
                   (isS2ml ? "S2ml " : "") +
                   (isS3 ? "S3 " : "") +
                   (isS4 ? "S4 " : "") +
                   (isS5 ? "S5 " : "") +
                   (isS6 ? "S6 " : "") +
                   (isS7 ? "S7 " : "") +
                   (isS8 ? "S8 " : "") +
                   (isS9 ? "S9 " : "") +
                   (isS10 ? "S10 " : "") +
                   (isS11 ? "S11 " : "") +
                   (isS12 ? "S12 " : "") +
                   (isS13 ? "S13 " : "") +
                   (isS14 ? "S14 " : "") +
                   (isCB ? "CB " : "")

plotCondition = buySwitch or (buySwitch != buySwitch[1]) or isB1
if markerIds != "" and plotCondition and showLabels
    lblUp   = chg > 0 or isB1
    lblColor = lblUp ? color.new(color.green, 75) : color.new(color.red, 75)
    txtColor = lblUp ? color.green : color.red
    label.new(bar_index, high, markerIds, tooltip=labelsTxt, color=lblColor, textcolor=txtColor, style=label.style_label_down, size=size.tiny)

barcolor(showBarColor ? (isDD or isSD ? color.purple : (isB1 or (buySwitch and upDay)) ? color.lime : na) : na)

bgcolor(showBg and rallyActive and not buySwitch ? color.new(color.blue, 92) : na, title="Rally Search BG")
bgcolor(showBg and ddCount >= (fullDDCount - 1) ? color.new(color.red, 96) : na, title="Distribution Zone BG")

// ============================== STATUS TABLE ====================================
f_tblPos() =>
    p = position.top_right
    if tablePos == "Bottom Right"
        p := position.bottom_right
    else if tablePos == "Top Left"
        p := position.top_left
    else if tablePos == "Bottom Left"
        p := position.bottom_left
    p

dotsFor(e) =>
    n = math.min(math.max(e, 0), 5)
    string s = ""
    for i = 1 to 5
        if i <= n
            s := s + (i == 1 ? "\u25CF" : i == 2 ? "\u25CF" : "\u25CF")
        else
            s := s + "\u25CB"
    s

expPct(e) =>
    e <= 0 ? "0%" : e == 1 ? "30%" : e == 2 ? "55%" : e == 3 ? "75%" : e == 4 ? "90%" : "100%+"

var table statusTbl = table.new(f_tblPos(), 2, 12, bgcolor=color.new(color.gray, 90), border_color=color.gray, border_width=1)

if showTable and barstate.islast
    table.cell(statusTbl, 0, 0, "MARKET SCHOOL", text_color=color.white, bgcolor=color.blue, text_size=size.small)
    table.cell(statusTbl, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.blue, text_size=size.small)

    table.cell(statusTbl, 0, 1, "Buy Switch", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 1, buySwitch ? "ON" : "OFF", bgcolor=buySwitch ? color.green : color.red, text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 2, "Exposure", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 2, dotsFor(exposure) + "  " + expPct(exposure) + " (" + str.tostring(exposure) + ")", text_color=color.white, text_size=size.small)

    ptColor = ptState == "ON" or ptState == "RESUME" ? color.lime : ptState == "PRESSURE_FLOOR" ? color.yellow : ptState == "PRESSURE_NOFLOOR" ? color.orange : color.gray
    table.cell(statusTbl, 0, 3, "Power Trend", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 3, ptState + " (Floor +" + str.tostring(ptFloorExposure) + ", Max +" + str.tostring(ptMaxExposure) + ")", bgcolor=ptColor, text_color=color.black, text_size=size.small)

    table.cell(statusTbl, 0, 4, "Restraint", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 4, restraint ? "ON" : "OFF", bgcolor=restraint ? color.orange : color.green, text_color=color.white, text_size=size.small)

    ddBg = ddCount >= fullDDCount ? color.red : ddCount >= fullDDCount - 2 ? color.orange : color.green
    table.cell(statusTbl, 0, 5, "Dist. Days", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 5, str.tostring(ddCount) + " / " + str.tostring(fullDDCount), bgcolor=ddBg, text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 6, "Cluster (8-day)", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 6, str.tostring(clusterN) + " / " + str.tostring(clusterCount), text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 7, "Rally Day", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 7, rallyActive ? str.tostring(rallyDay) : "-", text_color=color.white, text_size=size.small)

    lowStatus = minorLowActive ? (minorLowConfirmed ? "Minor Low set" : "Minor Low pending") : (buySwitch ? "Major Low set" : "-")
    table.cell(statusTbl, 0, 8, "Low Status", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 8, lowStatus, text_color=color.white, text_size=size.small)

    chgColor = pctChg >= 0 ? color.green : color.red
    table.cell(statusTbl, 0, 9, "Day Change", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 9, (pctChg >= 0 ? "+" : "") + str.tostring(math.round(pctChg, 2)) + "%", bgcolor=chgColor, text_color=color.white, text_size=size.small)

    volRatio = volume[1] > 0 ? volume / volume[1] * 100 : 0.0
    table.cell(statusTbl, 0, 10, "Volume", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 10, str.tostring(math.round(volRatio, 0)) + "% of prior", bgcolor=higherVol ? color.purple : color.gray, text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 11, "FTD Req %", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 11, str.tostring(math.round(ftdReqPct, 3)) + "%", text_color=color.white, text_size=size.small)

// ============================== ALERTS ===========================================
alertcondition(isB1, title="B1: Follow-Through Day", message="{{ticker}} - B1 Follow-Through Day. Exposure +2.")
alertcondition(isS1 or isS2 or isS2ml, title="Major/Minor Low or FTD Sell", message="{{ticker}} - Low undercut or FTD undercut sell signal.")
alertcondition(isCB, title="Circuit Breaker", message="{{ticker}} - CIRCUIT BREAKER triggered. Exposure forced to 0.")
alertcondition(isS4, title="S4: Full Distribution", message="{{ticker}} - Full distribution count reached.")
alertcondition(isDD or isSD, title="Distribution/Stalling Day", message="{{ticker}} - Distribution or stalling day detected.")
alertcondition(isB2 or isB3 or isB4 or isB5 or isB6 or isB7 or isB8 or isB9 or isB10 or isHH, title="Buy Signal", message="{{ticker}} - Buy signal triggered. Exposure +1.")
alertcondition(isS3 or isS5 or isS6 or isS7 or isS8 or isS9 or isS10 or isS11 or isS12 or isS13 or isS14, title="Sell Signal", message="{{ticker}} - Sell signal triggered. Exposure -1.")
