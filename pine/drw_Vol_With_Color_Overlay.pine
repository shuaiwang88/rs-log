// 

//@version=6
indicator(title = 'Volume With Color', shorttitle = 'Vol W/ Color', overlay = true, max_labels_count = 500)

//inputs
var g1 = 'Moving Average'
showMA = input(true, 'Show Moving Average', group = g1)
ilength = input.int(50, 'MA Length', minval = 1, maxval = 500, step = 1, inline = '1', group = g1)
macolor = input(color.orange, 'MA Color', inline = '1', group = g1)
upDnCol = input.bool(true, 'Color MA Based on Up Down Ratio', group = g1)

var g2 = 'Display'
idownday = input(color.rgb(200, 171, 200, 45), 'Down Day Color', inline = '1', group = g2)
idday = input(color.maroon, 'Distribution Color', inline = '1', group = g2)
iupday = input(color.rgb(91, 167, 90, 33), 'Up Day Color', inline = '2', group = g2)
iaday = input(color.rgb(5, 68, 38), 'Acumulation Day Color', inline = '2', group = g2)
dryUpBool  = input.bool(true, 'Show Volume Dry Ups', inline = '3', group = g2)
dryUp      = input(color.orange, ' ', inline = '3', group = g2)
dryUpReq   = input.int(45, 'Dry Up Lvl 1 %', inline = '3', tooltip = '50 = 50% below average (light gray bars)')
dryUpReq2  = input.int(60, 'Lvl 2 %', inline = '3', tooltip = '60 = 60% below average (dark gray bars)', group = g2)
minDryUpDays = input.int(3, 'Min Consecutive Dry-Up Days (Signal)', minval = 1, maxval = 10, group = g2, tooltip = 'Number of consecutive Lvl 1 dry-up bars required to fire the dry-up signal label and alert.')
plotstyle  = input.string('Columns', 'Plot Style', options = ['Columns', 'Histogram', 'Line'])

var g3 = 'Info'
showpp = input.bool(true, 'Show Pocket Pivots', inline = '1', group = g3)
tenDay = input.bool(true, '10 Day P.P.', inline = '2', group = g3)
pp10color = input(color.yellow, '', inline = '2', group = g3)
fiveDay = input.bool(true, '5 Day P.P.', inline = '2', group = g3)
pp5color = input(color.blue, '', inline = '2', group = g3)
showProjected = input.bool(true, 'Show Projected Volume Bar', inline = '3', group = g3)
projColor = input.color(color.new(color.aqua, 80), ' ', inline = '3', group = g3)
showTable = input.bool(true, 'Show Volume Info', inline = '4', group = g3)
yPos = input.string('Top', ' ', options = ['Top', 'Middle', 'Bottom'], inline = '4', group = g3)
xPos = input.string('Right', ' ', options = ['Right', 'Center', 'Left'], inline = '4', group = g3)
addInfo = input.bool(false, 'Show Additional Volume Info', inline = '5', group = g3)
tableSize = input.string('Normal', 'Text Size', options = ['Tiny', 'Small', 'Normal', 'Large'], inline = '6', group = g3)
textColor = input.color(color.rgb(0, 0, 0), 'Text Color', inline = '7', group = g3)
bgColor = input.color(color.new(color.rgb(192, 195, 206), 70), 'Background Color', inline = '7', group = g3)

var g4 = 'Highest Volumes'
showSky = input.bool(true, 'Show Skyscrappers', inline = '1', group = g4)
showPer = input.bool(true, 'Percentages', inline = '1', group = g4)
showHVE = input.bool(false, 'Show Highest Volume Ever', inline = '2', group = g4)
showHV1 = input.bool(false, 'Show Highest Volume In a Year', inline = '3', group = g4)
labelSize = input.string('Normal', 'Text Size', options = ['Tiny', 'Small', 'Normal', 'Large'], inline = '4', group = g4)
colorHV = input.bool(false, 'Text Color Based on Previous Close', inline = '5', group = g4)
showLines = input.bool(false, 'Show 2x, 3x Volume Lines', inline = '6', group = g4)
lineColor = input.color(color.black, ' ', inline = '6', group = g4)

// --- Distribution Day (Stall Day) ---
var g5 = 'Distribution Day (Stall)'
showStallDay   = input.bool(true, 'Show Stall Distribution Days', group = g5)
stallColor     = input.color(color.maroon, 'Stall Day Color', group = g5)

// --- Churning ---
var g6 = 'Churning'
showChurn      = input.bool(true,  'Show Churning Days', group = g6)
churnColor     = input.color(color.purple, 'Churning Color', group = g6)
churnVolMult   = input.float(1.2,  'Min Volume (x Avg)', minval = 0.5, maxval = 5.0, step = 0.1, group = g6, tooltip = 'Volume must be at least this multiple of the moving average. Default 1.0 = at or above average.')
churnPctThresh = input.float(0.25, 'Max Price Change % (abs)', minval = 0.0, maxval = 2.0, step = 0.05, group = g6, tooltip = 'Absolute close-to-close change must be less than this %. Default 0.25%.')
churnRangePct  = input.float(50.0, 'Close in Lower X% of Range', minval = 1.0, maxval = 100.0, step = 5.0, group = g6, tooltip = 'Close must be in the lower X% of the high-low range. Default 50%.')

// --- Price Moving Averages ---
var gMA = 'Price Moving Averages'
showEMA10      = input.bool(true,  'Show 10D EMA',  inline = '1', group = gMA)
ema10Color     = input.color(color.new(#00bcd4, 0), '',            inline = '1', group = gMA)
showEMA21      = input.bool(true,  'Show 21D EMA',  inline = '2', group = gMA)
ema21Color     = input.color(color.new(#8bc34a, 0), '',            inline = '2', group = gMA)
showSMA50      = input.bool(true,  'Show 50D SMA',  inline = '3', group = gMA)
sma50Color     = input.color(color.new(#ff9800, 0), '',            inline = '3', group = gMA)
showSMA200     = input.bool(true,  'Show 200D SMA', inline = '4', group = gMA)
sma200Color    = input.color(color.new(#f44336, 0), '',            inline = '4', group = gMA)
maProxPct      = input.float(0.8,  'Proximity Alert % (price near MA)', minval = 0.05, maxval = 5.0, step = 0.05, group = gMA, tooltip = 'Fire an alert when close is within this % of any Price MA.')

// --- 3-Day Lower Low on Increased Volume ---
var g7 = '3-Day Lower Low (3LL)'
show3LL        = input.bool(true,  'Show 3-Day Lower Low Signal', group = g7)
llColor3       = input.color(color.new(color.red, 75), 'Background Color', group = g7, tooltip = 'Bar background color when 3 consecutive lower lows on increasing volume are detected.')

useHigh = input.bool(false, "Use highest high of day instead of highest close for prior high")
mode         = input.string("Rolling window", "Prior high mode", options=["Rolling window", "All history (ATH)"])
lookback     = input.int(252, "Rolling window length (bars)", minval=2)

// --- Volume Overlay Scaling ---
var gScale = 'Volume Overlay Scaling'
volHeightPct   = input.float(15, 'Volume Height (% of price range)', minval = 5, maxval = 50, group = gScale) / 100
scaleLookback  = input.int(150, 'Scaling Lookback (bars)', group = gScale)

hiSeries = useHigh ? high : close

// Prior High (exclude current bar)
priorHigh_roll = ta.highest(hiSeries, lookback + 1)[1]
var float priorHigh_ath = na
priorHigh_ath := na(priorHigh_ath[1]) ? hiSeries[1] : math.max(priorHigh_ath[1], hiSeries[1])
priorHigh = mode == "Rolling window" ? priorHigh_roll : priorHigh_ath

// Plot prior high price
plot(priorHigh, "Prev High", color=color.orange, linewidth=1, display = display.none)

// Plot current/latest price
plot(close, "Current Price", color=color.green, linewidth=1, display = display.none)

// % distance
pctFromPrior = na(priorHigh) or priorHigh == 0.0 ? na : 100.0 * (close - priorHigh) / priorHigh
plot(pctFromPrior, "Pct from Prev High (%)", color=color.blue, linewidth=2, display = display.none)

// 52-week high detection - adjusted for different timeframes
weeks52InSeconds = 52 * 7 * 24 * 60 * 60
currentTfSeconds = timeframe.in_seconds()
barsFor52Weeks = math.ceil(weeks52InSeconds / currentTfSeconds)

lookback52w = timeframe.isweekly ? 52 : 
              timeframe.ismonthly ? 12 : 
              timeframe.isdaily ? 252 :
              math.min(barsFor52Weeks, 252)

weekHigh52 = ta.highest(hiSeries, lookback52w)
is52WeekHigh = close >= weekHigh52 and barstate.isconfirmed

plotshape(
    is52WeekHigh, 
    title="52H", 
    style=shape.flag, 
    location=location.top, 
    color=color.new(color.green, 0), 
    size=size.tiny
    // text="H"
)

alertcondition(
    is52WeekHigh, 
    title="52-Week High Alert", 
    message="{{ticker}} has reached a new 52-week high at {{close}} on {{interval}} chart"
)
//////////////////////

sizer = switch tableSize
    'Normal' => size.normal
    'Tiny' => size.tiny
    'Small' => size.small
    'Large' => size.large

sizerLabel = switch labelSize
    'Normal' => size.normal
    'Tiny' => size.tiny
    'Small' => size.small
    'Large' => size.large

//define days
down_day = close < close[1]
up_day = close > close[1]
avg_vol = ta.sma(volume, ilength)
d_day = down_day and volume > avg_vol
a_day = up_day and volume > avg_vol
highVolYear = ta.highest(volume, 252)
ph = ta.pivothigh(volume, 13, 13)
twoX = avg_vol * 2
threeX = avg_vol * 3
avgDollarVol = avg_vol * close
upVol = close > close[1] ? volume : 0
dnVol = close < close[1] ? volume : 0
sumUp = math.sum(upVol, 50)
sumDn = math.sum(dnVol, 50)
upDnVolRatio = sumUp / sumDn
// ATR 14
avgAtr              = ta.rma( ta.tr(true), 21 ) 
avgAtr             := bar_index < 21 ? 0 : avgAtr
avgAtrPcnt          = avgAtr/close*100
// Beta 1-Year vs SPY (252 bars)
spyClose  = request.security("SPY", timeframe.period, close)
assetRet  = close[1] != 0 ? (close - close[1]) / close[1] : na
spyRet    = spyClose[1] != 0 ? (spyClose - spyClose[1]) / spyClose[1] : na
beta1y    = ta.correlation(assetRet, spyRet, 252) * ta.stdev(assetRet, 252) / ta.stdev(spyRet, 252)

// --- Volume Dry Up Levels ---
// Level 1: dryUpReq % below average  (default 35% → bar < 65% of avg) — light gray
// Level 2: dryUpReq2 % below average (default 45% → bar < 55% of avg) — dark gray
volRatioPct  = volume / avg_vol * 100
volDry1      = volRatioPct < (100 - dryUpReq)
volDry2      = volRatioPct < (100 - dryUpReq2)
dryUpLevel1  = avg_vol * (1 - dryUpReq  / 100.0)
dryUpLevel2  = avg_vol * (1 - dryUpReq2 / 100.0)

// legacy single-threshold flag used for table tooltip
volDry = volDry1

// --- Consecutive Dry-Up Counter & Signal (CANSLIM-style) ---
// Counts consecutive bars where Lvl 1 dry-up is active, then fires a label + alert
var int dryUpCount = 0
dryUpCount := volDry1 ? dryUpCount + 1 : 0
dryUpSignal = dryUpBool and dryUpCount >= minDryUpDays

// Turns on when signal is reached, stays on until streak fully breaks
var bool streakActive = false
streakActive := dryUpSignal ? true : dryUpCount == 0 ? false : streakActive

// dryUpCount > 0 ensures the non-dry breaking bar is never colored
bgcolor(streakActive and dryUpCount > 0 ? color.new(#c2b00e, 33) : na, title = 'Dry-Up')

// bgcolor(dryUpSignal? color.new(#c2b00e, 33) : na, title = 'Dry-Up')

// Background highlight on every Lvl 1 dry-up bar (only when dry-up display is on)

// --- Volume Overlay Scaling helper (defined after avg_vol/dry-up vars so hiRef/loRef reflect visible range) ---
hiRef      = ta.highest(high, scaleLookback)
loRef      = ta.lowest(low, scaleLookback)
priceRange = hiRef - loRef
volMaxRef  = ta.highest(volume, scaleLookback)

f_scaleVol(v) =>
    loRef + (v / volMaxRef) * priceRange * volHeightPct

// Label fires once when the streak first reaches minDryUpDays
if dryUpSignal and not dryUpSignal[1]
    label.new(bar_index, f_scaleVol(volume),
         'D' + str.tostring(dryUpCount) + 'D',
         color = color.new(#af914c, 0), textcolor = color.white,
         style = label.style_label_up, size = size.tiny)

// --- Stall Distribution Day logic ---
dayRange      = high - low
closeChgPct   = close[1] != 0 ? (close - close[1]) / close[1] * 100 : na
inLower25     = dayRange > 0 ? close <= low + 0.27 * dayRange : false
stallDay      = closeChgPct >= 0 and closeChgPct < 0.1 and inLower25

// --- Churning Day logic ---
churnAbsChg  = na(closeChgPct) ? na : math.abs(closeChgPct)
churnInRange = dayRange > 0 ? close <= low + (churnRangePct / 100.0) * dayRange : false
churnDay     = not stallDay and churnAbsChg < churnPctThresh and volume >= avg_vol * churnVolMult and churnInRange

// =============================================================================
// 3-DAY LOWER LOW ON INCREASED VOLUME (3LL)
// Condition: each of the last 3 bars made a lower low than the bar before it,
//            AND each bar's volume was higher than the previous bar's volume.
// Bar 0 = current, Bar 1 = prior, Bar 2 = two bars ago
// =============================================================================
ll3_lowLows   = close < close[1] and close[1] < close[2] and close[2] < close[3]
ll3_risingVol = volume > volume[1] and volume[1] > volume[2]
signal3LL     = ll3_lowLows and ll3_risingVol

// Background color on the completing (current) bar
bgcolor(show3LL and signal3LL ? llColor3 : na, title = '3-Day Lower Low')

// Label above the volume bar on the signal bar
if show3LL and signal3LL
    label.new(bar_index, f_scaleVol(volume),
         '3LL',
         color    = color.new(color.red, 60),
         textcolor = color.white,
         style    = label.style_label_up,
         size     = size.tiny,
         tooltip  = '3 consecutive lower lows on rising volume')




// =============================================================================
// PRICE MOVING AVERAGES  (fetched on the DAILY timeframe regardless of chart TF)
// =============================================================================
ema10  = request.security(syminfo.tickerid, 'D', ta.ema(close, 10),  lookahead = barmerge.lookahead_off)
ema21  = request.security(syminfo.tickerid, 'D', ta.ema(close, 21),  lookahead = barmerge.lookahead_off)
sma50  = request.security(syminfo.tickerid, 'D', ta.sma(close, 50),  lookahead = barmerge.lookahead_off)
sma200 = request.security(syminfo.tickerid, 'D', ta.sma(close, 200), lookahead = barmerge.lookahead_off)

// --- Proximity helpers (price within maProxPct % of each MA) ---
_near(maVal) =>
    not na(maVal) and maVal != 0 and math.abs(low - maVal) / maVal * 100 <= maProxPct

nearEMA10  = _near(ema10)
nearEMA21  = _near(ema21)
nearSMA50  = _near(sma50)
nearSMA200 = _near(sma200)
nearAnyMA  = nearEMA10 or nearEMA21 or nearSMA50

// Build a human-readable list of which MAs are nearby (used in alert message)
_maLabel() =>
    s = ''
    if nearEMA10
        s := s + '10EMA '
    if nearEMA21
        s := s + '21EMA '
    if nearSMA50
        s := s + '50SMA '
    if nearSMA200
        s := s + '200SMA '
    s

//variables
var table volInfo = table.new(str.lower(yPos) + '_' + str.lower(xPos), 4, 4, color.new(color.white, 100), border_color = color.new(color.white, 100), border_width = 2)

var float h10 = 0
var float h5 = 0
vols = array.new<float>()
vols5 = array.new<float>()
float volSec = na
projVol = float(volume)
var hve = volume
var label hveLabel = na
var label hv1Label = na
var label phLabel = na
var line twoXLine = na
var line threeXLine = na

//select colors and style
colors = down_day ? idownday : iupday
colors := d_day ? idday : a_day ? iaday : colors
// Dry-up coloring: level 2 (45%) = dark gray, level 1 (35%) = light gray, overrides standard colors
colors := dryUpBool and volDry2 ? color.new(#f79902, 10) : dryUpBool and volDry1 ? color.new(#e1b545, 3) : colors

// pocket pivots
for i = 0 to 10 by 1
    if close[i] < close[i + 1]
        array.push(vols, volume[i])
        h10 := array.max(vols)
        h10

pocketpivot = close > close[1] and volume > h10

for i = 0 to 5 by 1
    if close[i] < close[i + 1]
        array.push(vols5, volume[i])
        h5 := array.max(vols5)
        h5

pocketpivot5 = close > close[1] and volume > h5

ppAny   = pocketpivot or pocketpivot5
pp2of3  = ((ppAny ? 1 : 0) + (ppAny[1] ? 1 : 0) + (ppAny[2] ? 1 : 0)) >= 2

//projected volume 
timePassed = timenow - time
timeLeft = time_close - timenow

if timeLeft > 0
    volSec := volume / timePassed
    projVol := volume + volSec * timeLeft
    projVol

runRate = projVol / avg_vol * 100 - 100
volPerChng = nz(volume / avg_vol * 100 - 100)

//highest volumes
if volume > hve
    hve := volume
if_hve = volume == hve
if_hvy = volume == highVolYear
if_sky = bool(ph) 

if volume == hve and showHVE
    // hveLabel := label.new(bar_index, volume, 'HVE ' + str.tostring(volume, format.volume) + '(' + str.tostring(volPerChng, '#') + '%)', style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)
    hveLabel := label.new(bar_index, f_scaleVol(volume), 'HVE '  + str.tostring(volPerChng, '#') , style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)
    
    hveLabel
else if volume == highVolYear and showHV1
    // hv1Label := label.new(bar_index, volume, 'HVY ' + str.tostring(volume, format.volume) + '(' + str.tostring(volPerChng, '#') + '%)', style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)
    hv1Label := label.new(bar_index, f_scaleVol(volume), 'HVY '  + str.tostring(volPerChng, '#') , style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)

    hv1Label
else if showSky and bool(ph)
    // phLabel := label.new(bar_index[13], volume[13], showPer ? str.tostring(volume[13], format.volume) + '(' + str.tostring(volPerChng[13], '#') + '%)' : str.tostring(volume[13], format.volume), style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)
    phLabel := label.new(bar_index[13], f_scaleVol(volume[13]), showPer ?  '(' + str.tostring(volPerChng[13], '#') + '%)' : str.tostring(volume[13], format.volume), style = label.style_none, textcolor = colorHV ? close[13] > close[14] ? iaday : idday : textColor, size = sizerLabel)

    if volume[13] == hve and showHVE or volume[13] == highVolYear and showHV1
        label.delete(phLabel)

//plots
styleplot = switch plotstyle
    'Histogram' => plot.style_histogram
    'Line' => plot.style_line
    => plot.style_columns

// Volume percentage change relative to average
plot(volPerChng, title = 'Volume % Change', display = display.none)

plot(pp2of3 ? 1 : 0, title = '2-of-3 Pocket Pivot Signal', display = display.none)
plot(pocketpivot ? 1 : 0,  title = 'Pocket Pivot 10 Day', display = display.none)
plot(pocketpivot5 ? 1 : 0, title = 'Pocket Pivot 5 Day',  display = display.none)
plot(if_hve ? 1 : 0,         title = 'Highest Volume Ever',      display = display.none)
plot(if_hvy ? 1 : 0,         title = 'Highest Volume In a Year', display = display.none)
plot(dryUpSignal ? 1 : 0, title = 'Dry-Up Signal (≥N Days)', display = display.none)

plot(volDry1 ? 1 : 0,    title = 'Dry Up Lvl 1 (35%)',  display = display.none)
plot(volDry2 ? 1 : 0,    title = 'Dry Up Lvl 2 (45%)',  display = display.none)
plot(signal3LL ? 1 : 0,  title = '3-Day Lower Low on Rising Vol', display = display.none)

// Volume bars — SCALED to sit in the bottom slice of the price pane
plot(f_scaleVol(volume), color = colors, style = styleplot, title = 'Volume', display = display.all)



// Volume Moving Average — SCALED
plot(showMA ? f_scaleVol(ta.sma(volume, ilength)) : na, color = upDnCol and upDnVolRatio >= 1 ? color.blue : upDnCol and upDnVolRatio < 1 ? color.orange : macolor, title = 'Volume MA', display = display.all)

plot(showProjected and timeLeft > 0 ? f_scaleVol(projVol) : na, 'Projected Vol.', color = projColor, style = plot.style_columns, display = display.all)
plotshape(showpp and tenDay ? pocketpivot : false, '10 Day Pocket Pivot', shape.diamond, color = pp10color, location = location.bottom )
plotshape(showpp and fiveDay and not pocketpivot ? pocketpivot5 : false, '5 Day Pocket Pivot', style = shape.diamond, location = location.bottom, color = pp5color )
plotshape(if_sky ? true : false, 'Skyscraper', display = display.none)
plotshape(if_hve ? true : false, 'Highest VoL Ever')
plotshape(if_hvy ? true : false, 'Highest Vol In a Year')

// Stall Distribution Day — maroon xcross at top of volume pane
plotshape(
    showStallDay and stallDay,
    title    = 'Stall Distribution Day',
    style    = shape.xcross,
    location = location.top,
    color    = stallColor,
    textcolor = color.red,
    size     = size.tiny,
    text     = 'Stall'
)

// Churning Day — purple cross at top of volume pane
plotshape(
    showChurn and churnDay,
    title    = 'Churning Day',
    style    = shape.cross,
    location = location.top,
    color    = churnColor,
    textcolor = color.red,
    size     = size.tiny,
    text     = 'Churn'
)

// =============================================================================
// PRICE MA PLOTS  (rendered directly on the price chart since overlay = true)
// =============================================================================
plot(showEMA10  ? ema10  : na, title = '10D EMA',  color = ema10Color,  linewidth = 2)
plot(showEMA21  ? ema21  : na, title = '21D EMA',  color = ema21Color,  linewidth = 2)
plot(showSMA50  ? sma50  : na, title = '50D SMA',  color = sma50Color,  linewidth = 2)
plot(showSMA200 ? sma200 : na, title = '200D SMA', color = sma200Color, linewidth = 2)

// Proximity plots (0/1 flags — useful for scanner / strategy tester)
plot(nearEMA10  ? 1 : 0, title = 'Near 10D EMA',  display = display.none)
plot(nearEMA21  ? 1 : 0, title = 'Near 21D EMA',  display = display.none)
plot(nearSMA50  ? 1 : 0, title = 'Near 50D SMA',  display = display.none)
plot(nearSMA200 ? 1 : 0, title = 'Near 200D SMA', display = display.none)

if barstate.ishistory
    label.new(bar_index, f_scaleVol(volume), '', color = color.new(color.white, 100), tooltip = str.tostring(volPerChng, '#') + '%')

if barstate.islast and showTable
    table.cell(volInfo, 0, 0, ' ')
    table.cell(volInfo, 0, 1, 'Volume: ' + str.tostring(volume, format.volume) + ', ' + (runRate > 0 ? '+' + str.tostring(runRate, '#') + '%' : str.tostring(runRate, '#') + '%'), bgcolor = bgColor, text_color = textColor, text_size = sizer)
    if addInfo
        table.cell(volInfo, 0, 0, 'Vol:' + str.tostring(volume, format.volume) + ', ' + (runRate > 0 ? '+' + str.tostring(runRate, '#') + '%' : str.tostring(runRate, '#') + '%'), bgcolor = bgColor, text_color = textColor, text_size = sizer)
        table.cell(volInfo, 1, 0, 'AvgVol: ' + str.tostring(avg_vol, format.volume), bgcolor = bgColor, text_color = textColor, text_size = sizer)
        table.cell(volInfo, 3, 0, 'U/D Ratio: ' + str.tostring(upDnVolRatio, '#.##'), bgcolor = bgColor, text_color = textColor, text_size = sizer)
        table.cell(volInfo, 0, 2, 'ATR(21): ' + str.tostring(avgAtrPcnt, '#.##'), bgcolor = bgColor, text_color = textColor, text_size = sizer)
        table.cell(volInfo, 1,2, 'Beta(1Y vs SPY): ' + str.tostring(beta1y, '#.##'), bgcolor = bgColor, text_color = textColor, text_size = sizer)    
        table.clear(volInfo, 0, 1, 3, 1)

if barstate.islast and showLines
    (twoXLine[1]).delete()
    (threeXLine[1]).delete()
    twoXLine := line.new(bar_index[1], f_scaleVol(twoX), bar_index + 1, f_scaleVol(twoX), color = lineColor, width = 2)
    threeXLine := line.new(bar_index[1], f_scaleVol(threeX), bar_index + 1, f_scaleVol(threeX), color = lineColor, width = 2)
    threeXLine

//alerts
if pocketpivot
    alert('Pocket Pivot', alert.freq_once_per_bar_close)
else if volume >= twoX
    alert('2x Average Volume', alert.freq_once_per_bar)
else if volume >= threeX
    alert('3x Average Volume', alert.freq_once_per_bar)
    
upOnVol = close > close[1] and volume > avg_vol
dnOnVol = close < close[1] and volume > avg_vol
// anySignal = (is52WeekHigh or pocketpivot  or pp2of3   or if_sky or
//             if_hve or if_hvy or nearEMA10 or nearEMA21) 

anySignal = (is52WeekHigh or pocketpivot  or pp2of3   or if_sky or
            if_hve or if_hvy) 

alertcondition(anySignal, "Vol/MA Signal Triggered", "{{ticker}}: One or more trading signals detected")

alertcondition(pocketpivot, 'Pocket Pivot', '{{ticker}} Pocket Pivot')
alertcondition(upOnVol, 'Up On Volume', '{{ticker}} Up On Volume')
alertcondition(dnOnVol, 'Down On Volume', '{{ticker}} Down On Volume')
alertcondition(if_sky, 'Skyscraper', '{{ticker}} Skyscraper')
alertcondition(if_hve, 'Highest Volume Ever', '{{ticker}} Highest Volume Ever')
alertcondition(if_hvy, 'Highest Volume In a Year', '{{ticker}} Highest Volume In a Year')
alertcondition(stallDay, 'Stall Distribution Day', '{{ticker}} Stall Distribution Day')
alertcondition(churnDay, 'Churning Day', '{{ticker}} Churning Day')
alertcondition(dryUpSignal and not dryUpSignal[1], 'Volume Dry-Up Signal', '{{ticker}} Volume Dry-Up – {{interval}}')
alertcondition(pp2of3 and not pp2of3[1], 'Pocket Pivot 2-of-3', '{{ticker}} 2-of-3 Pocket Pivot Signal')
alertcondition(signal3LL, '3-Day Lower Low', '{{ticker}} 3 consecutive lower lows on rising volume – {{interval}}')

// --- Price MA Proximity Alerts ---
alertcondition(nearEMA10,  'Near 10D EMA',  '{{ticker}} price within {{plot("Near 10D EMA")}}% of 10D EMA')
alertcondition(nearEMA21,  'Near 21D EMA',  '{{ticker}} price within {{plot("Near 21D EMA")}}% of 21D EMA')
alertcondition(nearSMA50,  'Near 50D SMA',  '{{ticker}} price within {{plot("Near 50D SMA")}}% of 50D SMA')
alertcondition(nearSMA200, 'Near 200D SMA', '{{ticker}} price within {{plot("Near 200D SMA")}}% of 200D SMA')
alertcondition(nearAnyMA,  'Near Any Price MA', '{{ticker}} price is near a key MA (10EMA / 21EMA / 50SMA / 200SMA)')

