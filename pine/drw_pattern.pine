//@version=6
indicator('MarketSmith Indicator', overlay = true, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── BARS ──────────────────────────────────────────────────────────────────────
prevClose   = input(true, title='Color Based On Previous Close',  group='----------BARS----------', inline='x')
i_posColor = input(color.rgb(39, 54,233,0), title='Candle Color Positive', group='----------BARS----------', inline = '1')
i_negColor = input(color.rgb(222,50,174,0), title='Negative', group='----------BARS----------', inline = '1')
isUp = prevClose ? (close >= close[1]) : (close >= open)
plotbar(open = close, high = high, low = low, close = close, color = isUp ? i_posColor : i_negColor)

iSma10 = input(true, title = 'MA 1', group = '----------SMAs----------', inline = 'sma10')
iSmaV10 = input(10, title = 'Lenght', group = '----------SMAs----------', inline = 'sma10')
iExp10 = input(true, title = 'Exponential', group = '----------SMAs----------', inline = 'sma10')
iCol10 = input(color.rgb(240, 141, 240, 0), title = '', group = '----------SMAs----------', inline = 'sma10')
iWid10 = input.int(1, title = 'Width', group = '----------SMAs----------', inline = 'sma10', minval = 1, maxval = 10)
iSma21 = input(true, title = 'MA 2', group = '----------SMAs----------', inline = 'sma21')
iSmaV21 = input(21, title = 'Lenght', group = '----------SMAs----------', inline = 'sma21')
iExp21 = input(true, title = 'Exponential', group = '----------SMAs----------', inline = 'sma21')
iCol21 = input(color.rgb(68, 186, 76), title = '', group = '----------SMAs----------', inline = 'sma21')
iWid21 = input.int(1, title = 'Width', group = '----------SMAs----------', inline = 'sma21', minval = 1, maxval = 10)
iSma50 = input(true, title = 'MA 3', group = '----------SMAs----------', inline = 'sma50')
iSmaV50 = input(50, title = 'Lenght', group = '----------SMAs----------', inline = 'sma50')
iExp50 = input(false, title = 'Exponential', group = '----------SMAs----------', inline = 'sma50')
iCol50 = input(color.rgb(255, 33, 33), title = '', group = '----------SMAs----------', inline = 'sma50')
iWid50 = input.int(1, title = 'Width', group = '----------SMAs----------', inline = 'sma50', minval = 1, maxval = 10)
iSma200 = input(true, title = 'MA 4', group = '----------SMAs----------', inline = 'sma200')
iSmaV200 = input(200, title = 'Lenght', group = '----------SMAs----------', inline = 'sma200')
iExp200 = input(false, title = 'Exponential', group = '----------SMAs----------', inline = 'sma200')
iCol200 = input(color.rgb(0, 0, 0, 0), title = '', group = '----------SMAs----------', inline = 'sma200')
iWid200 = input.int(2, title = 'Width', group = '----------SMAs----------', inline = 'sma200', minval = 1, maxval = 10)

iSma10We = input(true, title = 'SMA 1', group = '----------SMAs We----------', inline = 'sma10We')
iSmaV10We = input(10, title = 'Lenght', group = '----------SMAs We----------', inline = 'sma10We')
iExp10We = input(false, title = 'Exponential', group = '----------SMAs We----------', inline = 'sma10We')
iCol10We = input(color.rgb(255, 33, 33), title = '', group = '----------SMAs We----------', inline = 'sma10We')
iWid10We = input.int(1, title = 'Width', group = '----------SMAs We----------', inline = 'sma10We', minval = 1, maxval = 10)
iEma20We = input(true, title = 'EMA 2', group = '----------SMAs We----------', inline = 'ema20We')
iSmaV20We = input(20, title = 'Lenght', group = '----------SMAs We----------', inline = 'ema20We')
iExp20We = input(true, title = 'Exponential', group = '----------SMAs We----------', inline = 'ema20We')
iCol20We = input(color.rgb(240, 141, 240, 0), title = '', group = '----------SMAs We----------', inline = 'ema20We')
iWid20We = input.int(1, title = 'Width', group = '----------SMAs We----------', inline = 'ema20We', minval = 1, maxval = 10)
iSma30We = input(true, title = 'SMA 3', group = '----------SMAs We----------', inline = 'sma30We')
iSmaV30We = input(30, title = 'Lenght', group = '----------SMAs We----------', inline = 'sma30We')
iExp30We = input(false, title = 'Exponential', group = '----------SMAs We----------', inline = 'sma30We')
iCol30We = input(color.rgb(68, 186, 76), title = '', group = '----------SMAs We----------', inline = 'sma30We')
iWid30We = input.int(1, title = 'Width', group = '----------SMAs We----------', inline = 'sma30We', minval = 1, maxval = 10)
iSma40We = input(true, title = 'SMA 4', group = '----------SMAs We----------', inline = 'sma40We')
iSmaV40We = input(40, title = 'Lenght', group = '----------SMAs We----------', inline = 'sma40We')
iExp40We = input(false, title = 'Exponential', group = '----------SMAs We----------', inline = 'sma40We')
iCol40We = input(color.rgb(0, 0, 0, 0), title = '', group = '----------SMAs We----------', inline = 'sma40We')
iWid40We = input.int(2, title = 'Width', group = '----------SMAs We----------', inline = 'sma40We', minval = 1, maxval = 10)


sma10 = iExp10 ? ta.ema(close, iSmaV10) : ta.sma(close, iSmaV10)
sma21 = iExp21 ? ta.ema(close, iSmaV21) : ta.sma(close, iSmaV21)
sma50 = iExp50 ? ta.ema(close, iSmaV50) : ta.sma(close, iSmaV50)
sma200 = iExp200 ? ta.ema(close, iSmaV200) : ta.sma(close, iSmaV200)

sma10We = iExp10We ? ta.ema(close, iSmaV10We) : ta.sma(close, iSmaV10We)
ema20We = iExp20We ? ta.ema(close, iSmaV20We) : ta.sma(close, iSmaV20We)
sma30We = iExp30We ? ta.ema(close, iSmaV30We) : ta.sma(close, iSmaV30We)
sma40We = iExp40We ? ta.ema(close, iSmaV40We) : ta.sma(close, iSmaV40We)

tfWeekly = timeframe.isweekly
psma10 = plot(iSma10 and not tfWeekly ? sma10 : na, linewidth = iWid10, color = iCol10, title='EMA 10')
pema21 = plot(iSma21 and not tfWeekly ? sma21 : na, linewidth = iWid21, color = iCol21, title='EMA 21')
psma50 = plot(iSma50 and not tfWeekly ? sma50 : na, linewidth = iWid50, color = iCol50 , title='SMA 50')
psma200 = plot(iSma200 and not tfWeekly ? sma200 : na, linewidth = iWid200, color = iCol200,  title='SMA 200')

psma10We = plot(iSma10We and tfWeekly ? sma10We : na, linewidth = iWid10We, color = iCol10We)
pema20We = plot(iEma20We and tfWeekly ? ema20We : na, linewidth = iWid20We, color = iCol20We)
psma30We = plot(iSma30We and tfWeekly ? sma30We : na, linewidth = iWid30We, color = iCol30We)
psma40We = plot(iSma40We and tfWeekly ? sma40We : na, linewidth = iWid40We, color = iCol40We)

comparativeTickerId = 'SP:SPX'

showRS = input(false, title = 'Show RS Features', group = '----------RS Rating----------')
hideRSLine = input(false, title = 'Hide RS Line', group = '----------RS Rating----------', inline = '0')
hideRSRat = input(false, title = 'Hide Rating', group = '----------RS Rating----------', inline = '0')
ratingOnly = input(false, title = 'Rating Only', group = '----------RS Rating----------')
lineTicker = input('SP:SPX', title = 'Comparative Symbol for Line', group = '----------RS Rating----------', tooltip = 'Reference ticker used for calculation of the RS Line.')
SpxValue = input(4200, title = 'Value of Comparative Symbol', group = '----------RS Rating----------', tooltip = 'Used to gather a constant value')
offset = input.int(130, minval = 0, maxval = 300, title = 'Offset (%)', group = '----------RS Rating----------', tooltip = 'Used to display the RS Line under the price.')
colorRS = input(color.rgb(24, 140, 202), title = 'Color of RS Line & Rating', group = '----------RS Rating----------')
plotNewHigh = input(true, title = 'Plot RS New Highs', group = '----------RS Rating----------')
rsNewHigh   = input.string('Historical RS New Highs', title = 'Type',
              options = ['RS New Highs', 'RS New Highs Before Price',
                         'Historical RS New Highs', 'Historical RS New Highs  Before Price'],
              group = '----------RS Rating----------')
col_nh1Y    = input(color.new(#0000FF, 20), title = '1Y NH',         group = '----------RS Rating----------', inline = 'nhcols')
col_nh6M    = input(color.new(#1E90FF, 25), title = '6M NH',         group = '----------RS Rating----------', inline = 'nhcols')
col_nh3M    = input(color.new(#00BFFF, 30), title = '3M NH',         group = '----------RS Rating----------', inline = 'nhcols')
col_nhLP    = input(color.new(#00ffd9,  0), title = 'Leads Price',   group = '----------RS Rating----------', inline = 'nhcols')
lookback = input.int(250, title = 'Look-back', minval = 1, maxval = 252, group = '----------RS Rating----------', tooltip = 'The lookback for calculation of price and RS New Highs.')
sizeLabHigh = input.string('Tiny', title = 'RS New Highs Circle Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge', 'Auto'], group = '----------RS Rating----------')
plotNewLow = input(true, title = 'Plot RS New Lows', group = '----------RS Rating----------')
rsNewLow = input.string('Historical RS New Lows', title = 'Type', options = ['RS New Lows', 'RS New Lows Before Price', 'Historical RS New Lows', 'Historical RS New Lows  Before Price'], group = '----------RS Rating----------')
redDotCol = input(color.rgb(255, 82, 82, 62), title = 'Color', group = '----------RS Rating----------')
lookback2 = input.int(250, title = 'Look-back', minval = 1, maxval = 252, group = '----------RS Rating----------', tooltip = 'The lookback for calculation of price and RS New Lows.')
sizeLabLow = input.string('Tiny', title = 'RS New Lows Circle Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge', 'Auto'], group = '----------RS Rating----------')

showQuick    = input(true, title='Quick', inline='quick', group='RS Moving Averages')
colQuick     = input(color.rgb(0, 255, 255, 0), title='', inline='quick', group='RS Moving Averages')
showQuickSand = input(true, title='QuickSand', inline='qs', group='RS Moving Averages')
colQuickSand  = input(color.orange, title='', inline='qs', group='RS Moving Averages')
showGD       = input(true, title='Grateful Dead', inline='gd', group='RS Moving Averages')
colGD        = input(color.rgb(128, 0, 128), title='', inline='gd', group='RS Moving Averages')

allowReplay = input(false, title = 'Use fix values for replay mode', group = 'RS Replay mode (Approximate Method)', tooltip = 'Here we use constant values in order to provide the environment regardless of the date. See RSRATING ticker and report close values to have the last data.')
first2 = input(195.93, title = 'For 99 stocks', group = 'RS Replay mode (Approximate Method)')
scnd2 = input(117.11, title = 'For 90+ stocks', group = 'RS Replay mode (Approximate Method)')
thrd2 = input(99.04, title = 'For 70+ stocks', group = 'RS Replay mode (Approximate Method)')
frth2 = input(91.66, title = 'For 50+ stocks', group = 'RS Replay mode (Approximate Method)')
ffth2 = input(80.96, title = 'For 30+ stocks', group = 'RS Replay mode (Approximate Method)')
sxth2 = input(53.64, title = 'For 10+ stocks', group = 'RS Replay mode (Approximate Method)')
svth2 = input(24.86, title = 'For 1- stocks', group = 'RS Replay mode (Approximate Method)')

if lookback == 250 and timeframe.isweekly
    lookback := 52
    lookback
if lookback2 == 250 and timeframe.isweekly
    lookback2 := 52
    lookback2

highLabel = switch sizeLabHigh
    'Auto'   => size.auto
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    'Huge'   => size.huge

lowLabel = switch sizeLabLow
    'Auto'   => size.auto
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    'Huge'   => size.huge

n63 = bar_index < 63 ? bar_index : 63
n126 = bar_index < 126 ? bar_index : 126
n189 = bar_index < 189 ? bar_index : 189
n252 = bar_index < 252 ? bar_index : 252

comparativeSymbol = request.security(lineTicker, timeframe.period, close)
rsCurve = close / comparativeSymbol
if syminfo.industry == 'Investment Trusts/Mutual Funds'
    offset := 90
    offset
rsRatio = timeframe.isweekly ? SpxValue * (offset - 10) / 100 : SpxValue * offset / 100
rs = rsCurve * rsRatio
prevlookback = lookback
prevlookback2 = lookback2
lookback := math.min(lookback - 1, bar_index)
rsPlot = plot(hideRSLine or not showRS ? na : rs, title = 'RS Line', style = plot.style_line, linewidth = 1, color = colorRS)

isWeekly  = timeframe.isweekly
isMonthly = timeframe.ismonthly

quickLen      = isMonthly ? 5  : isWeekly ? 8  : 21
quickSandLen  = isMonthly ? 8  : isWeekly ? 13 : 34
gdLen         = isMonthly ? 13 : isWeekly ? 21 : 50

emaQuick      = showQuick and showRS     ? ta.ema(rs, quickLen)     : na
emaQuickSand  = showQuickSand and showRS ? ta.ema(rs, quickSandLen) : na
emaGrateful   = showGD and showRS        ? ta.ema(rs, gdLen)        : na

plot(emaQuick,     color=colQuick,     linewidth=1, title='Quick')
plot(emaQuickSand, color=colQuickSand, linewidth=1, title='QuickSand')
plot(emaGrateful,  color=colGD,        linewidth=1, title='Grateful Dead')

// ta.highest/ta.lowest are built-in monotonic-window functions (O(1) amortized per bar);
// these replace hand-rolled O(len) loops that ran up to 250 iterations, 6x per bar.
int lb1Y = timeframe.isweekly ? 52  : 250
int lb6M = timeframe.isweekly ? 24  : 126
int lb3M = timeframe.isweekly ? 12  : 63

_rsH1Y = ta.highest(rsCurve, lb1Y)[1]
_rsH6M = ta.highest(rsCurve, lb6M)[1]
_rsH3M = ta.highest(rsCurve, lb3M)[1]

rs_nh1Y = not na(rsCurve) and not na(_rsH1Y) and rsCurve > _rsH1Y
rs_nh6M = not na(rsCurve) and not na(_rsH6M) and rsCurve > _rsH6M and not rs_nh1Y
rs_nh3M = not na(rsCurve) and not na(_rsH3M) and rsCurve > _rsH3M and not rs_nh1Y and not rs_nh6M
rs_nh_any = rs_nh1Y or rs_nh6M or rs_nh3M

_prH1Y = ta.highest(high, lb1Y)[1]
_prH6M = ta.highest(high, lb6M)[1]
_prH3M = ta.highest(high, lb3M)[1]

price_nh1Y = not na(_prH1Y) and high > _prH1Y
price_nh6M = not na(_prH6M) and high > _prH6M
price_nh3M = not na(_prH3M) and high > _prH3M

rs_nh_period      = rs_nh1Y ? "1Y" : rs_nh6M ? "6M" : "3M"
price_nh_matching = rs_nh1Y ? price_nh1Y : rs_nh6M ? price_nh6M : price_nh3M

f_nhColor() =>
    leadsPrice = not price_nh_matching
    leadsPrice ? col_nhLP : rs_nh1Y ? col_nh1Y : rs_nh6M ? col_nh6M : col_nh3M

_rsL  = ta.lowest(rsCurve, prevlookback2)[1]
_prL  = ta.lowest(low,     prevlookback2)[1]
rs_nl    = not na(rsCurve) and not na(_rsL) and rsCurve < _rsL
price_nl = not na(low)     and not na(_prL) and low     < _prL

var label newHigh = na

if rsNewHigh == 'Historical RS New Highs' and plotNewHigh and rs_nh_any and showRS
    newHigh := label.new(x = bar_index, y = rs, color = f_nhColor(),
                         style = label.style_circle, size = highLabel)
    newHigh

if rsNewHigh == 'Historical RS New Highs  Before Price' and plotNewHigh and rs_nh_any and not price_nh_matching and showRS
    newHigh := label.new(x = bar_index, y = rs, color = col_nhLP,
                         style = label.style_circle, size = highLabel)
    newHigh

if barstate.islast and rsNewHigh == 'RS New Highs' and plotNewHigh and rs_nh_any and showRS
    label.delete(newHigh)
    newHigh := label.new(x = bar_index, y = rs, color = f_nhColor(),
                         style = label.style_circle, size = highLabel)
    newHigh

if barstate.islast and rsNewHigh == 'RS New Highs Before Price' and plotNewHigh and rs_nh_any and not price_nh_matching and showRS
    label.delete(newHigh)
    newHigh := label.new(x = bar_index, y = rs, color = col_nhLP,
                         style = label.style_circle, size = highLabel)
    newHigh

if plotNewHigh and rs_nh_any and showRS
    _leadsPrice = not price_nh_matching
    _ttNH = _leadsPrice
          ? "🟢 RS LEADS PRICE (" + rs_nh_period + ")\nRS new " + rs_nh_period + " high before price\nLeading strength signal"
          : "🔵 RS NEW HIGH (" + rs_nh_period + ")\nRS at a " + rs_nh_period + " new high"
    label.new(bar_index, rs, "",
              style     = label.style_circle,
              color     = color.new(color.white, 100),
              textcolor = color.new(color.white, 100),
              size      = highLabel,
              tooltip   = _ttNH)

var label newLow = na

if rsNewLow == 'Historical RS New Lows' and plotNewLow and rs_nl and showRS
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)
    newLow

if rsNewLow == 'Historical RS New Lows  Before Price' and plotNewLow and rs_nl and not price_nl and showRS
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)
    newLow

if barstate.islast and rsNewLow == 'RS New Lows' and plotNewLow and rs_nl and showRS
    label.delete(newLow)
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)
    newLow

if barstate.islast and rsNewLow == 'RS New Lows Before Price' and plotNewLow and rs_nl and not price_nl and showRS
    label.delete(newLow)
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)
    newLow

if plotNewLow and rs_nl and showRS
    label.new(bar_index, rs, "",
              style     = label.style_circle,
              color     = color.new(color.white, 100),
              textcolor = color.new(color.white, 100),
              size      = lowLabel,
              tooltip   = "🔴 RS NEW LOW\nRS at a " + str.tostring(prevlookback2) + "-bar low\nRelative weakness — avoid or reduce")
closeDa = request.security(syminfo.tickerid, 'D', close)
spxCloseDa = request.security(comparativeTickerId, 'D', close)

perfTicker63 = closeDa / closeDa[n63]
perfTicker126 = closeDa / closeDa[n126]
perfTicker189 = closeDa / closeDa[n189]
perfTicker252 = closeDa / closeDa[n252]

perfComp63 = spxCloseDa / spxCloseDa[n63]
perfComp126 = spxCloseDa / spxCloseDa[n126]
perfComp189 = spxCloseDa / spxCloseDa[n189]
perfComp252 = spxCloseDa / spxCloseDa[n252]

float rs_stock = 0.4 * perfTicker63 + 0.2 * perfTicker126 + 0.2 * perfTicker189 + 0.2 * perfTicker252
float rs_ref = 0.4 * perfComp63 + 0.2 * perfComp126 + 0.2 * perfComp189 + 0.2 * perfComp252

float totalRsScore = rs_stock / rs_ref * 100
float totalRsRating = -1

curveRsPerf = request.seed('seed_fred6725_rs_rating', 'RSRATING', close)

delta = ta.barssince(na(curveRsPerf) != true)

var array<float> different_values = array.new_float(7)

var int counter = 0

float first = 0
float scnd = 0
float thrd = 0
float frth = 0
float ffth = 0
float sxth = 0
float svth = 0

if not allowReplay
    for i = delta to 34 + delta by 1
        close_value = nz(curveRsPerf[i])
        if not array.includes(different_values, close_value) and counter < 7 and close_value != 0
            array.set(different_values, counter, close_value)
            counter := counter + 1
            counter

    first := array.get(different_values, 0)
    scnd := array.get(different_values, 1)
    thrd := array.get(different_values, 2)
    frth := array.get(different_values, 3)
    ffth := array.get(different_values, 4)
    sxth := array.get(different_values, 5)
    svth := array.get(different_values, 6)
    svth

if allowReplay
    first := first2
    scnd := scnd2
    thrd := thrd2
    frth := frth2
    ffth := ffth2
    sxth := sxth2
    svth := svth2
    svth

if totalRsScore >= first
    totalRsRating := 99
    totalRsRating
if totalRsScore <= svth
    totalRsRating := 1
    totalRsRating

f_attributePercentile(totalRsScore, tallerPerf, smallerPerf, rangeUp, rangeDn, weight) =>
    sum = totalRsScore + (totalRsScore - smallerPerf) * weight
    if sum > tallerPerf - 1
        sum := tallerPerf - 1
        sum
    k1 = smallerPerf / rangeDn
    k2 = (tallerPerf - 1) / rangeUp
    k3 = (k1 - k2) / (tallerPerf - 1 - smallerPerf)
    RsRating = sum / (k1 - k3 * (totalRsScore - smallerPerf))
    if RsRating > rangeUp
        RsRating := rangeUp
        RsRating
    if RsRating < rangeDn
        RsRating := rangeDn
        RsRating
    RsRating

if totalRsScore < first and totalRsScore >= scnd
    totalRsRating := f_attributePercentile(totalRsScore, first, scnd, 98, 90, 0.33)
    totalRsRating
if totalRsScore < scnd and totalRsScore >= thrd
    totalRsRating := f_attributePercentile(totalRsScore, scnd, thrd, 89, 70, 2.1)
    totalRsRating
if totalRsScore < thrd and totalRsScore >= frth
    totalRsRating := f_attributePercentile(totalRsScore, thrd, frth, 69, 50, 0)
    totalRsRating
if totalRsScore < frth and totalRsScore >= ffth
    totalRsRating := f_attributePercentile(totalRsScore, frth, ffth, 49, 30, 0)
    totalRsRating
if totalRsScore < ffth and totalRsScore >= sxth
    totalRsRating := f_attributePercentile(totalRsScore, ffth, sxth, 29, 10, 0)
    totalRsRating
if totalRsScore < sxth and totalRsScore >= svth
    totalRsRating := f_attributePercentile(totalRsScore, sxth, svth, 9, 2, 0)
    totalRsRating

for i = 0 to 6 by 1
    if nz(array.get(different_values, i)) == 0 and not allowReplay
        totalRsRating := -1
        totalRsRating

// Fetch daily totalRsRating (we only need the daily rating for the label)
t_t = request.security(syminfo.tickerid, 'D', totalRsRating)
rToday = timeframe.isdaily ? totalRsRating : t_t

// Plot RS Rating Labels on Chart
labelText1 = ''
labelText2 = ''
if (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and rToday != -1
    labelText2 := '\n\n       ' + str.tostring(rToday, '#0')
    labelText2
if ratingOnly
    labelText1 := ''
    labelText2 := '\n    ' + str.tostring(rToday, '#0')
    labelText2

label1 = hideRSRat == false and showRS and barstate.islast ? label.new(bar_index, rs, text = labelText1, color = color.rgb(0, 0, 0, 100), size = size.normal, textcolor = colorRS, style = label.style_label_center, textalign = text.align_left, yloc = yloc.price) : na
label2 = hideRSRat == false and showRS and barstate.islast ? label.new(bar_index, rs, text = labelText2, color = color.rgb(0, 0, 0, 100), size = size.large, textcolor = colorRS, style = label.style_label_center, textalign = text.align_left, yloc = yloc.price) : na

label.delete(label1[1])
label.delete(label2[1])

WtClose = input(false, title = 'Weekly Tight Closes Detector', group = 'TIGHT CLOSES DETECTOR')
colorTightCloses = input(color.aqua, title = 'Color of Tight Closes Boxes', group = 'TIGHT CLOSES DETECTOR')
if tfWeekly
    WkO2 = open[2]
    WkC = close
    WkC1 = close[1]
    WkC2 = close[2]
    WkH = high
    WkH1 = high[1]
    WkH2 = high[2]
    WkL = low
    WkL1 = low[1]
    WkL2 = low[2]
    Wema10 = ta.ema(close, 10)
    Wema20 = ta.ema(close, 20)
    threshold = 0.015
    condTightClose = WkC < WkC1 + WkC1 * threshold and WkC > WkC1 - WkC1 * threshold and WkC1 < WkC2 + WkC2 * threshold and WkC1 > WkC2 - WkC2 * threshold and WkC < WkC2 + WkC2 * threshold and WkC > WkC2 - WkC2 * threshold
    condTightHigh = WkH < WkH1 + WkH1 * threshold and WkH > WkH1 - WkH1 * threshold and WkH1 < WkH2 + WkH2 * threshold and WkH1 > WkH2 - WkH2 * threshold
    condTightLow = WkL < WkL1 + WkL1 * threshold and WkL > WkL1 - WkL1 * threshold and WkL1 < WkL2 + WkL2 * threshold and WkL1 > WkL2 - WkL2 * threshold
    condFirstCandle = false
    if WkC2 >= WkO2
        condFirstCandle := WkH2 - WkC2 + WkO2 - WkL2 > 2 * (WkC2 - WkO2) or WkH2 - WkL2 < WkH1 - WkL1
        condFirstCandle
    if WkC2 < WkO2
        condFirstCandle := WkH2 - WkO2 + WkC2 - WkL2 > 2 * (WkO2 - WkC2) or WkH2 - WkL2 < WkH1 - WkL1
        condFirstCandle
    condTot3WTight = condTightClose and (condTightHigh or condTightLow) and condFirstCandle

    highestW = ta.highest(WkH, 3)
    lowestW = ta.lowest(WkL, 3)
    if condTot3WTight and WtClose
        box.new(bar_index[2], highestW, bar_index, lowestW, border_color = color.new(colorTightCloses, 20), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(colorTightCloses, 85))

i_displayHL = input(true, title = 'Display H/L Points', group = 'High/Low Price Points')
i_colorHL = input(color.rgb(180, 158, 48), title = 'Labels Color', group = 'High/Low Price Points')
i_displayPc = input(true, title = '%Change', group = 'High/Low Price Points')
i_colorPctP = input(color.rgb(0, 0, 255), title = 'Positive % Color', group = 'High/Low Price Points', inline = 'z')
i_colorPctN = input(color.rgb(181, 49, 144), title = 'Negative %', group = 'High/Low Price Points', inline = 'z')
i_pivot = input(9, title = 'Length for peak/valey points', group = 'High/Low Price Points')

var pivotHighValues = array.new_float(0)
var pivotLowValues = array.new_float(0)

if i_displayHL and not tfWeekly
    pivotHigh = ta.pivothigh(high, i_pivot, i_pivot)
    pivotLow = ta.pivotlow(low, i_pivot, i_pivot)
    if bool(pivotHigh)
        array.unshift(pivotHighValues, high[i_pivot])
        textHigh9 = i_displayPc ? str.tostring(high[i_pivot], '0.00') + '\n' : str.tostring(high[i_pivot], '0.00')
        highestHigh = label.new(bar_index - i_pivot, array.get(pivotHighValues, 0), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, text = textHigh9, textcolor = i_colorHL)
        highestHigh
    if bool(pivotLow)
        array.unshift(pivotLowValues, low[i_pivot])
        textLow9 = '\n' + str.tostring(low[i_pivot], '0.00')
        lowestLow = label.new(bar_index - i_pivot, array.get(pivotLowValues, 0), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_center, text = textLow9, textcolor = i_colorHL, color = color.rgb(0, 0, 0, 100))
        lowestLow
    float pHigh = na
    float pLow = na
    if array.size(pivotHighValues) > 0
        pHigh := array.get(pivotHighValues, 0)
        pHigh
    if array.size(pivotLowValues) > 0
        pLow := array.get(pivotLowValues, 0)
        pLow
    prcVarHigh = (pHigh - pLow) / pLow * 100
    prcVarLow = (pLow / pHigh - 1) * 100
    prcVarHighText = prcVarHigh >= 0 ? '+' + str.tostring(prcVarHigh, '0.0') + '%' : str.tostring(prcVarHigh, '0.0') + '%'
    prcVarLowText = prcVarLow >= 0 ? '+' + str.tostring(prcVarLow, '0.0') + '%' : str.tostring(prcVarLow, '0.0') + '%'
    colorPctUp = prcVarHigh >= 0 ? i_colorPctP : i_colorPctN
    colorPctDn = prcVarLow >= 0 ? i_colorPctP : i_colorPctN
    if bool(pivotHigh) and i_displayPc
        pctPivotHigh = na(prcVarHigh) == true ? na : label.new(bar_index - i_pivot, array.get(pivotHighValues, 0), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, text = prcVarHighText, textcolor = colorPctUp)
        pctPivotHigh
    if bool(pivotLow) and i_displayPc
        pctPivotLow = na(prcVarLow) == true ? na : label.new(bar_index - i_pivot, array.get(pivotLowValues, 0), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_center, text = '\n\n\n' + prcVarLowText, textcolor = colorPctDn, color = color.rgb(0, 0, 0, 100))
        pctPivotLow

i_displayPattern = input(true, title = 'Display Pattern', group = 'Chart Pattern Recognition')
i_displayBoxes = input(true, title = 'Display Trade Boxes', group = 'Chart Pattern Recognition')
i_displayHistoricalBoxes = input(true, title = 'Display Historical Trade Boxes', group = 'Chart Pattern Recognition')
i_baseDepth = input(35, title = 'Base: Depth (%)', group = 'Chart Pattern Recognition', inline = 'Parameters Base')
i_baseLength = input(65, title = 'Length (Weeks)', group = 'Chart Pattern Recognition', inline = 'Parameters Base')
i_dbDepth = input(40, title = 'Double Bottom: Depth (%)', group = 'Chart Pattern Recognition', inline = 'Parameters DB', tooltip = 'Max base depth for Double Bottom (commonly forms in volatile environments, < 40%)')
i_dbLength = input(17, title = 'Max Duration (Weeks)', group = 'Chart Pattern Recognition', inline = 'Parameters DB', tooltip = 'Max base duration for Double Bottom (4 months = 17 weeks)')
i_dbPriorUptrend = input.float(30.0, title = 'Min Prior Uptrend (%)', group = 'Chart Pattern Recognition', inline = 'Parameters DB2', tooltip = 'Minimum prior uptrend percentage before Double Bottom forms (30% or more)')
i_dbMinLengthWeeks = input.int(7, title = 'Min Length (Weeks)', group = 'Chart Pattern Recognition', inline = 'Parameters DB2', tooltip = 'Minimum total length in weeks for Double Bottom (7 weeks or more)')
i_dbRequireUndercut = input.bool(true, title = 'Require 2nd Bottom Undercut', group = 'Chart Pattern Recognition', tooltip = 'If enabled, 2nd bottom low must undercut (be strictly lower than) 1st bottom low')
i_dbVolBreakoutMult = input.float(1.35, title = 'DB Breakout Volume Multiplier', group = 'Chart Pattern Recognition', tooltip = 'Breakout volume should be running 30-40% above average (e.g. 1.35 = 35% above average volume MA)')
i_showPatternTooltip = input(true, title = 'Show Pattern Hover Label', group = 'Chart Pattern Recognition')
i_showCupHandleSep = input(true, title = 'Show Sep Cup-with-Handle (Early Handle)', group = 'Chart Pattern Recognition')
i_handleMinBars = input(5, title = 'Handle: Min Bars', group = 'Chart Pattern Recognition')
i_handleMaxBars = input(25, title = 'Handle: Max Bars', group = 'Chart Pattern Recognition')
i_handleMaxDecline = input(12.0, title = 'Handle: Max Decline (%)', group = 'Chart Pattern Recognition')
i_handleMinHeightPct = input(60.0, title = 'Handle: Min Peak Height (%)', group = 'Chart Pattern Recognition')
i_useVolHandle       = input.bool(true,   'Use Volume Confirmation for Handle', group = 'Chart Pattern Recognition', tooltip = 'Require volume contraction during handle & expansion on breakout')
i_requireCupForHandle = input.bool(true,   'Require Cup Base for Handle',       group = 'Chart Pattern Recognition', tooltip = 'Handle must form in a detected cup pattern (not just any base)')
i_volMaLengthHandle  = input.int(50,      'Volume MA Length',                   group = 'Chart Pattern Recognition', minval = 1, tooltip = 'Lookback for average volume')
i_volContractionMax  = input.float(50.0,  'Max Avg Vol % in Handle',            group = 'Chart Pattern Recognition', minval = 0, step = 1, tooltip = 'Average handle volume must be below this % of the volume MA')
i_volBreakoutMult    = input.float(1.5,   'Breakout Volume Multiplier',         group = 'Chart Pattern Recognition', minval = 1, step = 0.1, tooltip = 'Breakout bar volume must be ≥ this times volume MA')

i_htfOn      = input.bool(true,   'Enable HTF Detection',               group = 'Chart Pattern Recognition')
i_htfDepth   = input.float(25.0,  'HTF: Max Flag Depth %',              group = 'Chart Pattern Recognition', step = .25, minval = .25, tooltip = 'Maximum pullback allowed from flag high to flag low (less than 25%)')
i_htfFMax    = input.int(20,      'HTF: Max Flag Length (bars)',        group = 'Chart Pattern Recognition', tooltip = 'The maximum number of bars the flag can last (4 weeks = 20 bars)')
i_htfFMin    = input.int(6,       'HTF: Min Flag Length (bars)',        group = 'Chart Pattern Recognition', minval = 1, tooltip = 'The minimum number of bars required for the flag (default 3 bars for earlier detection)')

i_htfPole    = input.float(85.0,  'HTF: Prior Uptrend Minimum %',       group = 'Chart Pattern Recognition', step = .50, minval = .25, tooltip = 'The minimum percentage gain required before a flag forms (at least 80%)')
i_htfPB      = input.int(40,      'HTF: Max Flag Pole Length (bars)',   group = 'Chart Pattern Recognition', minval = 1, tooltip = 'The maximum number of bars the flagpole can be (less than 8 weeks = 40 bars)')
i_htfPBMin   = input.int(5,       'HTF: Min Flag Pole Length',          group = 'Chart Pattern Recognition', minval = 1, tooltip = 'The minimum number of bars required for the flag pole')
i_htfVol     = input.float(1.1,   'HTF: BO Volume × Avg',               group = 'Chart Pattern Recognition', tooltip = 'Breakout volume multiplier.')

i_baseDepth := i_baseDepth / 100
i_dbDepth := i_dbDepth / 100
i_baseLength := i_baseLength * 5
i_dbLength := i_dbLength * 5

var pivotHighPrices = array.new_float(0)
var pivotLowPrices = array.new_float(0)
var startBasePrice = array.new_float(0)
var lowBasePrice = array.new_float(0)
var lowOfpivotHighPrices = array.new_float(0)
var float lowOfBaseHigh = 0
var int startBaseBar = 0
var int lowerBaseBar = 0
var pivotHighBars = array.new_int(0)
var pivotLowBars = array.new_int(0)
var topDBPrice = array.new_float(0)
var bottomDBPrice = array.new_float(0)
var int topDBBar = 0
var int bottomDBBar = 0
var int db_fHt = na
var float db_fH = na
var int db_fLt = na
var float db_fL = na
var int db_sHt = na
var float db_sH = na
var int db_sLt = na
var float db_sL = na
var baseCloses = array.new_float(0)

pivotHigh = ta.pivothigh(high, i_pivot, i_pivot)
pivotLow = ta.pivotlow(low, i_pivot, i_pivot)
if bool(pivotHigh)
    array.unshift(pivotHighPrices, high[i_pivot])
    array.unshift(lowOfpivotHighPrices, low[i_pivot])
    array.unshift(pivotHighBars, bar_index[i_pivot])
if bool(pivotLow)
    array.unshift(pivotLowPrices, low[i_pivot])
    array.unshift(pivotLowBars, bar_index[i_pivot])

boolHighbase = false
boolHigherPiv = false
htfAvgVol = ta.sma(volume, 20)
highestOfBase = ta.highest(high, 25)
highestOfComp = ta.highest(high, 50)
lowestBaseLow = ta.lowest(low, 25)
lowestPointLeg = ta.lowest(low, 103)
var baseCond = false
isBase = false

_highest65shifted = ta.highest(high, 65)[26]
_dynamicHighestPrior = ta.highest(high, math.min(4950, math.max(1, bar_index - 26)))[26]
_dynamicLegLookback = math.min(103, math.max(1, bar_index))
_dynamicLowestIPOLeg = ta.lowest(low, _dynamicLegLookback)

if array.size(pivotHighPrices) > 0
    int pivCount = array.size(pivotHighPrices)
    boolHighbase := high[25] == array.get(pivotHighPrices, 0) or (pivCount > 1 and high[25] == array.get(pivotHighPrices, 1)) or (pivCount > 2 and high[25] == array.get(pivotHighPrices, 2))
    float highestPrior = na(_highest65shifted) ? _dynamicHighestPrior : _highest65shifted

    bool13wkHigh    = high[25] >= highestPrior
    float _priorTop = array.size(startBasePrice) > 0 ? array.get(startBasePrice, 0) : na
    boolPriorBaseBO = not na(_priorTop) and high[25] > _priorTop
    boolHigherPiv  := bool13wkHigh or boolPriorBaseBO
    float lowestPointIPOLeg = _dynamicLowestIPOLeg

    legUp = lowestPointIPOLeg * 1.20
    legUpCond = high[25] >= legUp
    firstBaseDepth = high[25] * (1 - i_baseDepth) <= lowestBaseLow
    noCandleAbove = highestOfBase <= high[25]
    noBaseInBase = isBase[25] == false
    baseCond := boolHighbase and boolHigherPiv and legUpCond and firstBaseDepth and noCandleAbove and noBaseInBase
    baseCond
lowestBar = ta.barssince(low == lowestBaseLow)
if baseCond and not isBase[1]
    array.unshift(startBasePrice, high[25])
    startBaseBar := bar_index[25]
    array.unshift(lowOfpivotHighPrices, low[25])
    lowOfBaseHigh := low[25]
    array.unshift(lowBasePrice, lowestBaseLow)
    lowerBaseBar := bar_index[lowestBar]
    for i = 0 to 25 by 1
        array.unshift(baseCloses, close[i])

if baseCond or isBase[1]
    isBase := true
    isBase

var int baseCount = 0
if baseCond and not isBase[1]
    baseCount := bar_index - startBaseBar
    baseCount
if isBase
    baseCount := baseCount + 1
    baseCount

isBox = false
boxOver = true
if isBox[1] and not boxOver[1]
    isBox := true
    isBox

detectDoubleBottom = false
int _dbFL = array.size(pivotLowBars) > 0 ? math.min(4950, math.max(1, bar_index - array.get(pivotLowBars, 0) + 1)) : 1
_priorLowFull = ta.lowest(low, math.max(1, math.min(bar_index, 250)))

if isBase
    int numHP = array.size(pivotHighPrices)
    int numLP = array.size(pivotLowPrices)
    if numHP >= 2 and numLP >= 2
        int maxHP = math.min(numHP - 1, 4)
        for hp_i = 0 to maxHP - 1
            for hp_j = hp_i + 1 to math.min(numHP - 1, hp_i + 4)
                float sH = array.get(pivotHighPrices, hp_i)
                float fH = array.get(pivotHighPrices, hp_j)
                int sHt = array.get(pivotHighBars, hp_i)
                int fHt = array.get(pivotHighBars, hp_j)

                int maxDbBars = i_dbLength * 5
                if fHt >= bar_index - maxDbBars
                    int fLt = -1
                    float fL = na
                    int sLt = -1
                    float sL = na

                    for lp_idx = 0 to numLP - 1
                        int lBar = array.get(pivotLowBars, lp_idx)
                        if lBar > fHt and lBar < sHt
                            fLt := lBar
                            fL := array.get(pivotLowPrices, lp_idx)
                            break

                    for lp_idx = 0 to numLP - 1
                        int lBar = array.get(pivotLowBars, lp_idx)
                        if lBar > sHt and lBar <= bar_index
                            sLt := lBar
                            sL := array.get(pivotLowPrices, lp_idx)
                            break

                    if fLt != -1 and sLt != -1
                        float peak = math.max(fH, sH)
                        bool condPriorTrend = (fH >= _priorLowFull * (1.0 + i_dbPriorUptrend / 100.0)) or (sH >= _priorLowFull * (1.0 + i_dbPriorUptrend / 100.0))
                        bool condPricesH = array.size(startBasePrice) > 0 ? (math.abs(fH - array.get(startBasePrice, 0)) < array.get(startBasePrice, 0) * 0.15 or math.abs(sH - array.get(startBasePrice, 0)) < array.get(startBasePrice, 0) * 0.15) : true
                        bool condPricesA = i_dbRequireUndercut ? (sL < fL * 1.05) : (sL <= fL * 1.05 or sL >= fL * 0.80)
                        bool condPricesB = sL >= (1.0 - i_dbDepth / 100.0) * peak
                        bool condPricesC = sL <= peak * 0.95
                        bool condPricesD = sH >= sL + (peak - sL) * 0.15
                        bool condPricesE = sH <= fH * 1.10
                        bool condPricesF = sH >= fL + (fH - fL) * 0.15

                        float firstLegDepth = fH - fL
                        float scndLegDepth  = sH - sL
                        bool condPricesG   = firstLegDepth > 0 and scndLegDepth > 0

                        bool condTimeA = fHt < fLt and fLt < sHt and sHt < sLt
                        bool condTimeB = (sLt - fHt) <= maxDbBars
                        int minDbBars = timeframe.isweekly ? i_dbMinLengthWeeks : (i_dbMinLengthWeeks * 5)
                        bool condTimeC = (sLt - fHt) >= minDbBars

                        int checkLen = math.min(4950, math.max(1, bar_index - sLt + 1))
                        float highestSince2ndLow = ta.highest(high, checkLen)
                        bool condBothA = highestSince2ndLow <= sH * 1.02

                        if condPriorTrend and condPricesH and condPricesA and condPricesB and condPricesC and condPricesD and condPricesE and condPricesF and condPricesG and condTimeA and condTimeB and condTimeC and condBothA
                            detectDoubleBottom := true
                            db_fH := fH
                            db_fHt := fHt
                            db_fL := fL
                            db_fLt := fLt
                            db_sH := sH
                            db_sHt := sHt
                            db_sL := sL
                            db_sLt := sLt
                            array.unshift(bottomDBPrice, sL)
                            array.unshift(topDBPrice, sH)
                            topDBBar := sHt
                            break
            if detectDoubleBottom
                break
isDoubleBottom = false
if detectDoubleBottom or isDoubleBottom[1]
    isDoubleBottom := true
    isDoubleBottom

if isBase
    array.unshift(baseCloses, close)

detectCup = false
isCup = false
float highCup = 0
float lowCup = 0
condThird = false
condFourth = false
condThirdTwo = false
condFourthTwo = false
float middleOfCup = 0
baseTier = baseCount / 3
baseFourth = baseCount / 4
numberOfValidCl1 = 0
numberOfValidCl2 = 0
if isBase
    if array.size(startBasePrice) > 0 and array.size(lowBasePrice) > 0
        highCup := array.get(startBasePrice, 0)
        lowCup := array.get(lowBasePrice, 0)
        lowCup
    middleOfCup := lowCup + (highCup - lowCup) * 0.5
    condMaxDepth = lowCup >= (1 - i_baseDepth) * highCup
    condMinDepth = lowCup <= 0.92 * highCup
    condMaxLength = bar_index - startBaseBar <= i_baseLength
    condMinLength = bar_index - startBaseBar >= 30
    condAbsolutePos = (highCup - lowCup) * 0.5 + lowCup <= high
    for i = baseCount to 2 * baseTier by 1
        if close[i] >= middleOfCup
            numberOfValidCl1 := numberOfValidCl1 + 1
            numberOfValidCl1
    condThirdTwo := numberOfValidCl1 / baseTier >= 0.3
    for i = baseCount - baseTier to baseTier by 1
        if close[i] <= middleOfCup
            numberOfValidCl2 := numberOfValidCl2 + 1
            numberOfValidCl2
    condThird := numberOfValidCl2 / baseTier >= 0.90
    numberOfValidCl1 := 0
    numberOfValidCl2 := 0
    for i = baseCount to 3 * baseFourth by 1
        if close[i] >= middleOfCup
            numberOfValidCl1 := numberOfValidCl1 + 1
            numberOfValidCl1
    condThirdTwo := numberOfValidCl1 / baseFourth >= 0.3
    for i = baseCount - baseFourth to baseFourth by 1
        if close[i] <= middleOfCup
            numberOfValidCl2 := numberOfValidCl2 + 1
            numberOfValidCl2
    condFourth := numberOfValidCl2 / (2 * baseFourth) >= 0.90
    cupForm = condThird and condThird[1] and condThirdTwo and condThirdTwo[1] or condFourth and condFourth[1] and condFourthTwo and condFourthTwo[1]
    detectCup := condMaxDepth and condMinDepth and condMaxLength and condMinLength and condAbsolutePos and cupForm
    detectCup

if detectCup or isCup[1]
    isCup := true
    isCup

bool rightSide = isBase and bar_index > lowerBaseBar

var float rightSideHighCloseSep = 0.0
if not rightSide
    rightSideHighCloseSep := 0.0
else
    if close > nz(rightSideHighCloseSep[1], rightSideHighCloseSep) and close <= (array.size(startBasePrice) > 0 ? array.get(startBasePrice, 0) : na)
        rightSideHighCloseSep := close
    else
        rightSideHighCloseSep := nz(rightSideHighCloseSep[1], rightSideHighCloseSep)

var int handlePeakBarSep = 0
if not rightSide or rightSideHighCloseSep == 0.0
    handlePeakBarSep := 0
else
    float _leftTop = array.size(startBasePrice) > 0 ? array.get(startBasePrice, 0) : na
    float minHeightVal = not na(_leftTop) ? _leftTop * (i_handleMinHeightPct / 100.0) : 0.0
    if close > nz(rightSideHighCloseSep[1], rightSideHighCloseSep) * 1.05 and close <= _leftTop and close >= minHeightVal
        handlePeakBarSep := bar_index
    else
        handlePeakBarSep := nz(handlePeakBarSep[1], handlePeakBarSep)

int handleBarCountSep = (rightSide and handlePeakBarSep > 0) ? bar_index - handlePeakBarSep : 0

var float handlePeakLockedSep = 0.0
if not rightSide or rightSideHighCloseSep == 0.0
    handlePeakLockedSep := 0.0
else if handleBarCountSep == 0
    handlePeakLockedSep := rightSideHighCloseSep
else
    handlePeakLockedSep := nz(handlePeakLockedSep[1], handlePeakLockedSep)

var float handleLowPointSep = 0.0
if not rightSide or handlePeakLockedSep == 0.0
    handleLowPointSep := 0.0
else
    if low < nz(handleLowPointSep[1], handleLowPointSep) or nz(handleLowPointSep[1], handleLowPointSep) == 0.0
        handleLowPointSep := low
    else
        handleLowPointSep := nz(handleLowPointSep[1], handleLowPointSep)

float handleDeclineLimit = 1.0 - i_handleMaxDecline / 100.0
bool handleDepthOKSep = handleLowPointSep >= handlePeakLockedSep * handleDeclineLimit
float _baseLow = array.size(lowBasePrice) > 0 ? array.get(lowBasePrice, 0) : na
float _baseTop = array.size(startBasePrice) > 0 ? array.get(startBasePrice, 0) : na
bool handleMidOKSep   = not na(_baseTop) and not na(_baseLow) and handleLowPointSep > (_baseTop + _baseLow) * 0.5

float volMaHandle  = ta.sma(volume, i_volMaLengthHandle)
int safeHandleBars = math.max(1, handleBarCountSep)
float sumVolHandle = math.sum(volume, safeHandleBars)
float volAvgHandle = na
if rightSide and handlePeakLockedSep > 0.0 and handleBarCountSep > 0
    volAvgHandle := sumVolHandle / handleBarCountSep


bool volContractionOK = not i_useVolHandle or (handleBarCountSep > 0 and volAvgHandle <= volMaHandle * i_volContractionMax / 100)
bool requireCupOK     = not i_requireCupForHandle or isCup or isDoubleBottom

bool handleFormingSep = i_showCupHandleSep and rightSide and handlePeakLockedSep > 0.0 and handleBarCountSep >= i_handleMinBars and handleBarCountSep <= i_handleMaxBars and handleDepthOKSep and handleMidOKSep and volContractionOK and requireCupOK

bool volBreakoutOK    = not i_useVolHandle or volume >= i_volBreakoutMult * volMaHandle
bool handleBreakoutSep = handleFormingSep and close > handlePeakLockedSep and volBreakoutOK

// Flag variables from drw_flag.pine
var float flag_baseHigh = na
var int flag_startIndex = na
var int flag_flagLength = 0
var float flag_baseLow = na
var int flag_lowIndex = na
var bool flag_flagBool = false
var float flag_poleLow = na
var int flag_poleLowIndex = na

var line flagHLine = na
var line flagLLine = na
var line flagPLine = na

var bool isHTF = false
var int htfPoleLowBar = na
var float htfPoleLowPrice = na
var int htfPoleHighBar = na
var float htfPoleHighPrice = na
var float htfFlagHighPrice = na
var float htfFlagLowPrice = na
var bool is_flag = false
float _flagHighest10 = ta.highest(high, 10)

if i_htfOn and bar_index > 30
    // find bull flag highs (from drw_flag.pine)
    if high > flag_baseHigh or na(flag_baseHigh)
        flag_baseHigh := high
        flag_startIndex := bar_index
        flag_flagLength := 0
        flag_baseLow := low
        flag_lowIndex := bar_index

    if high <= flag_baseHigh and low < flag_baseLow
        flag_baseLow := low
        flag_lowIndex := bar_index

    if high <= flag_baseHigh and flag_lowIndex == flag_startIndex
        flag_baseLow := low
        flag_lowIndex := bar_index

    // calculations
    float findDepth = flag_baseHigh > 0 ? math.abs(((flag_baseLow / flag_baseHigh) - 1.0) * 100.0) : 0.0
    bool lower_close = close < close[1]

    // start the counters
    if high < flag_baseHigh and findDepth <= i_htfDepth or (high == flag_baseHigh and lower_close)
        flag_flagLength += 1
    else
        flag_flagLength := 0

    // check for prior uptrend (pole gain >= 80% in <= 40 bars)
    if not flag_flagBool or high == flag_baseHigh
        float minLow = low[1]
        int minLowIdx = bar_index - 1
        int searchBars = math.min(i_htfPB, bar_index - 1)
        if searchBars >= i_htfPBMin
            for i = 1 to searchBars
                if low[i] < minLow
                    minLow := low[i]
                    minLowIdx := bar_index - i
            if minLow > 0 and ((flag_baseHigh / minLow) - 1.0) * 100.0 >= i_htfPole
                flag_flagBool := true
                flag_poleLow := minLow
                flag_poleLowIndex := minLowIdx

    // reset variables if criteria is broken
    if findDepth >= i_htfDepth or flag_flagLength > i_htfFMax
        flag_flagBool := false
        flag_flagLength := 0
        flag_baseHigh := na
        flag_startIndex := na
        flag_lowIndex := na
        flag_baseLow := na

    // reset and look for new flag if price continues higher before minimum length
    if high > nz(flag_baseHigh[1]) and flag_flagLength < i_htfFMin
        flag_baseHigh := high
        flag_flagLength := 0
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low

    // define the flag forming state
    is_flag := flag_flagBool == true and flag_flagLength <= i_htfFMax and findDepth < i_htfDepth and flag_flagLength >= i_htfFMin and (flag_startIndex - flag_poleLowIndex) <= i_htfPB

    // live line drawing from drw_flag.pine
    if is_flag and i_displayPattern
        if is_flag[1]
            line.delete(flagHLine)
            line.delete(flagLLine)
            line.delete(flagPLine)
        flagHLine := line.new(flag_startIndex, flag_baseHigh, bar_index, flag_baseHigh, color = color.green, width = 2, style = line.style_dotted)
        flagLLine := line.new(flag_startIndex, flag_baseLow, bar_index, flag_baseLow, color = color.green, width = 2, style = line.style_dotted)
        flagPLine := line.new(flag_poleLowIndex, flag_poleLow, flag_startIndex, flag_baseLow, color = color.green, width = 2, style = line.style_dotted)

    // define breakout & breakdown
    bool breakout = high > nz(flag_baseHigh[1]) and flag_flagLength >= i_htfFMin and flag_flagBool == true
    bool breakdown = findDepth >= i_htfDepth or flag_flagLength > i_htfFMax
    bool plotBO = is_flag[1] and high > nz(flag_baseHigh[1]) and flag_flagLength[1] >= i_htfFMin and flag_flagBool == true

    // apply volume confirmation if set
    bool volOK = true
    if i_htfVol > 0
        volOK := volume >= htfAvgVol * i_htfVol

    // update state variables when breakout or flag forming is triggered
    if (plotBO and volOK) or is_flag
        isHTF := true
        htfPoleLowBar := flag_poleLowIndex
        htfPoleLowPrice := flag_poleLow
        htfPoleHighBar := flag_startIndex
        htfPoleHighPrice := flag_baseHigh
        htfFlagHighPrice := flag_baseHigh
        htfFlagLowPrice := flag_baseLow
    else
        isHTF := false


    // reset variables if a breakout occurs
    if breakout
        flag_flagLength := 0
        flag_baseHigh := high
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low

    // reset from a failed flag (breakdown)
    if breakdown or flag_flagLength == i_htfFMax
        flag_flagBool := false
        flag_baseHigh := _flagHighest10
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low

    if breakdown and is_flag[1]
        line.delete(flagHLine)
        line.delete(flagLLine)
        line.delete(flagPLine)
else
    isHTF := false
    is_flag := false


var line highLine = na
