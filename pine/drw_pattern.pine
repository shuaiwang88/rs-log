    line.delete(dbLine3)
    bottomDBBar := db_sLt
    highLine := line.new(x1 = db_sHt, y1 = db_sH, x2 = bar_index + 10, y2 = db_sH, width = 2, style = line.style_dashed, color = color.green)
    dbLine1 := line.new(x1 = db_fHt, y1 = db_fH, x2 = db_fLt, y2 = db_fL, width = 2, style = line.style_solid, color = color.green)
    dbLine2 := line.new(x1 = db_fLt, y1 = db_fL, x2 = db_sHt, y2 = db_sH, width = 2, style = line.style_solid, color = color.green)
    dbLine3 := line.new(x1 = db_sHt, y1 = db_sH, x2 = db_sLt, y2 = db_sL, width = 2, style = line.style_solid, color = color.green)
