    // Recent modification made that I need to put the IBD/MarketSmith limitaton of +999% here
    _cellText = _value > 999 ? '+999% |' : _value < -999 ? '-999% |' : _value > 0 ? '+' + str.tostring(_value, '0') + '% |' : str.tostring(_value, '0') + '% |'
