//     f_cell(tbl, 1, 13, _rsStr,           rsCount > 0 ? C_G : C_D)

//     // ── MA Touch Post-BO row  ── ← NEW ───────────────────────────────────────
//     string touchStatus = inBase ? '—' : (hasTouchedPostBO ? '✓ YES' : 'NO')
//     color  touchBg     = not inBase and hasTouchedPostBO ? C_G : C_D
//     f_cell(tbl, 0, 14, 'MA Touch Post-BO', C_D)
//     f_cell(tbl, 1, 14, touchStatus,       touchBg)

//     // ── Separator ─────────────────────────────────────────────────────────────
//     f_cell(tbl, 0, 15, '─── Result ────', C_S)          // ← was row 14
//     f_cell(tbl, 1, 15, '',                C_S)

//     // ── Active pattern & overall signal ───────────────────────────────────────
//     f_cell(tbl, 0, 16, 'Active Pattern',  C_D)           // ← was row 15
//     f_cell(tbl, 1, 16, pName,             pOn ? C_G : C_D)

//     f_cell(tbl, 0, 17, 'Pattern Code',    C_D)           // ← was row 16
//     string _codeStr = str.tostring(pCode) + '  (0=None 1=Base 2=Flat 3=Cup 4=CwH 5=DB 6=HTF 7=6wF)'
//     f_cell(tbl, 1, 17, _codeStr,          C_D)

//     f_cell(tbl, 0, 18, '▶  SIGNAL',      signal ? C_G : C_R)   // ← was row 17
//     f_cell(tbl, 1, 18, signal ? '✓  MATCH' : '✗  NO MATCH', signal ? C_G : C_R)

// ═════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(signal,                              'Any Pattern Match',     'Pattern scanner: match')
alertcondition(signal and not signal[1],            'New Signal',            'Pattern scanner: new signal')
alertcondition((isFlatBase  or pCode == 2) and distOk and modeOk,  'Flat Base',             'Pattern scanner: Flat Base')
alertcondition((isDeepBase  or pCode == 1) and distOk and modeOk,  'Base (Deep)',           'Pattern scanner: Base (Deep)')
alertcondition((isCup       or pCode == 3) and distOk and modeOk,  'Cup',                   'Pattern scanner: Cup')
alertcondition((isCupH      or pCode == 4) and distOk and modeOk,  'Cup + Handle',          'Pattern scanner: Cup with Handle')
alertcondition((isDB        or pCode == 5) and distOk and modeOk,  'Double Bottom',         'Pattern scanner: Double Bottom')
alertcondition((isHTF       or pCode == 6) and distOk and modeOk,  'High Tight Flag',       'Pattern scanner: High Tight Flag')
alertcondition((is6WkFlat   or pCode == 7) and distOk and modeOk,  '6-Wk Flat Base',       'Pattern scanner: 6-Wk Flat Base')

// ── RS New High alerts  ── ← NEW ─────────────────────────────────────────────
alertcondition(rsNH_any and rsWindow,               'RS New High in Base/BO',
               'Pattern scanner: RS New High (any period) during base or post-BO window')
alertcondition(rsNH_1y and rsWindow,                'RS New High 1Y in Base/BO',
               'Pattern scanner: RS at 1-Year New High during base or post-BO window')

// ── Two-Part Score System alerts  ── ← NEW ───────────────────────────────────
alertcondition(shakeoutEntry,                       'Shakeout Entry',
               'Pattern scanner: 3-EMA shakeout entry signal')
alertcondition(beforeBOScore >= 3,                   'Before-BO Score >= 3',
               'Pattern scanner: Before-BO score reached 3 or higher')
alertcondition(postBOScore >= 3,                     'Post-BO Score >= 3',
               'Pattern scanner: Post-BO score reached 3 or higher')
// Composite score alert (NEW)
alertcondition(compositeScore >= 6,                 'Composite Score >= 6',
               'Pattern scanner: Combined pre+post breakout score reached 6 or higher')