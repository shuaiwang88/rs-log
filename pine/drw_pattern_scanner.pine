// at https://mozilla.org/MPL/2.0/
// @version=6
// ─────────────────────────────────────────────────────────────────────────────
//  MS Pattern Scanner
//  Derived from the MarketSmith Indicator (Fred6724 / amphibiantrading)
//
//  PATTERN CODE REFERENCE
//  ─────────────────────
//  0 = No pattern detected
//  1 = Base          (consolidation, depth > 15%)
//  2 = Flat Base     (consolidation, depth ≤ 15%, any length)
//  3 = Cup
//  4 = Cup with Handle
//  5 = Double Bottom
//  6 = High Tight Flag
//  7 = 6-Wk Flat Base  (flat base, depth ≤ 15%, 5–7 weeks long)
//
//  HOW TO USE AS A SCREENER
//  ─────────────────────────
//  1. Add this indicator to any chart on TradingView.
//  2. Open the TradingView Stock Screener, click "Filters" → "Technical" →
//     search for this indicator's name.  Filter on:
//       • "Signal (0/1)"          = 1   →  any active match
//       • "Pattern Code"          = 7   →  6-wk flat bases only, etc.
//       • "Distance to Pivot %"   between -5 and +5
//       • "Bars Since Breakout"   less than 20
//       • "RS NH Count"           > 3   →  3+ RS new-high days in base/BO
//       • "Before-BO Score (0-6)" >= 4  →  strong pre-breakout setup
//       • "Post-BO Score (0-6)"   >= 4  →  strong post-breakout confirmation
//       • "Composite Score (0-12)" >= 8 →  combined pre+post strength
//  3. Set per-pattern alerts via the alertcondition() calls at the bottom.
// ─────────────────────────────────────────────────────────────────────────────
indicator('MS Pattern Scanner', overlay = true, max_bars_back = 500,
          max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ═════════════════════════════════════════════════════════════════════════════

// ── Pattern toggles ───────────────────────────────────────────────────────────
i_flatBase   = input.bool(true,  'Flat Base  (depth ≤ 15%)',        group = 'Patterns', inline = 'r1')
i_deepBase   = input.bool(true,  'Base  (depth > 15%)',             group = 'Patterns', inline = 'r1')
i_6wkFlat    = input.bool(true,  '6-Wk Flat Base (5–7 wks, ≤15%)', group = 'Patterns')
i_cup        = input.bool(true,  'Cup',                             group = 'Patterns', inline = 'r2')
i_cupHandle  = input.bool(true,  'Cup with Handle',                 group = 'Patterns', inline = 'r2')
i_db         = input.bool(true,  'Double Bottom',                   group = 'Patterns', inline = 'r3')
i_htf        = input.bool(true,  'High Tight Flag',                 group = 'Patterns', inline = 'r3')

// ── Range filters ─────────────────────────────────────────────────────────────
i_distMin       = input.float(-5.0, 'Distance to Pivot – Min %', step = 0.5,
                    group = 'Range Filters',
                    tooltip = 'Negative = price is BELOW pivot (still inside base). '
                            + '0 = at pivot. Positive = price is above pivot (post-BO territory). '
                            + 'Typical buy zone: −2 % to +5 %.')
i_distMax       = input.float( 5.0, 'Distance to Pivot – Max %', step = 0.5,
                    group = 'Range Filters')
i_bsoMax        = input.int(20,     'Max Bars Since Breakout',   minval = 1,
                    group = 'Range Filters',
                    tooltip = 'Applies only to post-breakout mode. '
                            + 'Stocks still forming a base always pass this filter.')
i_includeInBase = input.bool(true,  'Include stocks still in base',  group = 'Range Filters')
i_includePostBO = input.bool(true,  'Include stocks post-breakout',  group = 'Range Filters')

// ── Pattern parameters ────────────────────────────────────────────────────────
i_pivLen     = input.int(9,  'Pivot Look-Left / Right (bars)', group = 'Pattern Parameters')
i_baseDepth  = input.int(50, 'Base Max Depth %',               group = 'Pattern Parameters', inline = 'bd')
i_baseLen    = input.int(65, 'Base Max Length (weeks)',         group = 'Pattern Parameters', inline = 'bd')
i_6wkTarget  = input.int(6,  '6-Wk Flat – Target Weeks (±1)', group = 'Pattern Parameters',
                 minval = 3, maxval = 15,
                 tooltip = 'Ideal consolidation length in weeks. '
                         + 'The detector fires when bCount is within ±1 week (±5 bars) of this target. '
                         + 'Default = 6 weeks → window of 25–35 bars (5–7 weeks).')

// ── High Tight Flag ───────────────────────────────────────────────────────────
i_htfOn   = input.bool(true,   'Enable HTF Detection',  group = 'High Tight Flag')
i_htfPole = input.float(80.0,  'Min Pole Gain %',       group = 'High Tight Flag', step = 5.0, tooltip = 'At least 80% prior uptrend.')
i_htfPB   = input.int(40,      'Max Pole Bars',         group = 'High Tight Flag', tooltip = 'Less than 8 weeks = 40 bars.')
i_htfPBMin= input.int(5,       'Min Pole Bars',         group = 'High Tight Flag')
i_htfFMin = input.int(6,       'Min Flag Bars',         group = 'High Tight Flag', minval = 1, tooltip = 'Default 3 bars for earlier detection.')

i_htfFMax = input.int(20,      'Max Flag Bars',         group = 'High Tight Flag', tooltip = '4 weeks = 20 bars.')
i_htfRet  = input.float(25.0,  'Max Flag Retrace %',    group = 'High Tight Flag', tooltip = 'Less than 25% correction.')
i_htfVol  = input.float(1.2,   'BO Volume × Avg',       group = 'High Tight Flag')



// ── Display ───────────────────────────────────────────────────────────────────
i_showBg    = input.bool(true, 'Highlight signal bar',  group = 'Display')
i_showLabel = input.bool(true, 'Show label on signal',  group = 'Display')
i_showTable = input.bool(true, 'Show status table',     group = 'Display')

// ── RS New High Count  ── ← NEW ──────────────────────────────────────────────
//  Uses the same iArpanK raw RS formula as the Raw RS + QGDRS Signals indicator.
//  rsCount accumulates every bar where RS makes any new high (1Y / 6M / 3M)
//  while the stock is in a base or within the post-breakout window.
//  Resets to 0 (or 1 if RS is also a new high that day) when a new base starts.
i_rsIdx  = input.symbol('SP:SPX', 'RS Benchmark Index',
              group   = 'RS New High Count',
              tooltip = 'Benchmark used to compute Raw RS — match your QGDRS indicator. '
                      + 'Default = SP:SPX.')
i_rsSc   = input.float(7.0, 'RS Scaling Factor',
              minval  = 0.1, step = 0.1,
              group   = 'RS New High Count',
              tooltip = 'Multiplier in the iArpanK Raw RS formula (close × factor × 1000 ÷ index). '
                      + 'QGDRS default = 7.')
i_rsLB   = input.int(250, 'RS 1Y Lookback (bars)',
              minval  = 50, maxval = 500,
              group   = 'RS New High Count',
              tooltip = '250 ≈ 1 trading year on a daily chart. '
                      + '6M (÷ 2) and 3M (÷ 4) lookback windows are derived automatically.')

// ── Breakout MA Touch Scanner ───────────────────────────────────────────────
i_boTouchDays = input.int(12, 'Touch Lookback Days/Bars',
                  group   = 'Breakout MA Touch Scanner',
                  tooltip = 'Lookback window (number of bars) after breakout to check for MA touch.')
i_maLength1   = input.int(10, 'MA Length 1',
                  group   = 'Breakout MA Touch Scanner',
                  tooltip = 'Length of the first moving average (default = 10).')
i_maType1     = input.string('EMA', 'MA Type 1', options = ['EMA', 'SMA'],
                  group   = 'Breakout MA Touch Scanner')
i_maLength2   = input.int(21, 'MA Length 2',
                  group   = 'Breakout MA Touch Scanner',
                  tooltip = 'Length of the second moving average (default = 21).')
i_maType2     = input.string('EMA', 'MA Type 2', options = ['EMA', 'SMA'],
                  group   = 'Breakout MA Touch Scanner')
i_maLength3   = input.int(34, 'MA Length 3',
                  group   = 'Breakout MA Touch Scanner',
                  tooltip = 'Length of the third moving average (default = 34).')
i_maType3     = input.string('EMA', 'MA Type 3', options = ['EMA', 'SMA'],
                  group   = 'Breakout MA Touch Scanner')
i_touchThresh = input.float(0.5, 'Touch Tolerance %', step = 0.1,
                  group   = 'Breakout MA Touch Scanner',
                  tooltip = 'Price is considered touching if its range (high to low) comes within this percent of the MA. Set to 0 for strict touch.')

// ── Breakout Volume & PP Scanner ─────────────────────────────────────────────
i_vduLength   = input.int(50, 'VDU Average Volume Length',
                  group   = 'Breakout Volume & PP Scanner',
                  tooltip = 'SMA length of volume used for dry up calculations.')
i_dryUpReq    = input.int(45, 'Volume Dry Up Level %',
                  group   = 'Breakout Volume & PP Scanner',
                  tooltip = 'Percentage below average volume to qualify as a dry up. E.g., 45% means volume is < 55% of average.')

// ── Two-Part Score System  ── ← NEW ──────────────────────────────────────────
i_preBOPivotPct = input.float(15.0, 'Before-BO: Within % of Pivot', step = 1.0,
                    group   = 'Two-Part Score System',
                    tooltip = 'Stock must still be in the base AND within this % of the base pivot '
                            + 'for Before-BO score components to accumulate.')
i_postBOBars    = input.int(15, 'Post-BO: Bars Window', minval = 1,
                    group   = 'Two-Part Score System',
                    tooltip = 'Number of bars after breakout (including the breakout bar itself) during '
                            + 'which Post-BO score components can accumulate.')

// ── Shakeout Component  ── ← NEW (ported from the "shakeout" indicator) ─────
i_shakeOn       = input.bool(true,  'Enable Shakeout Detection',       group = 'Shakeout')
i_shakeShow     = input.bool(false, 'Show Shakeout Markers on Chart',  group = 'Shakeout')
i_shakeTrendLen = input.int(50, 'Shakeout Trend EMA Length', minval = 10, group = 'Shakeout')
i_shakeLR       = input.int(3,  'Shakeout Swing Left/Right (bars)',   minval = 1, group = 'Shakeout')

// ── Ratings Inputs ─────────────────────────────────────────────────────────
i_adLookback = input.int(65, 'A/D Lookback (bars)', minval=10, group='Ratings',
                tooltip='~65 bars = 13 weeks for A/D rating calculation.')

// ═════════════════════════════════════════════════════════════════════════════
//  DERIVED CONSTANTS
// ═════════════════════════════════════════════════════════════════════════════
int barsPerWeek = timeframe.isweekly ? 1 : 5
int pivLag      = 5 * barsPerWeek
int win13wk     = 13 * barsPerWeek
int win20wk     = 20 * barsPerWeek
int win10wk     = 10 * barsPerWeek

float bdF   = i_baseDepth / 100.0   // base depth as a fraction
int   bLenB = i_baseLen * barsPerWeek

// ── 6-Week Flat Base bar window  (target ± 1 week = ± barsPerWeek) ─────────────
int i_6wkMin = math.max(1, (i_6wkTarget - 1) * barsPerWeek)
int i_6wkMax = (i_6wkTarget + 1) * barsPerWeek

// ── RS derived lookback windows  ── ← NEW ────────────────────────────────────
//  math.round(float) with no digits arg returns int in Pine Script v6.
int _rsLB6m = math.max(1, math.round(i_rsLB / 2.0))   // ~6 M  (e.g. 125 bars)
int _rsLB3m = math.max(1, math.round(i_rsLB / 4.0))   // ~3 M  (e.g. 62 bars)

// ═════════════════════════════════════════════════════════════════════════════
//  PRE-COMPUTED TA  — all unconditional (Pine Script requirement)
// ═════════════════════════════════════════════════════════════════════════════
int lowestPointLegLen = win20wk + (timeframe.isweekly ? 1 : 3)
int handleLen = math.max(2, math.round(2.4 * barsPerWeek))

float H25    = ta.highest(high, pivLag)
float L25    = ta.lowest (low,  pivLag)
float L103   = ta.lowest (low,  lowestPointLegLen)
float H65s   = ta.highest(high, win13wk)[pivLag + 1]    // pivLag+1 bar shifted win13wk-bar high
float H12    = ta.highest(high, handleLen)
float L12    = ta.lowest (low,  handleLen)
int   lBar25 = ta.barssince(low == L25)    // bars since the pivLag-bar low
float prL250 = ta.lowest(low, math.max(1, math.min(bar_index, 50 * barsPerWeek)))
float avgVol = ta.sma(volume, 20)

// ── Raw RS + new-high lookbacks  ── ← NEW ────────────────────────────────────
//  Same formula as Raw RS + QGDRS Signals: close × scale × 1000 ÷ index_close
float _idxClose  = request.security(i_rsIdx, timeframe.period, close)
float rs_raw_val = not na(_idxClose) and _idxClose != 0
                 ? close * i_rsSc * 1000 / _idxClose : na

//  Prior-period highs ([1] shift → exclude current bar, matching QGDRS logic)
float _rsH1y = ta.highest(rs_raw_val, i_rsLB)[1]
float _rsH6m = ta.highest(rs_raw_val, _rsLB6m)[1]
float _rsH3m = ta.highest(rs_raw_val, _rsLB3m)[1]

bool  rsNH_1y  = not na(rs_raw_val) and not na(_rsH1y) and rs_raw_val > _rsH1y
bool  rsNH_6m  = not na(rs_raw_val) and not na(_rsH6m) and rs_raw_val > _rsH6m
bool  rsNH_3m  = not na(rs_raw_val) and not na(_rsH3m) and rs_raw_val > _rsH3m
bool  rsNH_any = rsNH_1y or rsNH_6m or rsNH_3m
// Best (longest) period label for the current bar
string rsNH_per = rsNH_1y ? '1Y' : rsNH_6m ? '6M' : rsNH_3m ? '3M' : ''

// ═════════════════════════════════════════════════════════════════════════════
//  PIVOT ARRAYS
// ═════════════════════════════════════════════════════════════════════════════
var array<float> aHP = array.new_float()   // pivot high prices
var array<float> aLP = array.new_float()   // pivot low prices
var array<int>   aHB = array.new_int()     // pivot high bar indices
var array<int>   aLB = array.new_int()     // pivot low bar indices

float _pH = ta.pivothigh(high, i_pivLen, i_pivLen)
float _pL = ta.pivotlow (low,  i_pivLen, i_pivLen)

if bool(_pH)
    array.unshift(aHP, high[i_pivLen])
    array.unshift(aHB, bar_index[i_pivLen])
if bool(_pL)
    array.unshift(aLP, low[i_pivLen])
    array.unshift(aLB, bar_index[i_pivLen])

// ═════════════════════════════════════════════════════════════════════════════
//  BASE DETECTION
//  Logic ported from the MarketSmith Indicator (consolidation engine)
// ═════════════════════════════════════════════════════════════════════════════
var float bTop   = na      // pivot high that started the base
var float bLow   = na      // deepest low reached inside the base
var int   bStart = na      // bar index when base started
var bool  isBase = false
var int   bCount = 0
var float lastBTop = na    // last confirmed base top (persists after base ends)

bool newBase = false

if array.size(aHP) > 2
    bool _bH   = high[pivLag] == array.get(aHP, 0) or
                 high[pivLag] == array.get(aHP, 1) or
                 high[pivLag] == array.get(aHP, 2)
    bool _bPH  = high[pivLag] > H65s or (not na(bTop) and high[pivLag] > bTop)
    bool _lUp  = L103 * 1.20 <= high[pivLag]
    bool _dep  = high[pivLag] * (1 - bdF) <= L25
    bool _noAb = H25 <= high[pivLag]
    bool _noNe = isBase[pivLag] == false
    newBase   := _bH and _bPH and _lUp and _dep and _noAb and _noNe

if newBase and not isBase[1]
    bTop     := high[pivLag]
    bLow     := L25
    bStart   := bar_index[pivLag]
    bCount   := pivLag
    isBase   := true
    lastBTop := high[pivLag]

if not newBase and isBase[1]
    isBase := true

if isBase
    bCount   := bCount + 1
    lastBTop := bTop          // keep lastBTop current while inside the base

// Track deepest low (only within allowed depth)
if isBase and low < bLow and low >= bTop * (1 - bdF)
    bLow := low

// Invalidate: too deep or too long
if isBase and (low < bTop * (1 - bdF) or bCount > bLenB)
    isBase := false

// Breakout: price clears the base top
if isBase and not na(bTop) and high > bTop
    isBase := false

// Depth % (used for flat vs. deep classification)
float bDepPct = not na(bTop) and bTop > 0 and not na(bLow)
              ? (bTop - bLow) / bTop * 100 : na

bool isFlatBase = isBase and not na(bDepPct) and bDepPct <= 15.0
bool isDeepBase = isBase and not na(bDepPct) and bDepPct >  15.0

// ── 6-Week Flat Base ──────────────────────────────────────────────────────────
bool is6WkFlat = isFlatBase and bCount >= i_6wkMin and bCount <= i_6wkMax

// ═════════════════════════════════════════════════════════════════════════════
//  DOUBLE BOTTOM DETECTION
// ═════════════════════════════════════════════════════════════════════════════

// Pre-compute ta.highest with dynamic length unconditionally
int   _dbFL  = array.size(aLB) > 0 ? math.min(14999, math.max(1, bar_index - array.get(aLB, 0) + 1)) : 1

float _dbHFL = ta.highest(high, _dbFL)

bool detectDB = false

if isBase and array.size(aHP) > 1 and array.size(aLP) > 1
    float fH = array.get(aHP, 1)     // first (left) pivot high  — base start
    float sH = array.get(aHP, 0)     // second (middle) pivot high
    float fL = array.get(aLP, 1)     // first pivot low  (left leg)
    float sL = array.get(aLP, 0)     // second pivot low (right leg)
    int  fHt = array.size(aHB) > 1 ? array.get(aHB, 1) : 0
    int  sLt = array.size(aLB) > 1 ? array.get(aLB, 1) : 0
    int  sHt = array.get(aHB, 0)
    int  fLt = array.get(aLB, 0)

    // ── Price conditions ──────────────────────────────────────────────────────
    bool cPT = fH >= prL250 * 1.20
    bool cPH = not na(bTop) and math.abs(fH - bTop) < bTop * 0.01
    bool cA  = sL  <= fL  * 1.03
    bool cB  = sL  >= (1 - bdF) * fH
    bool cC  = sL  <= fH  * 0.90
    bool cD  = sH  >= sL  + (fH - sL) * 0.35
    bool cE  = sH  <  fH  * 1.01
    bool cF  = sH  >= fL  + (fH - fL) * 0.40
    float fd = fH - fL
    float sd = sH - sL
    bool cG  = fd > 0 and sd > 0 and fd / sd <= 3.0 and sd / fd <= 3.0

    // ── Time conditions ───────────────────────────────────────────────────────
    bool cTA = fHt < sLt and sLt < sHt and sHt < fLt
    bool cTB = fLt - fHt <= bLenB
    bool cTC = fLt - fHt >= 2 * barsPerWeek
    int dbMinSpacing = math.max(1, math.round(3.0 * barsPerWeek / 5.0))
    bool cTD = (sLt - fHt) >= dbMinSpacing and (sHt - sLt) >= dbMinSpacing and (fLt - sHt) >= dbMinSpacing
    int  h1  = sHt - fHt
    int  h2  = bar_index - sHt
    bool cTE = h1 > 0 and h2 > 0 and h1 / h2 <= 4.0 and h2 / h1 <= 4.0
    bool cTF = bar_index - fLt <= (sHt - fHt) * 2

    // ── Shape: no bar above middle high since 2nd low ─────────────────────────
    bool cSh = _dbHFL <= sH

    if cPT and cPH and cA and cB and cC and cD and cE and cF and cG and
       cTA and cTB and cTC and cTD and cTE and cTF and cSh
        detectDB := true

var bool isDB = false
if detectDB or isDB[1]
    isDB := true
if not isBase
    isDB := false
if isDB and array.size(aLP) > 0 and low < array.get(aLP, 0)
    isDB := false   // 2nd low broken → pattern invalidated

// ═════════════════════════════════════════════════════════════════════════════
//  CUP DETECTION
// ═════════════════════════════════════════════════════════════════════════════
var bool isCup = false
bool     detectCup = false
float    cupMid    = not na(bTop) and not na(bLow) ? bLow + (bTop - bLow) * 0.5 : na

int minCupLen = 6 * barsPerWeek
if isBase and not isDB and not na(bTop) and not na(bLow) and bCount >= minCupLen
    float mid  = bLow + (bTop - bLow) * 0.5
    int   tier = math.max(1, bCount / 3)

    bool depOk = bLow >= (1 - bdF) * bTop and bLow <= 0.92 * bTop
    bool lenOk = bCount <= bLenB
    bool posOk = mid <= high     // price is in the upper half

    // Count bars in the oldest 1/3 that close ABOVE the midpoint (cup sides)
    int nV1 = 0
    for i = bCount to 2 * tier by 1
        if close[i] >= mid
            nV1 := nV1 + 1

    // Count bars in the middle 1/3 that close BELOW the midpoint (cup bottom)
    int nV2 = 0
    for i = (bCount - tier) to tier by 1
        if close[i] <= mid
            nV2 := nV2 + 1

    bool cT  = float(nV2) / float(tier) >= 0.85
    bool cT2 = float(nV1) / float(tier) >= 0.30

    detectCup := depOk and lenOk and posOk and cT and cT2

if detectCup or isCup[1]
    isCup := true
if not isBase
    isCup := false

// ═════════════════════════════════════════════════════════════════════════════
//  CUP WITH HANDLE
//  Handle = recent tight consolidation in the upper 50% of the cup,
//           ≤ 12 bars long, ≤ 15% deep
// ═════════════════════════════════════════════════════════════════════════════
bool isCupH = false
if isCup and not na(bTop) and not na(bLow) and not na(cupMid) and bCount > handleLen
    float hDep  = H12 > 0 ? (H12 - L12) / H12 * 100 : na
    bool  inTop = L12 >= cupMid
    bool  depOk = not na(hDep) and hDep <= 15.0
    isCupH := inTop and depOk

// ═════════════════════════════════════════════════════════════════════════════
//  HIGH TIGHT FLAG DETECTION (drw_flag.pine engine)
// ═════════════════════════════════════════════════════════════════════════════
var float flag_baseHigh = na
var int flag_startIndex = na
var int flag_flagLength = 0
var float flag_baseLow = na
var int flag_lowIndex = na
var bool flag_flagBool = false
var float flag_poleLow = na
var int flag_poleLowIndex = na

var bool isHTF = false
var bool is_flag = false
var int  htfBoBar = na
float _scanHighest10 = ta.highest(high, 10)

if i_htfOn and bar_index > 30
    // find bull flag highs (from drw_flag.pine)
    if high > flag_baseHigh or na(flag_baseHigh)
        flag_baseHigh := high
        flag_startIndex := bar_index
        flag_flagLength := 0
        flag_baseLow := low
        flag_lowIndex := bar_index

    if high <= flag_baseHigh and low < flag_baseLow
        flag_baseLow := low
        flag_lowIndex := bar_index

    if high <= flag_baseHigh and flag_lowIndex == flag_startIndex
        flag_baseLow := low
        flag_lowIndex := bar_index

    // calculations
    float findDepth = flag_baseHigh > 0 ? math.abs(((flag_baseLow / flag_baseHigh) - 1.0) * 100.0) : 0.0
    bool lower_close = close < close[1]

    // start the counters
    if high < flag_baseHigh and findDepth <= i_htfRet or (high == flag_baseHigh and lower_close)
        flag_flagLength += 1
    else
        flag_flagLength := 0

    // check for prior uptrend (pole gain >= 80% in <= 40 bars)
    if not flag_flagBool or high == flag_baseHigh
        float minLow = low[1]
        int minLowIdx = bar_index - 1
        int searchBars = math.min(i_htfPB, bar_index - 1)
        if searchBars >= i_htfPBMin
            for i = 1 to searchBars
                if low[i] < minLow
                    minLow := low[i]
                    minLowIdx := bar_index - i
            if minLow > 0 and ((flag_baseHigh / minLow) - 1.0) * 100.0 >= i_htfPole
                flag_flagBool := true
                flag_poleLow := minLow
                flag_poleLowIndex := minLowIdx

    // reset variables if criteria is broken
    if findDepth >= i_htfRet or flag_flagLength > i_htfFMax
        flag_flagBool := false
        flag_flagLength := 0
        flag_baseHigh := na
        flag_startIndex := na
        flag_lowIndex := na
        flag_baseLow := na

    // reset and look for new flag if price continues higher before minimum length
    if high > nz(flag_baseHigh[1]) and flag_flagLength < i_htfFMin
        flag_baseHigh := high
        flag_flagLength := 0
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low

    // define the flag forming state
    is_flag := flag_flagBool == true and flag_flagLength <= i_htfFMax and findDepth < i_htfRet and flag_flagLength >= i_htfFMin and (flag_startIndex - flag_poleLowIndex) <= i_htfPB

    // define breakout & breakdown
    bool breakout = high > nz(flag_baseHigh[1]) and flag_flagLength >= i_htfFMin and flag_flagBool == true
    bool breakdown = findDepth >= i_htfRet or flag_flagLength > i_htfFMax
    bool plotBO = is_flag[1] and high > nz(flag_baseHigh[1]) and flag_flagLength[1] >= i_htfFMin and flag_flagBool == true

    // apply volume confirmation if set
    bool volOK = true
    if i_htfVol > 0
        volOK := volume >= avgVol * i_htfVol

    if plotBO and volOK
        htfBoBar := bar_index

    bool htfPostBOActive = not na(htfBoBar) and (bar_index - htfBoBar) <= i_bsoMax

    if (plotBO and volOK) or is_flag or htfPostBOActive
        isHTF := true
    else
        isHTF := false


    // reset variables if a breakout occurs
    if breakout
        flag_flagLength := 0
        flag_baseHigh := high
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low

    // reset from a failed flag (breakdown)
    if breakdown or flag_flagLength == i_htfFMax
        flag_flagBool := false
        flag_baseHigh := _scanHighest10
        flag_startIndex := bar_index
        flag_lowIndex := bar_index
        flag_baseLow := low
else
    isHTF := false
    is_flag := false
    htfBoBar := na



// ═════════════════════════════════════════════════════════════════════════════
//  BREAKOUT & PIVOT TRACKING
// ═════════════════════════════════════════════════════════════════════════════
bool   pOn   = false
string pName = 'None'
int    pCode = 0

bool inBase  = isBase or isDB or isCup or isCupH or isHTF
bool wasBase = isBase[1] or isDB[1] or isCup[1] or isCupH[1] or isHTF[1]

var float boPivot = na   // price level of the most recent breakout pivot
var int   boBar   = na   // bar index of the most recent breakout
var int   boPatternCode = 0
var string boPatternName = 'None'

// Detect breakout: was in a pattern last bar, is not now, and high cleared the top
float activeBTop = isHTF[1] ? flag_baseHigh[1] : lastBTop
if wasBase and not inBase and not na(activeBTop) and high > activeBTop
    boPivot := activeBTop
    boBar   := bar_index
    // Capture the pattern that just broke out (from previous bar's state)
    boPatternCode := pCode[1]
    boPatternName := pName[1]

// Reset when a brand-new base starts
if newBase
    boPivot := na
    boBar   := na
    boPatternCode := 0
    boPatternName := 'None'

// ── Key metrics ───────────────────────────────────────────────────────────────
float pivRef  = inBase ? (isHTF ? flag_baseHigh : bTop) : boPivot

float distPctInternal = not na(pivRef) and pivRef > 0 ? (close - pivRef) / pivRef * 100 : na
float distPct = inBase and not na(pivRef) and pivRef > 0 ? (close - pivRef) / pivRef * 100 : na
int   barsSBO = not na(boBar) ? bar_index - boBar : na

// ═════════════════════════════════════════════════════════════════════════════
//  FILTER EVALUATION
// ═════════════════════════════════════════════════════════════════════════════

// ── Determine active pattern (priority order) ─────────────────────────────────

if inBase
    // Priority order for active pattern inside base:
    // HTF > Cup+Handle > Dbl Bottom > Cup > 6-Wk Flat > Flat Base > Base
    if isHTF and i_htf
        pOn   := true
        pName := 'HTF'
        pCode := 6
    else if isCupH and i_cupHandle
        pOn   := true
        pName := 'Cup+Handle'
        pCode := 4
    else if isDB and i_db
        pOn   := true
        pName := 'Dbl Bottom'
        pCode := 5
    else if isCup and i_cup
        pOn   := true
        pName := 'Cup'
        pCode := 3
    else if is6WkFlat and i_6wkFlat
        pOn   := true
        pName := '6-Wk Flat'
        pCode := 7
    else if isFlatBase and i_flatBase
        pOn   := true
        pName := 'Flat Base'
        pCode := 2
    else if isDeepBase and i_deepBase
        pOn   := true
        pName := 'Base'
        pCode := 1
else
    // Post-breakout: use the saved breakout pattern details
    if not na(barsSBO) and barsSBO <= i_bsoMax
        pCode := boPatternCode
        pName := boPatternName
        // Check if this pattern is enabled by user inputs
        if pCode == 6 and i_htf
            pOn := true
        else if pCode == 4 and i_cupHandle
            pOn := true
        else if pCode == 5 and i_db
            pOn := true
        else if pCode == 3 and i_cup
            pOn := true
        else if pCode == 7 and i_6wkFlat
            pOn := true
        else if pCode == 2 and i_flatBase
            pOn := true
        else if pCode == 1 and i_deepBase
            pOn := true

// ── Apply filters ─────────────────────────────────────────────────────────────
bool distOk   = not na(distPctInternal) and distPctInternal >= i_distMin and distPctInternal <= i_distMax
bool inBaseOk = inBase  and i_includeInBase
bool postBOOk = not inBase and i_includePostBO and not na(barsSBO) and barsSBO <= i_bsoMax
bool modeOk   = inBaseOk or postBOOk

bool signal   = pOn and distOk and modeOk

// ═════════════════════════════════════════════════════════════════════════════
//  RS NEW HIGH COUNT  ── ← NEW
//  rsWindow  – true while the stock is forming a base OR within the
//              post-breakout window (same span as i_bsoMax).
//  rsCount   – cumulative bars where rsNH_any fires inside rsWindow.
//              Resets (to 1 if RS is also a NH that day, else 0) on newBase.
//  The count is independent of the distance/mode filters so that it captures
//  every RS-NH day across the full consolidation, not just filtered bars.
// ═════════════════════════════════════════════════════════════════════════════
var int rsCount = 0
bool rsWindow   = inBase
              or (not inBase and not na(boBar)
                  and not na(barsSBO) and barsSBO <= i_bsoMax)

if newBase
    // Reset; credit the RS NH if one fires on the very first bar of a new base
    rsCount := rsNH_any ? 1 : 0
else if rsWindow and rsNH_any
    rsCount := rsCount + 1

// ═════════════════════════════════════════════════════════════════════════════
//  POCKET PIVOT & VOLUME DRY UP (VDU) CALCULATIONS
// ═════════════════════════════════════════════════════════════════════════════
// Average volume calculation
float avgVolPP = ta.sma(volume, i_vduLength)

// Volume dry up definition (Level 1 from drw_volume.pine)
float volRatioPct = not na(avgVolPP) and avgVolPP > 0 ? (volume / avgVolPP * 100) : na
bool volDryUp1 = not na(volRatioPct) and volRatioPct < (100 - i_dryUpReq)

// Track if in dry up (current bar is volume dry up or dry up occurred within last 5 bars)
int barsSinceVDU = ta.barssince(volDryUp1)
bool inDryUp = volDryUp1 or (not na(barsSinceVDU) and barsSinceVDU <= 5)

// Pocket Pivot calculations (10-day and 5-day down day volume comparison)
vols10 = array.new<float>()
vols5  = array.new<float>()

for i = 1 to 10
    if not na(close[i]) and not na(close[i+1]) and close[i] < close[i+1]
        array.push(vols10, volume[i])
float maxDnVol10 = array.size(vols10) > 0 ? array.max(vols10) : na

for i = 1 to 5
    if not na(close[i]) and not na(close[i+1]) and close[i] < close[i+1]
        array.push(vols5, volume[i])
float maxDnVol5 = array.size(vols5) > 0 ? array.max(vols5) : na

bool pp10 = close > close[1] and not na(maxDnVol10) and volume > maxDnVol10
bool pp5  = close > close[1] and not na(maxDnVol5) and volume > maxDnVol5
bool ppAny = pp10 or pp5

// PP5 or PP10 while in dry up (even if current bar itself is a dry bar)
bool dryUpPP = inDryUp and ppAny

// ── Condition 1: Within 10% to pivot, VDU or PP (Must be before breakout) ────
bool nearPivot10 = inBase and not na(distPctInternal) and math.abs(distPctInternal) <= 10.0
bool condNearPivotVDUorPP = nearPivot10 and (volDryUp1 or ppAny)


// ── Condition 2: Breakout Pocket Pivot ───────────────────────────────────────
bool boPP = not na(barsSBO) and barsSBO == 0 and ppAny

var bool boWasPP = false
if newBase or inBase
    boWasPP := false
else if not na(barsSBO) and barsSBO == 0
    boWasPP := ppAny

// ── Condition 3: Within 10 days after breakout, VDU ──────────────────────────
bool postBODryUp = not inBase and not na(barsSBO) and barsSBO >= 1 and barsSBO <= 10 and volDryUp1

var bool hasDriedUpPostBO = false
if newBase or inBase or (not na(barsSBO) and barsSBO == 0)
    hasDriedUpPostBO := false
else if not inBase and not na(barsSBO) and barsSBO >= 1 and barsSBO <= 10 and volDryUp1
    hasDriedUpPostBO := true

// ═════════════════════════════════════════════════════════════════════════════
//  BREAKOUT MA TOUCH SCANNER
// ═════════════════════════════════════════════════════════════════════════════
// Calculate moving averages
float ma1 = i_maType1 == 'EMA' ? ta.ema(close, i_maLength1) : ta.sma(close, i_maLength1)
float ma2 = i_maType2 == 'EMA' ? ta.ema(close, i_maLength2) : ta.sma(close, i_maLength2)
float ma3 = i_maType3 == 'EMA' ? ta.ema(close, i_maLength3) : ta.sma(close, i_maLength3)

// Helper function to check if price touches or is near a moving average within tolerance
f_touchesMA(maVal, threshPct) =>
    if na(maVal) or maVal <= 0
        false
    else
        float upperLimit = maVal * (1.0 + threshPct / 100.0)
        float lowerLimit = maVal * (1.0 - threshPct / 100.0)
        // Price touches if the bar's high-low range intersects the MA range
        low <= upperLimit and high >= lowerLimit

bool touchMA1 = f_touchesMA(ma1, i_touchThresh)
bool touchMA2 = f_touchesMA(ma2, i_touchThresh)
bool touchMA3 = f_touchesMA(ma3, i_touchThresh)
bool touchedMA = touchMA1 or touchMA2 or touchMA3

// Check if we are within the specified post-breakout window (e.g. 1 to 10 days)
bool inTouchWindow = not inBase and not na(barsSBO) and barsSBO >= 1 and barsSBO <= i_boTouchDays

// 1. Current bar touch signal (true only on the bar that touches within the window)
bool touchSignal = inTouchWindow and touchedMA

// 2. Persistent touch flag (tracks if any touch has occurred since the breakout, within the window)
var bool hasTouchedPostBO = false

if newBase or inBase or (not na(barsSBO) and barsSBO == 0)
    hasTouchedPostBO := false
else if inTouchWindow and touchedMA
    hasTouchedPostBO := true

// ═════════════════════════════════════════════════════════════════════════════
//  SHAKEOUT DETECTION  ── ← NEW (ported from the "shakeout" 3-EMA indicator)
//  Undercut of the last swing low (only while in an uptrend, close > trend
//  EMA) → reclaim close > 3 EMA within 3 bars → entry when high clears the
//  reclaim bar's high. shakeoutEntry fires once, on the entry bar.
// ═════════════════════════════════════════════════════════════════════════════
float shakeEma3     = ta.ema(close, 3)
float shakeTrendEMA = ta.ema(close, i_shakeTrendLen)
bool  shakeUptrend  = close > shakeTrendEMA

float shakeSwingLow = ta.pivotlow(low, i_shakeLR, i_shakeLR)

var float shakeLastSwingLow = na
if not na(shakeSwingLow)
    shakeLastSwingLow := shakeSwingLow

var int   shakeUndercutBar = na
var int   shakeReclaimBar  = na
var float shakeReclaimHigh = na
var bool  shakeSetupActive = false

bool shakeUndercut = i_shakeOn and not na(shakeLastSwingLow) and low < shakeLastSwingLow and shakeUptrend

if shakeUndercut and not shakeSetupActive
    shakeUndercutBar := bar_index
    shakeSetupActive := true
    shakeReclaimBar  := na
    shakeReclaimHigh := na

bool shakeValidWindow   = shakeSetupActive and bar_index > shakeUndercutBar and bar_index - shakeUndercutBar <= 3
bool shakeReclaimSignal = shakeValidWindow and close > shakeEma3 and na(shakeReclaimBar) and shakeUptrend

if shakeReclaimSignal
    shakeReclaimBar  := bar_index
    shakeReclaimHigh := high

bool shakeoutEntry = i_shakeOn and shakeSetupActive and not na(shakeReclaimBar) and
     bar_index > shakeReclaimBar and high > shakeReclaimHigh and shakeUptrend

if shakeoutEntry or (shakeSetupActive and bar_index - shakeUndercutBar > 3)
    shakeSetupActive := false
    shakeUndercutBar := na
    shakeReclaimBar  := na
    shakeReclaimHigh := na

// Optional on-chart marker, mirrors the original shakeout script's "3S" label
plotshape(i_shakeShow and shakeReclaimSignal, style = shape.cross, location = location.belowbar,
          text = '3S', color = color.lime, textcolor = color.black, size = size.small,
          title = 'Shakeout Reclaim Marker')

// ═════════════════════════════════════════════════════════════════════════════
//  UPSIDE REVERSAL DETECTION  ── ← NEW
//  Bar must be wider than 14D ATR and close in the upper 50% of its range.
//  Used as a +1 pt component in both Before-BO and Post-BO scores.
// ═════════════════════════════════════════════════════════════════════════════
float atr14 = ta.atr(14)
bool  upsideReversal = (high - low) > atr14 and close > (high + low) / 2

// ═══════════════════════════════════════════════════════════════════════════════
//  RATINGS CALCULATIONS  (RS Rating, EPS, A/D, SMR, Composite, etc.)
//  Ported from drw_earnings_ratings_table.pine
// ═══════════════════════════════════════════════════════════════════════════════

// ── RS Rating (0-99) ──────────────────────────────────────────────────────────
closeDa    = request.security(syminfo.tickerid, "D", close)
spxCloseDa = request.security(i_rsIdx, "D", close)

n63  = bar_index < 63  ? bar_index : 63
n126 = bar_index < 126 ? bar_index : 126
n189 = bar_index < 189 ? bar_index : 189
n252 = bar_index < 252 ? bar_index : 252

perfTicker63  = closeDa / closeDa[n63]
perfTicker126 = closeDa / closeDa[n126]
perfTicker189 = closeDa / closeDa[n189]
perfTicker252 = closeDa / closeDa[n252]

perfComp63  = spxCloseDa / spxCloseDa[n63]
perfComp126 = spxCloseDa / spxCloseDa[n126]
perfComp189 = spxCloseDa / spxCloseDa[n189]
perfComp252 = spxCloseDa / spxCloseDa[n252]

float rs_stock = 0.4 * perfTicker63 + 0.2 * perfTicker126 + 0.2 * perfTicker189 + 0.2 * perfTicker252
float rs_ref   = 0.4 * perfComp63   + 0.2 * perfComp126   + 0.2 * perfComp189   + 0.2 * perfComp252
float totalRsScore = rs_stock / rs_ref * 100

curveRsPerf = request.seed("seed_fred6725_rs_rating", "RSRATING", close)

var array<float> diffVals = array.new_float(7)
var int counter = 0
float first = 0.0, scnd = 0.0, thrd = 0.0, frth = 0.0, ffth = 0.0, sxth = 0.0, svth = 0.0

delta = ta.barssince(na(curveRsPerf) != true)

if not na(curveRsPerf)
    for i = delta to 34 + delta by 1
        cv = nz(curveRsPerf[i])
        if not array.includes(diffVals, cv) and counter < 7 and cv != 0
            array.set(diffVals, counter, cv)
            counter += 1
    first := array.get(diffVals, 0)
    scnd  := array.get(diffVals, 1)
    thrd  := array.get(diffVals, 2)
    frth  := array.get(diffVals, 3)
    ffth  := array.get(diffVals, 4)
    sxth  := array.get(diffVals, 5)
    svth  := array.get(diffVals, 6)

f_pct(_score, tallerPerf, smallerPerf, rangeUp, rangeDn, weight) =>
    sum = _score + (_score - smallerPerf) * weight
    if sum > tallerPerf - 1
        sum := tallerPerf - 1
    k1 = smallerPerf / rangeDn
    k2 = (tallerPerf - 1) / rangeUp
    k3 = (k1 - k2) / (tallerPerf - 1 - smallerPerf)
    r = sum / (k1 - k3 * (_score - smallerPerf))
    if r > rangeUp
        r := rangeUp
    if r < rangeDn
        r := rangeDn
    r

bool isRatingValid = true
for i = 0 to 6 by 1
    if nz(array.get(diffVals, i)) == 0
        isRatingValid := false

f_calculateRating(score, f, s, t, fr, ff, sx, sv) =>
    float rating = -1.0
    if score >= f
        rating := 99
    else if score <= sv
        rating := 1
    else if score < f and score >= s
        rating := f_pct(score, f, s, 98, 90, 0.33)
    else if score < s and score >= t
        rating := f_pct(score, s, t, 89, 70, 2.1)
    else if score < t and score >= fr
        rating := f_pct(score, t, fr, 69, 50, 0)
    else if score < fr and score >= ff
        rating := f_pct(score, fr, ff, 49, 30, 0)
    else if score < ff and score >= sx
        rating := f_pct(score, ff, sx, 29, 10, 0)
    else if score < sx and score >= sv
        rating := f_pct(score, sx, sv, 9, 2, 0)
    rating

f_scoreToRating(score, f, s, t, fr, ff, sx, sv, isValid) =>
    float rating = 50.0
    if isValid and f > 0
        rating := f_calculateRating(score, f, s, t, fr, ff, sx, sv)
    else
        diff = score - 100.0
        rating := 50.0 + 49.0 * (diff / (math.abs(diff) + 22.0))
    math.max(1.0, math.min(99.0, rating))

totalRsRating = f_scoreToRating(totalRsScore, first, scnd, thrd, frth, ffth, sxth, svth, isRatingValid)
rsRatingFinal = timeframe.isdaily ? totalRsRating : f_scoreToRating(totalRsScore, first, scnd, thrd, frth, ffth, sxth, svth, false)

// ── 3-Month / 6-Month RS Ratings ──────────────────────────────────────────────
rsScore3m = perfTicker63  / perfComp63  * 100
rsScore6m = perfTicker126 / perfComp126 * 100

rsRating3m = timeframe.isdaily ? f_scoreToRating(rsScore3m, first, scnd, thrd, frth, ffth, sxth, svth, isRatingValid) : f_scoreToRating(rsScore3m, first, scnd, thrd, frth, ffth, sxth, svth, false)
rsRating6m = timeframe.isdaily ? f_scoreToRating(rsScore6m, first, scnd, thrd, frth, ffth, sxth, svth, isRatingValid) : f_scoreToRating(rsScore6m, first, scnd, thrd, frth, ffth, sxth, svth, false)

// ── Group (Sector) RS Rating ───────────────────────────────────────────────────
get_sector_etf(sectorIn) =>
    string etf = switch sectorIn
        "Technology Services"    => "XLK"
        "Electronic Technology"  => "XLK"
        "Finance"                => "XLF"
        "Health Technology"      => "XLV"
        "Health Services"        => "XLV"
        "Retail Trade"           => "XLP"
        "Consumer Non-Durables"  => "XLP"
        "Energy Minerals"        => "XLE"
        "Producer Manufacturing" => "XLI"
        "Consumer Services"      => "XLY"
        "Consumer Durables"      => "XLY"
        "Commercial Services"    => "XLI"
        "Industrial Services"    => "XLI"
        "Utilities"              => "XLU"
        "Transportation"         => "XLI"
        "Non-Energy Minerals"    => "XLB"
        "Process Industries"     => "XLB"
        "Communications"         => "XLC"
        "Distribution Services"  => "XLI"
        "Miscellaneous"          => "SPY"
        => "SPY"
    etf

string sectorName = syminfo.sector
if na(sectorName)
    sectorName := "N/A"
sectorEtf = get_sector_etf(sectorName)

closeSectorDa = request.security(sectorEtf, "D", close)

perfSector63  = closeSectorDa / closeSectorDa[n63]
perfSector126 = closeSectorDa / closeSectorDa[n126]
perfSector189 = closeSectorDa / closeSectorDa[n189]
perfSector252 = closeSectorDa / closeSectorDa[n252]

float rs_sector = 0.4 * perfSector63 + 0.2 * perfSector126 + 0.2 * perfSector189 + 0.2 * perfSector252
float totalRsScoreGroup = rs_sector / rs_ref * 100

groupRatingRaw = f_scoreToRating(totalRsScoreGroup, first, scnd, thrd, frth, ffth, sxth, svth, isRatingValid)
groupRsRating = timeframe.isdaily ? groupRatingRaw : f_scoreToRating(totalRsScoreGroup, first, scnd, thrd, frth, ffth, sxth, svth, false)

// ── % Off 52W High ────────────────────────────────────────────────────────────
highDa  = request.security(syminfo.tickerid, "D", high)
high52w = ta.highest(highDa, n252 + 1)
pctOff52wHigh = high52w > 0 ? (high52w - closeDa) / high52w * 100 : 0.0

// ── EPS Rating (0-99) ─────────────────────────────────────────────────────────
isStock = syminfo.type == "stock" or syminfo.type == "dr"

var int MAX_ANNUAL = 5
var array<float> fyEPS  = array.new_float()
var array<float> fyRev  = array.new_float()
var array<int>   fyYear = array.new_int()

epsFY = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "FY")
revFY = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY")

fyEpsChanged = ta.change(epsFY) != 0
fyRevChanged = ta.change(revFY) != 0
fyChg = fyEpsChanged or fyRevChanged
if isStock and fyChg and barstate.isconfirmed
    array.unshift(fyEPS,  epsFY)
    array.unshift(fyRev,  revFY)
    array.unshift(fyYear, year(time))
    if array.size(fyEPS) > MAX_ANNUAL + 1
        array.pop(fyEPS)
        array.pop(fyRev)
        array.pop(fyYear)

var int MAX_QTR = 6
var array<float> fqEPS  = array.new_float()
var array<float> fqRev  = array.new_float()
var array<int>   fqYear = array.new_int()
var array<int>   fqQtr  = array.new_int()

epsFQ = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "FQ")
revFQ = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ")

fqEpsChanged = ta.change(epsFQ) != 0
fqRevChanged = ta.change(revFQ) != 0
fqChg = fqEpsChanged or fqRevChanged
if isStock and fqChg and barstate.isconfirmed
    array.unshift(fqEPS,  epsFQ)
    array.unshift(fqRev,  revFQ)
    array.unshift(fqYear, year(time))
    array.unshift(fqQtr,  math.ceil(month(time) / 3.0))
    if array.size(fqEPS) > MAX_QTR + 4
        array.pop(fqEPS)
        array.pop(fqRev)
        array.pop(fqYear)
        array.pop(fqQtr)

salesGrowthFQ  = request.financial(syminfo.tickerid, "REVENUE_ONE_YEAR_GROWTH", "FQ", ignore_invalid_symbol=true)
netMarginFQ    = request.financial(syminfo.tickerid, "NET_MARGIN", "FQ", ignore_invalid_symbol=true)
grossMarginFQ  = request.financial(syminfo.tickerid, "GROSS_MARGIN", "FQ", ignore_invalid_symbol=true)
roeFQ          = request.financial(syminfo.tickerid, "RETURN_ON_EQUITY", "FQ", ignore_invalid_symbol=true)

nFQ = array.size(fqEPS)
q0G = nFQ > 4 ? (array.get(fqEPS, 0) - array.get(fqEPS, 4)) / math.abs(array.get(fqEPS, 4)) * 100 : float(na)
q1G = nFQ > 5 ? (array.get(fqEPS, 1) - array.get(fqEPS, 5)) / math.abs(array.get(fqEPS, 5)) * 100 : float(na)
stGrowth = na(q0G) ? float(na) : na(q1G) ? q0G : (q0G * 0.65 + q1G * 0.35)

nFY = array.size(fyEPS)
var float sumAnnualG = 0.0
var float sumAnnualW = 0.0
sumAnnualG := 0.0
sumAnnualW := 0.0
for i = 0 to 4
    if nFY > i + 1
        gv = (array.get(fyEPS, i) - array.get(fyEPS, i+1)) / math.abs(array.get(fyEPS, i+1)) * 100
        w  = 5 - i
        sumAnnualG += gv * w
        sumAnnualW += w
ltGrowth = sumAnnualW > 0 ? sumAnnualG / sumAnnualW : float(na)

epsAccel = not na(q0G) and not na(q1G) ? (q0G - q1G) : 0.0

blendedGrowth = na(stGrowth) and na(ltGrowth) ? 0.0 : na(stGrowth) ? ltGrowth : na(ltGrowth) ? stGrowth : (stGrowth * 0.50 + ltGrowth * 0.35 + epsAccel * 0.15)

rawEpsBase = 50 + 49 * (blendedGrowth / (math.abs(blendedGrowth) + 40))

var float sumNegQ = 0.0
var int   cntQ    = 0
sumNegQ := 0.0
cntQ := 0
for i = 0 to 3
    if nFQ > i + 4
        gv = (array.get(fqEPS, i) - array.get(fqEPS, i+4)) / math.abs(array.get(fqEPS, i+4)) * 100
        cntQ += 1
        if gv < 0
            sumNegQ += 1
negRatio = cntQ > 0 ? sumNegQ / cntQ : 0.0

roePen = not na(roeFQ) and roeFQ < 0 ? math.min(22.0, math.abs(roeFQ) * 0.05 + 5.0) : 0.0
ltNegPen = not na(ltGrowth) and ltGrowth < 0 ? math.min(15.0, math.abs(ltGrowth) * 0.4) : 0.0

epsRatingRaw = rawEpsBase - roePen - ltNegPen - (negRatio * 10.0)
epsRating = math.max(1, math.min(99, math.round(epsRatingRaw)))

// ── A/D Rating (0-99) ─────────────────────────────────────────────────────────
mfMultiplier = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
mfVolume     = mfMultiplier * volume
sumMFVol     = math.sum(mfVolume, i_adLookback)
sumVolAD     = math.sum(volume, i_adLookback)
adRatio  = sumVolAD != 0 ? sumMFVol / sumVolAD : 0.0
adRating = math.max(0, math.min(99, 49.5 + adRatio * 49.5))

// ── SMR Rating (0-99 & Letter Grade) ─────────────────────────────────────────
var float latestRevG = float(na)
if array.size(fqRev) > 4
    latestRevG := (array.get(fqRev, 0) - array.get(fqRev, 4)) / math.abs(array.get(fqRev, 4)) * 100

sgVal = not na(salesGrowthFQ) ? salesGrowthFQ : not na(latestRevG) ? latestRevG : 0.0
salesGScore = math.max(0, math.min(99, 50 + 49 * (sgVal / (math.abs(sgVal) + 25))))

marginVal = not na(netMarginFQ) ? netMarginFQ : not na(grossMarginFQ) ? grossMarginFQ * 0.5 : 10.0
marginScore = math.max(0, math.min(99, 50 + 49 * (marginVal / (math.abs(marginVal) + 15))))

roeVal = not na(roeFQ) ? roeFQ : 15.0
roeScore = math.max(0, math.min(99, 50 + 49 * (roeVal / (math.abs(roeVal) + 17))))

smrScore = math.max(0, math.min(99, (marginScore * 0.3557 + salesGScore * 0.3481 + roeScore * 0.2962)))
smrGrade = smrScore >= 80 ? "A" : smrScore >= 65 ? "B" : smrScore >= 50 ? "C" : smrScore >= 35 ? "D" : "E"

// ── Composite Rating (0-99) ──────────────────────────────────────────────────
rsForComp = rsRatingFinal == -1 ? 0.0 : rsRatingFinal
adNum     = 1.0 + (adRating / 99.0) * 12.0
compRaw   = -15.94 + (0.5794 * rsForComp) + (0.3766 * epsRating) + (0.2166 * smrScore) + (1.4080 * adNum)
compRating = math.max(1, math.min(99, math.round(compRaw)))

// ═════════════════════════════════════════════════════════════════════════════
//  TWO-PART SCORE SYSTEM  ── ← NEW (now includes RS + UpRev components)
//  Before-BO Score (0-6): accumulates while price is inside the base AND
//    within i_preBOPivotPct % of the base pivot. Freezes once breakout occurs
//    (only resets when the next new base begins).
//      +1 Pocket Pivot   +1 Shakeout   +1 MA Touch   +1 Volume Dry-Up   +1 RS New High   +1 Upside Reversal
//  Post-BO Score (0-6): accumulates for i_postBOBars bars starting at the
//    breakout bar itself (barsSBO from 0 to i_postBOBars). Resets on every
//    bar while still in a base, and whenever a new base starts.
//      +1 Pocket Pivot (at or after BO)   +1 Shakeout   +1 MA Touch   +1 VDU   +1 RS New High   +1 Upside Reversal
//  Composite Score (0-12): sum of Before-BO and Post-BO scores.
// ═════════════════════════════════════════════════════════════════════════════
bool nearPivotScore = inBase and not na(distPctInternal) and math.abs(distPctInternal) <= i_preBOPivotPct

var bool scorePP_pre    = false
var bool scoreShake_pre = false
var bool scoreTouch_pre = false
var bool scoreVDU_pre   = false
var bool scoreRS_pre    = false   // NEW
var bool scoreUpRev_pre = false   // NEW: upside reversal

if newBase
    scorePP_pre    := false
    scoreShake_pre := false
    scoreTouch_pre := false
    scoreVDU_pre   := false
    scoreRS_pre    := false
    scoreUpRev_pre := false
else if nearPivotScore
    if ppAny
        scorePP_pre := true
    if shakeoutEntry
        scoreShake_pre := true
    if touchedMA
        scoreTouch_pre := true
    if volDryUp1
        scoreVDU_pre := true
    if rsNH_any
        scoreRS_pre := true   // RS new high while in the pre‑BO window
    if upsideReversal
        scoreUpRev_pre := true

int beforeBOScore = (scorePP_pre ? 1 : 0) + (scoreShake_pre ? 1 : 0) +
                     (scoreTouch_pre ? 1 : 0) + (scoreVDU_pre ? 1 : 0) + (scoreRS_pre ? 1 : 0) +
                     (scoreUpRev_pre ? 1 : 0)

bool postBOWindowScore = not inBase and not na(barsSBO) and barsSBO <= i_postBOBars

var bool scorePP_post    = false
var bool scoreShake_post = false
var bool scoreTouch_post = false
var bool scoreVDU_post   = false
var bool scoreRS_post    = false   // NEW
var bool scoreUpRev_post = false   // NEW: upside reversal

if newBase or inBase
    scorePP_post    := false
    scoreShake_post := false
    scoreTouch_post := false
    scoreVDU_post   := false
    scoreRS_post    := false
    scoreUpRev_post := false
else if postBOWindowScore
    if ppAny
        scorePP_post := true
    if shakeoutEntry
        scoreShake_post := true
    if touchedMA
        scoreTouch_post := true
    if volDryUp1
        scoreVDU_post := true
    if rsNH_any
        scoreRS_post := true   // RS new high while in the post‑BO window
    if upsideReversal
        scoreUpRev_post := true

int postBOScore = (scorePP_post ? 1 : 0) + (scoreShake_post ? 1 : 0) +
                   (scoreTouch_post ? 1 : 0) + (scoreVDU_post ? 1 : 0) + (scoreRS_post ? 1 : 0) +
                   (scoreUpRev_post ? 1 : 0)

// Composite score (NEW)
int compositeScore = beforeBOScore + postBOScore

// ═════════════════════════════════════════════════════════════════════════════
//  PLOT OUTPUTS  — visible in the Data Window and usable in TradingView Screener
// ═════════════════════════════════════════════════════════════════════════════
plot(signal      ? 1 : 0, title = 'Signal (0/1)',               display = display.all)
plot(distPct,             title = 'Distance to Pivot %',         display = display.all)
plot(barsSBO,             title = 'Bars Since Breakout',         display = display.all)
plot(inBase ? bCount : na, title = 'Days in Base',                display = display.all)
plot(rsCount,           title = 'RS NH Count',                    display = display.all)
plot(rsNH_1y  ? 1 : 0, title = 'RS New High (1Y)',              display = display.all)
plot(rsNH_6m  ? 1 : 0, title = 'RS New High (6M)',              display = display.all)
plot(rsNH_3m  ? 1 : 0, title = 'RS New High (3M)',              display = display.all)
plot(rsNH_any ? 1 : 0, title = 'RS New High (Any)',             display = display.all)
plot((isFlatBase or pCode == 2) ? 1 : 0, title = 'Is Flat Base (0/1)',         display = display.all)
plot((isDeepBase or pCode == 1) ? 1 : 0, title = 'Is Base-Deep (0/1)',         display = display.all)
plot((isCup      or pCode == 3) ? 1 : 0, title = 'Is Cup (0/1)',               display = display.all)
plot((isCupH     or pCode == 4) ? 1 : 0, title = 'Is Cup+Handle (0/1)',        display = display.all)
plot((isDB       or pCode == 5) ? 1 : 0, title = 'Is Double Bottom (0/1)',     display = display.all)
plot((isHTF      or pCode == 6) ? 1 : 0, title = 'Is High Tight Flag (0/1)',   display = display.all)
plot((is6WkFlat  or pCode == 7) ? 1 : 0, title = 'Is 6-Wk Flat Base (0/1)',   display = display.all)

plot(pCode,               title = 'Pattern Code',                display = display.all)
plot(touchSignal ? 1 : 0,      title = 'Touch MA Post-BO (0/1)',     display = display.all)
plot(hasTouchedPostBO and not na(barsSBO) and barsSBO <= i_boTouchDays ? 1 : 0,  title = 'Has Touched MA Post-BO (0/1)', display = display.all)
plot(condNearPivotVDUorPP ? 1 : 0, title = 'Near Pivot VDU or PP (0/1)',      display = display.all)

plot(boPP ? 1 : 0,                 title = 'Breakout Pocket Pivot (0/1)',     display = display.all)
plot(boWasPP ? 1 : 0,              title = 'Breakout Was Pocket Pivot (0/1)', display = display.all)
plot(postBODryUp ? 1 : 0,          title = 'Post-BO VDU (0/1)',               display = display.all)
plot(hasDriedUpPostBO and not na(barsSBO) and barsSBO <= 10 ? 1 : 0,      title = 'Has VDU Post-BO (0/1)',           display = display.all)
plot(dryUpPP ? 1 : 0,              title = 'In Dry Up with PP5/PP10 (0/1)',   display = display.all)

// ── Two-Part Score System plots  ── ← NEW (now includes RS component) ───────
plot(shakeoutEntry ? 1 : 0,        title = 'Shakeout Entry (0/1)',            display = display.all)

plot(scorePP_pre    ? 1 : 0, title = 'Score: PP (Before-BO)',        display = display.all)
plot(scoreShake_pre ? 1 : 0, title = 'Score: Shakeout (Before-BO)',  display = display.all)
plot(scoreTouch_pre ? 1 : 0, title = 'Score: MA Touch (Before-BO)',  display = display.all)
plot(scoreVDU_pre   ? 1 : 0, title = 'Score: Vol Dry-Up (Before-BO)', display = display.all)
plot(scoreRS_pre    ? 1 : 0, title = 'Score: RS NH (Before-BO)',     display = display.all)  // NEW
plot(scoreUpRev_pre ? 1 : 0, title = 'Score: Up Rev (Before-BO)',    display = display.all)  // NEW
plot(beforeBOScore,          title = 'Before-BO Score (0-6)',        display = display.all)

plot(scorePP_post    ? 1 : 0, title = 'Score: PP (Post-BO)',          display = display.all)
plot(scoreShake_post ? 1 : 0, title = 'Score: Shakeout (Post-BO)',    display = display.all)
plot(scoreTouch_post ? 1 : 0, title = 'Score: MA Touch (Post-BO)',    display = display.all)
plot(scoreVDU_post   ? 1 : 0, title = 'Score: Vol Dry-Up (Post-BO)',  display = display.all)
plot(scoreRS_post    ? 1 : 0, title = 'Score: RS NH (Post-BO)',       display = display.all)  // NEW
plot(scoreUpRev_post ? 1 : 0, title = 'Score: Up Rev (Post-BO)',      display = display.all)  // NEW
plot(postBOScore,             title = 'Post-BO Score (0-6)',          display = display.all)

// Composite Score (NEW)
plot(compositeScore,          title = 'Composite Score (0-12)',       display = display.all)

// ── Ratings plots ─────────────────────────────────────────────────────────────
plot(math.round(rsRatingFinal), title='RS Rating', display=display.all)
plot(math.round(epsRating), title='EPS Rating', display=display.all)
plot(math.round(adRating), title='A/D Rating', display=display.all)
plot(math.round(smrScore), title='SMR Score', display=display.all)
plot(math.round(compRating), title='Composite Rating', display=display.all)
plot(math.round(groupRsRating), title='Group RS Rating', display=display.all)
plot(math.round(rsRating3m), title='3M RS Rating', display=display.all)
plot(math.round(rsRating6m), title='6M RS Rating', display=display.all)
plot(pctOff52wHigh, title='% Off 52W High', display=display.all)

// ═════════════════════════════════════════════════════════════════════════════
//  VISUAL OUTPUT
// ═════════════════════════════════════════════════════════════════════════════

// Background highlight on signal bars
bgcolor(i_showBg and signal ? color.new(color.yellow, 85) : na, title = 'Signal Highlight')

// Label pinned to the last bar when a match is active
if i_showLabel and signal and barstate.islast
    string lt = pName
    lt := lt + '\nDist:  '  + (na(distPct) ? 'N/A' : str.tostring(distPct, '#.##') + '%')
    lt := lt + '\nDepth: '  + (na(bDepPct) ? 'N/A' : str.tostring(bDepPct, '#.##') + '%')
    lt := lt + '\nPivot: '  + (na(pivRef)  ? 'N/A' : str.tostring(pivRef,  format.mintick))
    lt := lt + '\n'         + (inBase ? 'In Base' : 'BO + ' + str.tostring(barsSBO) + ' bars')
    // 6-wk flat: show bar count vs window
    if is6WkFlat
        lt := lt + '\nBars:  ' + str.tostring(bCount) + '/' + str.tostring(i_6wkMin) + '–' + str.tostring(i_6wkMax)
    // RS New High count  ── ← NEW ────────────────────────────────────────────
    lt := lt + '\nRS NH: ' + str.tostring(rsCount) + (rsNH_any ? '  [✦ ' + rsNH_per + ']' : '')
    if not inBase
        lt := lt + '\nMA Touch: ' + (hasTouchedPostBO and not na(barsSBO) and barsSBO <= i_boTouchDays ? 'YES' : 'NO')
        lt := lt + '\nBO PP: ' + (boWasPP ? 'YES' : 'NO')
        lt := lt + '\nPost-BO VDU: ' + (hasDriedUpPostBO and not na(barsSBO) and barsSBO <= 10 ? 'YES' : 'NO')
    lt := lt + '\nNear Piv VDU/PP: ' + (condNearPivotVDUorPP ? 'YES' : 'NO')
    // Two-Part Score System  ── ← NEW (now includes RS) ──────────────────────
    lt := lt + '\nBefore-BO Score: ' + str.tostring(beforeBOScore) + '/6'
             + '  (PP:' + (scorePP_pre ? '1' : '0')
             + ' Shk:'  + (scoreShake_pre ? '1' : '0')
             + ' MA:'   + (scoreTouch_pre ? '1' : '0')
             + ' VDU:'  + (scoreVDU_pre ? '1' : '0')
             + ' RS:'   + (scoreRS_pre ? '1' : '0')
             + ' UR:'   + (scoreUpRev_pre ? '1' : '0') + ')'
    lt := lt + '\nPost-BO Score: '   + str.tostring(postBOScore)   + '/6'
             + '  (PP:' + (scorePP_post ? '1' : '0')
             + ' Shk:'  + (scoreShake_post ? '1' : '0')
             + ' MA:'   + (scoreTouch_post ? '1' : '0')
             + ' VDU:'  + (scoreVDU_post ? '1' : '0')
             + ' RS:'   + (scoreRS_post ? '1' : '0')
             + ' UR:'   + (scoreUpRev_post ? '1' : '0') + ')'
    lt := lt + '\nComposite: ' + str.tostring(compositeScore) + '/12'
    // ── Ratings block ──
    lt := lt + '\n── Ratings ──'
    lt := lt + '\nRS: '   + str.tostring(math.round(rsRatingFinal)) + ' | EPS: '  + str.tostring(math.round(epsRating))
    lt := lt + ' | AD: '  + str.tostring(math.round(adRating))
    lt := lt + '\nComp: ' + str.tostring(math.round(compRating)) + ' | SMR: ' + smrGrade + ' (' + str.tostring(math.round(smrScore)) + ')'
    lt := lt + '\nGpRS: ' + str.tostring(math.round(groupRsRating)) + ' | 3M: ' + str.tostring(math.round(rsRating3m)) + ' | 6M: ' + str.tostring(math.round(rsRating6m))
    lt := lt + '\n%Off52: ' + str.tostring(pctOff52wHigh, '#.#') + '%'
    label.new(bar_index, high, lt,
              style = label.style_label_down,
              color = color.teal, textcolor = color.white, size = size.small)

// // ═════════════════════════════════════════════════════════════════════════════
