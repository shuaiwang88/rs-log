//     string depStr  = na(bDepPct) ? 'N/A' : str.tostring(bDepPct,  '#.##') + '%'
//     string boStr   = inBase ? 'In base' : na(barsSBO) ? 'N/A' : str.tostring(barsSBO) + ' bars ago'

//     f_cell(tbl, 0,  9, 'Dist to Pivot',  C_D)
//     f_cell(tbl, 1,  9, distStr,           na(distPct) ? C_D : (distOk ? C_G : C_R))
//     f_cell(tbl, 0, 10, 'Since BO',        C_D)
//     f_cell(tbl, 1, 10, boStr,             modeOk ? C_G : C_R)
