// ================================================================
// IBD MARKET SCHOOL — STATE MACHINE CORE
// Pine Script v6
//
// Architecture:
//   1. Market Data Engine
//   2. Volume Engine
//   3. Distribution / Stalling Engine
//   4. Rally Structure Engine
//   5. Buy / Sell Signal State Machine
//   6. Power Trend State Machine
//   7. Exposure Engine
//   8. Dashboard / Visuals
//
// IMPORTANT:
// This implementation is designed around STATE TRANSITIONS rather
// than treating B1-B10 / S1-S14 as independent Boolean conditions.
// ================================================================

//@version=6
indicator(
     title            = "IBD Market School — State Machine",
     shorttitle       = "IBD MS",
     overlay          = true,
     max_labels_count = 500,
     max_lines_count  = 500
)

// ================================================================
// CONSTANTS
// ================================================================

// Rally states
const int RALLY_NONE            = 0
const int RALLY_POTENTIAL_MAJOR = 1
const int RALLY_MAJOR           = 2
const int RALLY_POTENTIAL_MINOR = 3
const int RALLY_MINOR           = 4
const int RALLY_TRAILING        = 5

// Power Trend states
const int PT_OFF      = 0
const int PT_ON       = 1
const int PT_RESUME   = 2
const int PT_FLOOR    = 3
const int PT_NO_FLOOR = 4

// ================================================================
// SETTINGS
// ================================================================

grpGeneral = "General"

showSignals = input.bool(
     true,
     "Show Signal Labels",
     group = grpGeneral
)

showTable = input.bool(
     true,
     "Show Market Status",
     group = grpGeneral
)

showRallyLevels = input.bool(
     true,
     "Show Rally Levels",
     group = grpGeneral
)

grpRules = "IBD Rules"

fullDDCount = input.int(
     6,
     "Full Distribution Count",
     minval = 4,
     maxval = 10,
     group = grpRules
)

ddExpiration = input.int(
     25,
     "DD / SD Expiration Days",
     minval = 1,
     group = grpRules
)

ddRiseExpiration = input.float(
     6.0,
     "DD / SD Price Rise Expiration %",
     step = 0.1,
     group = grpRules
)

volatilityLookback = input.int(
     200,
     "IBD Volatility Lookback",
     minval = 50,
     group = grpRules
)

grpVolume = "Volume"

volumeMode = input.string(
     "Chart Volume",
     "Volume Source",
     options = [
         "Chart Volume",
         "Custom Volume",
         "Custom Close Proxy"
     ],
     group = grpVolume
)

customVolumeSymbol = input.symbol(
     "NASDAQ:IXIC",
     "Custom Volume Symbol",
     group = grpVolume
)

specialVolumeMode = input.string(
     "None",
     "Special Friday Volume Handling",
     options = [
         "None",
         "FTD Only",
         "All Volume Signals"
     ],
     group = grpVolume
)

grpVisual = "Moving Averages"

showEMA21 = input.bool(true, "21 EMA", group = grpVisual)
showSMA50 = input.bool(true, "50 SMA", group = grpVisual)
showSMA200 = input.bool(true, "200 SMA", group = grpVisual)

// ================================================================
// FUNCTIONS
// ================================================================

f_pct_change(float currentValue, float previousValue) =>
    previousValue != 0 ?
         (currentValue / previousValue - 1.0) * 100.0 :
         0.0


f_range_location() =>
    float barRange = high - low

    barRange > 0 ?
         (close - low) / barRange :
         0.5


f_power_state_name(int state) =>
    switch state
        PT_ON       => "ON"
        PT_RESUME   => "RESUME"
        PT_FLOOR    => "PRESSURE + FLOOR"
        PT_NO_FLOOR => "PRESSURE / NO FLOOR"
        => "OFF"


f_rally_state_name(int state) =>
    switch state
        RALLY_POTENTIAL_MAJOR => "R?"
        RALLY_MAJOR           => "R"
        RALLY_POTENTIAL_MINOR => "Rm?"
        RALLY_MINOR           => "Rm"
        RALLY_TRAILING        => "Rt"
        => "NONE"


f_exposure_text(int count) =>
    count <= 0 ? "0%" :
     count == 1 ? "30%" :
     count == 2 ? "55%" :
     count == 3 ? "75%" :
     count == 4 ? "90%" :
     "100%"


// ================================================================
// MARKET DATA ENGINE
// ================================================================

ema21 = ta.ema(close, 21)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

pctChange = f_pct_change(close, close[1])
rangeLocation = f_range_location()

upDay = close > close[1]
flatDay = close == close[1]
downDay = close < close[1]

upOrFlatDay = close >= close[1]

plot(
     showEMA21 ? ema21 : na,
     "21 EMA",
     color = color.green,
     linewidth = 2
)

plot(
     showSMA50 ? sma50 : na,
     "50 SMA",
     color = color.red,
     linewidth = 2
)

plot(
     showSMA200 ? sma200 : na,
     "200 SMA",
     color = color.gray,
     linewidth = 2
)


// ================================================================
// VOLUME ENGINE
// ================================================================

customVolume = request.security(
     customVolumeSymbol,
     timeframe.period,
     volume
)

customCloseProxy = request.security(
     customVolumeSymbol,
     timeframe.period,
     close
)

analysisVolume =
     volumeMode == "Custom Volume" ?
         customVolume :
     volumeMode == "Custom Close Proxy" ?
         customCloseProxy :
         volume

previousAnalysisVolume = analysisVolume[1]


// ------------------------------------------------
// Prior non-Friday volume average
// ------------------------------------------------

f_prior_non_friday_average() =>
    float volumeSum = 0.0
    int volumeCount = 0

    for offset = 2 to 8
        if dayofweek[offset] != dayofweek.friday
            volumeSum += analysisVolume[offset]
            volumeCount += 1

    volumeCount > 0 ?
         volumeSum / volumeCount :
         previousAnalysisVolume


priorNonFridayAverage = f_prior_non_friday_average()

previousDayWasFriday =
     dayofweek[1] == dayofweek.friday


f_volume_reference(bool isFTDSignal) =>
    bool useSpecial =
         specialVolumeMode == "All Volume Signals" or
         (
             specialVolumeMode == "FTD Only" and
             isFTDSignal
         )

    useSpecial and previousDayWasFriday ?
         priorNonFridayAverage :
         previousAnalysisVolume


ftdReferenceVolume = f_volume_reference(true)
generalReferenceVolume = f_volume_reference(false)

ftdVolumeUp =
     analysisVolume > ftdReferenceVolume

generalVolumeUp =
     analysisVolume > generalReferenceVolume

stallVolumeQualified =
     analysisVolume >= generalReferenceVolume * 0.95


// ================================================================
// IBD VOLATILITY ENGINE
// ================================================================

// Up-day percentage gain.
// Zero is excluded from the average.

upGainPct =
     close > close[1] ?
         f_pct_change(close, close[1]) :
         na

float volatilitySum = 0.0
int volatilityCount = 0

for offset = 0 to volatilityLookback - 1
    if not na(upGainPct[offset])
        volatilitySum += upGainPct[offset]
        volatilityCount += 1

ibdVolatility =
     volatilityCount > 0 ?
         volatilitySum / volatilityCount :
         0.0


ftdRequirement =
     ibdVolatility < 0.40 ? 0.70 :
     ibdVolatility < 0.55 ? 0.85 :
     ibdVolatility <= 1.00 ? 1.00 :
     1.245


// ================================================================
// DISTRIBUTION / STALLING ENGINE
// ================================================================

var float[] ddCloseArray = array.new_float()
var int[] ddBarArray = array.new_int()
var int[] ddTypeArray = array.new_int()

// Type
// 0 = Distribution
// 1 = Stalling
// 2 = Heavy Volume Without Price Progress

near13WeekHigh =
     high >= ta.highest(high, 65) * 0.97


isDistributionDay =
     pctChange <= -0.20 and
     generalVolumeUp


isStallingDay =
     near13WeekHigh and
     pctChange >= 0 and
     pctChange <= 0.40 and
     stallVolumeQualified and
     rangeLocation < 0.50


isHeavyVolumeNoProgress =
     near13WeekHigh and
     analysisVolume > generalReferenceVolume and
     pctChange > 0 and
     pctChange <= 0.20 and
     rangeLocation < 0.50


newDistributionEvent =
     isDistributionDay or
     isStallingDay or
     isHeavyVolumeNoProgress


if newDistributionEvent
    array.push(ddCloseArray, close)
    array.push(ddBarArray, bar_index)

    int eventType =
         isDistributionDay ? 0 :
         isStallingDay ? 1 :
         2

    array.push(ddTypeArray, eventType)


// ------------------------------------------------
// Expiration engine
// ------------------------------------------------

if array.size(ddBarArray) > 0

    int ddIndex = array.size(ddBarArray) - 1

    while ddIndex >= 0

        int eventBar =
             array.get(ddBarArray, ddIndex)

        float eventClose =
             array.get(ddCloseArray, ddIndex)

        int eventAge =
             bar_index - eventBar

        bool ageExpired =
             eventAge >= ddExpiration

        bool priceExpired =
             close >=
             eventClose *
             (
                 1.0 +
                 ddRiseExpiration / 100.0
             )

        if ageExpired or priceExpired

            array.remove(
                 ddBarArray,
                 ddIndex
            )

            array.remove(
                 ddCloseArray,
                 ddIndex
            )

            array.remove(
                 ddTypeArray,
                 ddIndex
            )

        ddIndex -= 1


distributionCount =
     array.size(ddBarArray)

previousDistributionCount =
     nz(distributionCount[1])


// ------------------------------------------------
// Distribution cluster
// ------------------------------------------------

int clusterCount = 0

if array.size(ddBarArray) > 0

    for arrayIndex = 0 to array.size(ddBarArray) - 1

        int distributionBar =
             array.get(
                 ddBarArray,
                 arrayIndex
             )

        if bar_index - distributionBar <= 7
            clusterCount += 1


distributionCluster =
     clusterCount >= 4

newDistributionCluster =
     distributionCluster and
     not distributionCluster[1]


// ================================================================
// RALLY STRUCTURE STATE MACHINE
// ================================================================

var int rallyState = RALLY_POTENTIAL_MAJOR

var float majorLow = na
var int majorLowBar = na

var float minorLow = na
var int minorLowBar = na

var float potentialMajorLow = na
var int potentialMajorLowBar = na

var float potentialMinorLow = na
var int potentialMinorLowBar = na

var float trailingLow = na
var int trailingLowBar = na

var int rallyDayBar = na
var float rallyDayLow = na

var bool rallyAttemptActive = false

var bool fullDistributionSeen = false


// ------------------------------------------------
// Full distribution event
// ------------------------------------------------

newFullDistribution =
     distributionCount >= fullDDCount and
     previousDistributionCount < fullDDCount


if newFullDistribution

    fullDistributionSeen := true

    // Existing confirmed major rally:
    // Begin potential minor rally search.

    if rallyState == RALLY_MAJOR or
       rallyState == RALLY_MINOR

        rallyState := RALLY_POTENTIAL_MINOR

        potentialMinorLow := low
        potentialMinorLowBar := bar_index

    else

        rallyState := RALLY_POTENTIAL_MAJOR

        potentialMajorLow := low
        potentialMajorLowBar := bar_index


// ------------------------------------------------
// Backward / forward low search framework
// ------------------------------------------------

if rallyState == RALLY_POTENTIAL_MAJOR

    if na(potentialMajorLow) or
       low < potentialMajorLow

        potentialMajorLow := low
        potentialMajorLowBar := bar_index


if rallyState == RALLY_POTENTIAL_MINOR

    if na(potentialMinorLow) or
       low < potentialMinorLow

        potentialMinorLow := low
        potentialMinorLowBar := bar_index


// ------------------------------------------------
// Rally day qualification
// ------------------------------------------------

pinkRallyDay =
     downDay and
     rangeLocation >= 0.50


rallyDayCandidate =
     upDay or
     pinkRallyDay


if (
     rallyState == RALLY_POTENTIAL_MAJOR or
     rallyState == RALLY_POTENTIAL_MINOR
   ) and
   rallyDayCandidate

    rallyDayBar := bar_index
    rallyDayLow := low
    rallyAttemptActive := true


// ------------------------------------------------
// Rally low continues lower
// ------------------------------------------------

if rallyAttemptActive and
   low < rallyDayLow

    rallyDayLow := low
    rallyDayBar := bar_index


rallyDayCount =
     rallyAttemptActive and
     not na(rallyDayBar) ?
         bar_index - rallyDayBar + 1 :
         0


// ------------------------------------------------
// Trailing low
// ------------------------------------------------

if rallyAttemptActive and
   rallyDayCount > 25 and
   rallyState != RALLY_TRAILING

    rallyState := RALLY_TRAILING

    trailingLow := rallyDayLow
    trailingLowBar := rallyDayBar


if rallyState == RALLY_TRAILING

    if na(trailingLow) or
       low < trailingLow

        trailingLow := low
        trailingLowBar := bar_index


// ================================================================
// SIGNAL STATE VARIABLES
// ================================================================

var bool buySwitch = false
var bool restraintRule = false

var int exposureCount = 0

var float initialFTDLow = na
var float initialFTDClose = na
var int initialFTDBar = na

var bool b3Armed = true
var bool emaSellArmed = false

var int barsSinceB3 = na

var bool b3SinceB1 = false

var bool s5SeenSinceB3 = false

var int daysLowAbove21 = 0
var int daysHighBelow21 = 0

var bool b6Active = false

var float highestHighSinceFTD = na

var int powerTrendState = PT_OFF

var int daysSincePressureSignal = 0


// ================================================================
// B1 — FOLLOW THROUGH DAY
// ================================================================

activeRallyReferenceBar =
     rallyState == RALLY_TRAILING ?
         trailingLowBar :
         rallyDayBar


activeRallyReferenceLow =
     rallyState == RALLY_TRAILING ?
         trailingLow :
         rallyDayLow


daysFromActiveRally =
     not na(activeRallyReferenceBar) ?
         bar_index -
         activeRallyReferenceBar +
         1 :
         0


isB1 =
     rallyAttemptActive and
     daysFromActiveRally >= 4 and
     pctChange >= ftdRequirement and
     ftdVolumeUp


if isB1

    initialFTDLow := low
    initialFTDClose := close
    initialFTDBar := bar_index

    buySwitch := true
    restraintRule := true

    exposureCount := 2

    highestHighSinceFTD := high

    b3Armed := true
    emaSellArmed := false

    barsSinceB3 := na

    b3SinceB1 := false
    s5SeenSinceB3 := false

    b6Active := false

    // Confirm rally structure.

    if rallyState == RALLY_POTENTIAL_MINOR

        minorLow := potentialMinorLow
        minorLowBar := potentialMinorLowBar

        rallyState := RALLY_MINOR

    else

        majorLow :=
             rallyState == RALLY_TRAILING ?
                 trailingLow :
                 potentialMajorLow

        majorLowBar :=
             rallyState == RALLY_TRAILING ?
                 trailingLowBar :
                 potentialMajorLowBar

        rallyState := RALLY_MAJOR

    rallyAttemptActive := false


// ================================================================
// B2 — ADDITIONAL FOLLOW THROUGH
// ================================================================

isB2 =
     buySwitch and
     not isB1 and
     not na(rallyDayBar) and
     bar_index - rallyDayBar <= 24 and
     pctChange >= ftdRequirement and
     ftdVolumeUp and
     not na(initialFTDLow) and
     close > initialFTDLow


// ================================================================
// EMA21 COUNTERS
// ================================================================

if low >= ema21
    daysLowAbove21 += 1
else
    daysLowAbove21 := 0


if high < ema21
    daysHighBelow21 += 1
else
    daysHighBelow21 := 0


// ================================================================
// B3 — LOW ABOVE EMA21
// ================================================================

isB3 =
     buySwitch and
     b3Armed and
     upOrFlatDay and
     low >= ema21


if isB3

    b3Armed := false
    emaSellArmed := true

    barsSinceB3 := 0

    b3SinceB1 := true
    s5SeenSinceB3 := false


else if not na(barsSinceB3)

    barsSinceB3 += 1


// ================================================================
// B4 — FIVE DAYS ABOVE EMA21
// ================================================================

isB4 =
     buySwitch and
     daysLowAbove21 == 5


// ================================================================
// B5 — LIVING ABOVE EMA21
// ================================================================

isB5 =
     buySwitch and
     daysLowAbove21 >= 10 and
     daysLowAbove21 % 5 == 0


// ================================================================
// B6 — ABOVE RISING SMA50
// ================================================================

isB6 =
     buySwitch and
     not b6Active and
     close > sma50 and
     sma50 > sma50[1]


if isB6
    b6Active := true


// ================================================================
// B7 — ACCUMULATION DAY
// ================================================================

isB7 =
     buySwitch and
     not na(rallyDayBar) and
     bar_index - rallyDayBar > 25 and
     pctChange >= ftdRequirement and
     generalVolumeUp and
     rangeLocation >= 0.75


// ================================================================
// S1 — FTD LOW UNDERCUT
// ================================================================

isS1 =
     buySwitch and
     not na(initialFTDLow) and
     close < initialFTDLow and
     close[1] >= initialFTDLow


// ================================================================
// S2 / S2ml — RALLY LOW UNDERCUT
// ================================================================

isS2Minor =
     buySwitch and
     not na(minorLow) and
     close < minorLow and
     close[1] >= minorLow


isS2 =
     buySwitch and
     not na(majorLow) and
     close < majorLow and
     close[1] >= majorLow


// ================================================================
// S3 / S4 — DISTRIBUTION
// ================================================================

isS3 =
     distributionCount ==
         fullDDCount - 1 and
     distributionCount >
         previousDistributionCount


isS4 =
     newFullDistribution


// ================================================================
// S5 / S6 — EMA21 BREAK STATE MACHINE
// ================================================================

ema21Break =
     close <= ema21 * 0.998


isS5 =
     buySwitch and
     emaSellArmed and
     not na(barsSinceB3) and
     barsSinceB3 <= 30 and
     ema21Break


isS6 =
     buySwitch and
     emaSellArmed and
     not na(barsSinceB3) and
     barsSinceB3 > 30 and
     ema21Break


if isS5 or isS6

    emaSellArmed := false

    b3Armed := true

    s5SeenSinceB3 := true


// ================================================================
// S7 — TRENDING BELOW EMA21
// ================================================================

isS7 =
     buySwitch and
     b3SinceB1 and
     s5SeenSinceB3 and
     daysHighBelow21 == 5 and
     downDay


// ================================================================
// S8 — LIVING BELOW EMA21
// ================================================================

isS8 =
     buySwitch and
     b3SinceB1 and
     s5SeenSinceB3 and
     daysHighBelow21 >= 10 and
     daysHighBelow21 % 5 == 0


// ================================================================
// S9 — BREAK BELOW SMA50
// ================================================================

isS9 =
     buySwitch and
     b6Active and
     close < sma50 and
     close[1] >= sma50


if isS9
    b6Active := false


// ================================================================
// S10 — BAD BREAK
// ================================================================

isS10 =
     pctChange <= -2.25 and
     rangeLocation <= 0.25 and
     (
         close < sma50 or
         high < ema21
     )


// ================================================================
// S11 — DOWNSIDE REVERSAL
// ================================================================

spreadPct =
     low > 0 ?
         (high - low) / low * 100 :
         0.0


new13WeekHigh =
     high >= ta.highest(high, 65)


isS11 =
     new13WeekHigh and
     downDay and
     rangeLocation <= 0.25 and
     spreadPct >= 1.75


// ================================================================
// S13 — DISTRIBUTION CLUSTER
// ================================================================

isS13 =
     newDistributionCluster


// ================================================================
// CIRCUIT BREAKER
// ================================================================

if isB1

    highestHighSinceFTD := high


else if buySwitch

    highestHighSinceFTD :=
         math.max(
             nz(
                 highestHighSinceFTD,
                 high
             ),
             high
         )


else

    highestHighSinceFTD := na


tenPercentDecline =
     buySwitch and
     not na(highestHighSinceFTD) and
     low <= highestHighSinceFTD * 0.90


fivePercentBelowSMA50 =
     low <= sma50 * 0.95


isCircuitBreaker =
     tenPercentDecline and
     fivePercentBelowSMA50


// ================================================================
// POWER TREND STATE MACHINE
// ================================================================

var int daysEMA21AboveSMA50 = 0

if ema21 > sma50
    daysEMA21AboveSMA50 += 1
else
    daysEMA21AboveSMA50 := 0


initialPowerConditions =
     daysLowAbove21 >= 10 and
     daysEMA21AboveSMA50 >= 5 and
     sma50 > sma50[1]


pressureSignal =
     isS2Minor or
     isS9 or
     isS13


if pressureSignal
    daysSincePressureSignal := 0
else
    daysSincePressureSignal += 1


if isS2 or isCircuitBreaker

    powerTrendState := PT_OFF


else if isS9

    powerTrendState := PT_NO_FLOOR


else if isS2Minor or isS13

    powerTrendState := PT_FLOOR


else if powerTrendState == PT_FLOOR or powerTrendState == PT_NO_FLOOR

    if daysSincePressureSignal >= 10 and initialPowerConditions

        powerTrendState := PT_RESUME


else if initialPowerConditions

    powerTrendState := PT_ON


if ta.crossunder(ema21, sma50) and
   downDay

    powerTrendState := PT_OFF


// ================================================================
// RESTRAINT RULE
// ================================================================

if restraintRule and
   (
       (
           not na(initialFTDClose) and
           close > initialFTDClose * 1.01
       ) or
       isB4
   )

    restraintRule := false


// ================================================================
// EXPOSURE ENGINE
// ================================================================

int buySignalChange = 0
int sellSignalChange = 0


if isB2
    buySignalChange += 1

if isB3
    buySignalChange += 1

if isB4
    buySignalChange += 1

if isB5
    buySignalChange += 1

if isB6
    buySignalChange += 1

if isB7
    buySignalChange += 1


if isS1
    sellSignalChange -= 2

if isS2Minor
    sellSignalChange -= 2

if isS3
    sellSignalChange -= 1

if isS4
    sellSignalChange -= 1

if isS5
    sellSignalChange -= 1

if isS6
    sellSignalChange -= 1

if isS7
    sellSignalChange -= 1

if isS8
    sellSignalChange -= 1

if isS9
    sellSignalChange -= 1

if isS10
    sellSignalChange -= 1

if isS11
    sellSignalChange -= 1

if isS13
    sellSignalChange -= 1


if buySwitch and
   not isB1

    exposureCount +=
         buySignalChange +
         sellSignalChange


exposureCount :=
     math.max(
         exposureCount,
         0
     )


// ------------------------------------------------
// Power Trend floor / ceiling
// ------------------------------------------------

powerFloor =
     powerTrendState == PT_ON ? 2 :
     powerTrendState == PT_RESUME ? 2 :
     powerTrendState == PT_FLOOR ? 1 :
     0


powerCeiling =
     powerTrendState == PT_ON ? 7 :
     powerTrendState == PT_RESUME ? 7 :
     5


if buySwitch

    exposureCount :=
         math.max(
             exposureCount,
             powerFloor
         )

    exposureCount :=
         math.min(
             exposureCount,
             powerCeiling
         )


if restraintRule

    exposureCount :=
         math.min(
             exposureCount,
             2
         )


// ================================================================
// HARD RESET
// ================================================================

if isS2 or
   isCircuitBreaker

    buySwitch := false

    restraintRule := false

    exposureCount := 0

    powerTrendState := PT_OFF

    b3Armed := true
    emaSellArmed := false

    barsSinceB3 := na

    b3SinceB1 := false
    s5SeenSinceB3 := false

    b6Active := false

    initialFTDLow := na
    initialFTDClose := na
    initialFTDBar := na

    highestHighSinceFTD := na

    rallyAttemptActive := false

    rallyState := RALLY_POTENTIAL_MAJOR
    potentialMajorLow := low
    potentialMajorLowBar := bar_index
    potentialMinorLow := na
    potentialMinorLowBar := na
    trailingLow := na
    trailingLowBar := na
    rallyDayBar := na
    rallyDayLow := na
    majorLow := na
    majorLowBar := na
    minorLow := na
    minorLowBar := na


// ================================================================
// SIGNAL TEXT
// ================================================================

string signalText = ""

signalText += isB1 ? "B1 " : ""
signalText += isB2 ? "B2 " : ""
signalText += isB3 ? "B3 " : ""
signalText += isB4 ? "B4 " : ""
signalText += isB5 ? "B5 " : ""
signalText += isB6 ? "B6 " : ""
signalText += isB7 ? "B7 " : ""

signalText += isS1 ? "S1 " : ""
signalText += isS2 ? "S2 " : ""
signalText += isS2Minor ? "S2ml " : ""
signalText += isS3 ? "S3 " : ""
signalText += isS4 ? "S4 " : ""
signalText += isS5 ? "S5 " : ""
signalText += isS6 ? "S6 " : ""
signalText += isS7 ? "S7 " : ""
signalText += isS8 ? "S8 " : ""
signalText += isS9 ? "S9 " : ""
signalText += isS10 ? "S10 " : ""
signalText += isS11 ? "S11 " : ""
signalText += isS13 ? "S13 " : ""

signalText += isCircuitBreaker ? "CB " : ""

signalText +=
     isDistributionDay ? "DD " : ""

signalText +=
     isStallingDay ? "SD " : ""

signalText +=
     isHeavyVolumeNoProgress ? "H " : ""


// ================================================================
// LABELS
// ================================================================

if showSignals and
   signalText != ""

    bool positiveSignal =
         buySignalChange > 0 or
         isB1

    color labelBackground =
         positiveSignal ?
             color.new(
                 color.green,
                 70
             ) :
             color.new(
                 color.red,
                 70
             )

    color labelText =
         positiveSignal ?
             color.green :
             color.red

    label.new(
         bar_index,
         high,
         signalText,
         color = labelBackground,
         textcolor = labelText,
         style = label.style_label_down,
         size = size.tiny
    )


// ================================================================
// RALLY LEVELS
// ================================================================

plot(
     showRallyLevels ?
         majorLow :
         na,
     "Major Low",
     color = color.red,
     style = plot.style_stepline
)

plot(
     showRallyLevels ?
         minorLow :
         na,
     "Minor Low",
     color = color.orange,
     style = plot.style_stepline
)

plot(
     showRallyLevels and
     rallyState == RALLY_TRAILING ?
         trailingLow :
         na,
     "Trailing Low",
     color = color.purple,
     style = plot.style_stepline
)

plot(
     showRallyLevels ?
         initialFTDLow :
         na,
     "Initial FTD Low",
     color = color.blue,
     style = plot.style_stepline
)


// ================================================================
// DASHBOARD
// ================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         12,
         bgcolor = color.new(
             color.black,
             10
         ),
         border_width = 1
     )


if barstate.islast and
   showTable

    table.cell(
         dashboard,
         0,
         0,
         "IBD MARKET SCHOOL",
         bgcolor = color.blue,
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         0,
         syminfo.ticker,
         bgcolor = color.blue,
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         1,
         "Buy Switch",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         1,
         buySwitch ? "ON" : "OFF",
         bgcolor =
             buySwitch ?
                 color.green :
                 color.red,
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         2,
         "Exposure",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         2,
         f_exposure_text(
             exposureCount
         ) +
         " (" +
         str.tostring(
             exposureCount
         ) +
         ")",
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         3,
         "Count / Max",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(
             exposureCount
         ) +
         " / " +
         str.tostring(
             powerCeiling
         ),
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         4,
         "Dist. Days",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(
             distributionCount
         ) +
         " / " +
         str.tostring(
             fullDDCount
         ),
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         5,
         "Cluster",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         5,
         distributionCluster ?
             "YES" :
             "NO",
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         6,
         "Rally",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         6,
         f_rally_state_name(
             rallyState
         ),
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         7,
         "Rally Day",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         7,
         str.tostring(
             daysFromActiveRally
         ),
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         8,
         "Power Trend",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         8,
         f_power_state_name(
             powerTrendState
         ),
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         9,
         "Restraint",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         9,
         restraintRule ?
             "ON" :
             "OFF",
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         10,
         "IBD Volatility",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         10,
         str.tostring(
             ibdVolatility,
             "#.###"
         ) +
         "%",
         text_color = color.white
    )


    table.cell(
         dashboard,
         0,
         11,
         "FTD Req.",
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         11,
         str.tostring(
             ftdRequirement,
             "#.###"
         ) +
         "%",
         text_color = color.white
    )


