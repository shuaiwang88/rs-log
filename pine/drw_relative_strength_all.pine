//@version=6
indicator('Relative Strength (RS) Line, Ratings & Signals', overlay = true, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500)

//----------types----------//
type trendLine 
    line tl 
    int lastB
    bool active = true

type pivData
    float h
    int b

// ── Settings & Inputs ────────────────────────────────────────────────────────
hideRSLine   = input.bool(false, title = 'Hide RS Line', group = 'RS Rating & Line', inline = '0')
hideRSRat    = input.bool(false, title = 'Hide Rating', group = 'RS Rating & Line', inline = '0')
ratingOnly   = input.bool(false, title = 'Rating Only', group = 'RS Rating & Line')
lineTicker   = input.string('SP:SPX', title = 'Comparative Symbol for Line', group = 'RS Rating & Line', tooltip = 'Reference ticker used for calculation of the RS Line.')
SpxValue     = input.int(4200, title = 'Value of Comparative Symbol', group = 'RS Rating & Line', tooltip = 'Used to gather a constant value')
offset       = input.int(130, minval = 0, maxval = 300, title = 'Offset (%)', group = 'RS Rating & Line', tooltip = 'Used to display the RS Line under the price.')
colorRS      = input.color(color.rgb(24, 140, 202), title = 'Color of RS Line & Rating', group = 'RS Rating & Line')

// RS New Highs Inputs
plotNewHigh  = input.bool(true, title = 'Plot RS New Highs', group = 'RS New Highs')
rsNewHigh    = input.string('Historical RS New Highs', title = 'Type',
               options = ['RS New Highs', 'RS New Highs Before Price',
                          'Historical RS New Highs', 'Historical RS New Highs  Before Price'],
               group = 'RS New Highs')
col_nh1Y     = input.color(color.new(#0000FF, 20), title = '1Y NH',         group = 'RS New Highs', inline = 'nhcols')
col_nh6M     = input.color(color.new(#1E90FF, 25), title = '6M NH',         group = 'RS New Highs', inline = 'nhcols')
col_nh3M     = input.color(color.new(#00BFFF, 30), title = '3M NH',         group = 'RS New Highs', inline = 'nhcols')
col_nhLP     = input.color(color.new(#00ffd9,  0), title = 'Leads Price',   group = 'RS New Highs', inline = 'nhcols')
lookback     = input.int(250, title = 'Look-back', minval = 1, maxval = 252, group = 'RS New Highs', tooltip = 'The lookback for calculation of price and RS New Highs.')
sizeLabHigh  = input.string('Tiny', title = 'RS New Highs Circle Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge', 'Auto'], group = 'RS New Highs')

// RS New Lows Inputs
plotNewLow   = input.bool(true, title = 'Plot RS New Lows', group = 'RS New Lows')
rsNewLow     = input.string('Historical RS New Lows', title = 'Type', options = ['RS New Lows', 'RS New Lows Before Price', 'Historical RS New Lows', 'Historical RS New Lows  Before Price'], group = 'RS New Lows')
redDotCol    = input.color(color.rgb(255, 82, 82, 62), title = 'Color', group = 'RS New Lows')
lookback2    = input.int(250, title = 'Look-back', minval = 1, maxval = 252, group = 'RS New Lows', tooltip = 'The lookback for calculation of price and RS New Lows.')
sizeLabLow   = input.string('Tiny', title = 'RS New Lows Circle Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge', 'Auto'], group = 'RS New Lows')

// RS Moving Averages Inputs
showQuick    = input.bool(true, title='Quick', inline='quick', group='RS Moving Averages')
colQuick     = input.color(color.rgb(0, 255, 255, 0), title='', inline='quick', group='RS Moving Averages')
showQuickSand = input.bool(true, title='QuickSand', inline='qs', group='RS Moving Averages')
colQuickSand  = input.color(color.orange, title='', inline='qs', group='RS Moving Averages')
showGD       = input.bool(true, title='Grateful Dead', inline='gd', group='RS Moving Averages')
colGD        = input.color(color.rgb(128, 0, 128), title='', inline='gd', group='RS Moving Averages')

// RS Replay Mode Inputs
allowReplay  = input.bool(false, title = 'Use fix values for replay mode', group = 'RS Replay Mode (Approximate Method)', tooltip = 'Here we use constant values in order to provide the environment regardless of the date. See RSRATING ticker and report close values to have the last data.')
first2       = input.float(195.93, title = 'For 99 stocks', group = 'RS Replay Mode (Approximate Method)')
scnd2        = input.float(117.11, title = 'For 90+ stocks', group = 'RS Replay Mode (Approximate Method)')
thrd2        = input.float(99.04, title = 'For 70+ stocks', group = 'RS Replay Mode (Approximate Method)')
frth2        = input.float(91.66, title = 'For 50+ stocks', group = 'RS Replay Mode (Approximate Method)')
ffth2        = input.float(80.96, title = 'For 30+ stocks', group = 'RS Replay Mode (Approximate Method)')
sxth2        = input.float(53.64, title = 'For 10+ stocks', group = 'RS Replay Mode (Approximate Method)')
svth2        = input.float(24.86, title = 'For 1- stocks', group = 'RS Replay Mode (Approximate Method)')

// Dashboard UI Options
showDashboard = input.bool(false, title = 'Show RS Stats Dashboard', group = 'Dashboard settings')
dashLocation  = input.string('Top Right', title = 'Dashboard Position', options = ['Top Right', 'Bottom Right', 'Top Left', 'Bottom Left'], group = 'Dashboard settings')

// RS Trendlines Inputs
showTrendlines = input.bool(false, 'Show RS Trendlines', group = 'RS Trendlines')
tlBars         = input.int(5, 'Pivot High Bars Required for Anchor', group = 'RS Trendlines')
tlBuffer       = input.float(0.1, 'Price/RS Buffer %', minval = 0.0, step = 0.1, group = 'RS Trendlines') / 100.0
tlNumTouches   = input.int(3, 'Minimum Number of Touches', minval = 3, group = 'RS Trendlines')
tlCol          = input.color(color.purple, 'Trendline Color', group = 'RS Trendlines', inline = 'tl1')
tlWidth        = input.int(2, 'Width', minval = 1, maxval = 5, group = 'RS Trendlines', inline = 'tl1')
tlExt          = input.bool(false, 'Extend Trendlines', group = 'RS Trendlines')
tlNewH         = input.int(100, 'Look for New Pivot High after X Bars', group = 'RS Trendlines')
tlShowBo       = input.bool(true, 'Show Trendline Breakouts', group = 'RS Trendlines', inline = 'tl2')
tlBoCol        = input.color(color.lime, 'Breakout Color', group = 'RS Trendlines', inline = 'tl2')
tlShowNum      = input.int(1, 'Number of Trendlines to show', group = 'RS Trendlines')

// RS Pattern Recognition Inputs
showPatterns  = input.bool(false, 'Show RS Patterns', group = 'RS Pattern Recognition')
i_pivLen      = input.int(9, 'Pivot Look-Left / Right (bars)', group = 'RS Pattern Recognition')
i_baseDepth   = input.int(50, 'Base Max Depth %', group = 'RS Pattern Recognition')
i_baseLen     = input.int(65, 'Base Max Length (weeks)', group = 'RS Pattern Recognition')
i_requirePriorUptrend = input.bool(true, 'Require 20% Prior Uptrend for Base', group = 'RS Pattern Recognition')

// Colors
colFlatTop    = input.color(color.orange, 'Flat Base Top Line', group = 'RS Pattern Recognition', inline = 'flatCol')
colFlatBot    = input.color(color.new(color.orange, 50), 'Flat Base Bottom Line', group = 'RS Pattern Recognition', inline = 'flatCol')
colCupTop     = input.color(color.green, 'Cup Base Top Line', group = 'RS Pattern Recognition', inline = 'cupCol')
colCupBot     = input.color(color.new(color.green, 50), 'Cup Base Bottom Line', group = 'RS Pattern Recognition', inline = 'cupCol')
colBaseTop    = input.color(color.gray, 'Standard Base Top Line', group = 'RS Pattern Recognition', inline = 'baseCol')
colBaseBot    = input.color(color.new(color.gray, 50), 'Standard Base Bottom Line', group = 'RS Pattern Recognition', inline = 'baseCol')

// RS Divergence Inputs
showDivergence = input.bool(false, 'Show RS Bullish Divergence', group = 'RS Pattern Recognition')
colBullDiv     = input.color(color.blue, 'Divergence Label Color', group = 'RS Pattern Recognition')

// ── Helper Functions ─────────────────────────────────────────────────────────
f_rrs_highest(src, len) =>
    h = src
    for i = 1 to len - 1
        if not na(src[i]) and src[i] > h
            h := src[i]
    h

f_rrs_lowest(src, len) =>
    l = src
    for i = 1 to len - 1
        if not na(src[i]) and src[i] < l
            l := src[i]
    l

// Size mapping
highLabel = switch sizeLabHigh
    'Auto'   => size.auto
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    'Huge'   => size.huge

lowLabel = switch sizeLabLow
    'Auto'   => size.auto
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    'Huge'   => size.huge

// Dynamic lookbacks based on weekly timeframe
if lookback == 250 and timeframe.isweekly
    lookback := 52
if lookback2 == 250 and timeframe.isweekly
    lookback2 := 52

prevlookback = lookback
prevlookback2 = lookback2
lookback := math.min(lookback - 1, bar_index)

// ── Comparative Ticker and RS Line Calculation ────────────────────────────────
comparativeSymbol = request.security(lineTicker, timeframe.period, close)
rsCurve = close / comparativeSymbol

if syminfo.industry == 'Investment Trusts/Mutual Funds'
    offset := 90

rsRatio = timeframe.isweekly ? SpxValue * (offset - 10) / 100 : SpxValue * offset / 100
rs = rsCurve * rsRatio

// Plot RS Line
rsPlot = plot(hideRSLine ? na : rs, title = 'RS Line', style = plot.style_line, linewidth = 1, color = colorRS)

// ── RS Moving Averages ────────────────────────────────────────────────────────
isWeekly  = timeframe.isweekly
isMonthly = timeframe.ismonthly

quickLen      = isMonthly ? 5  : isWeekly ? 8  : 21
quickSandLen  = isMonthly ? 8  : isWeekly ? 13 : 34
gdLen         = isMonthly ? 13 : isWeekly ? 21 : 50

emaQuick      = showQuick      ? ta.ema(rs, quickLen)     : na
emaQuickSand  = showQuickSand  ? ta.ema(rs, quickSandLen) : na
emaGrateful   = showGD         ? ta.ema(rs, gdLen)        : na

plot(emaQuick,     color=colQuick,     linewidth=1, title='Quick')
plot(emaQuickSand, color=colQuickSand, linewidth=1, title='QuickSand')
plot(emaGrateful,  color=colGD,        linewidth=1, title='Grateful Dead')

// ── RS New Highs ──────────────────────────────────────────────────────────────
int lb1Y = timeframe.isweekly ? 52  : 250
int lb6M = timeframe.isweekly ? 24  : 126
int lb3M = timeframe.isweekly ? 12  : 63

_rsH1Y = f_rrs_highest(rsCurve, lb1Y)[1]
_rsH6M = f_rrs_highest(rsCurve, lb6M)[1]
_rsH3M = f_rrs_highest(rsCurve, lb3M)[1]

rs_nh1Y = not na(rsCurve) and not na(_rsH1Y) and rsCurve > _rsH1Y
rs_nh6M = not na(rsCurve) and not na(_rsH6M) and rsCurve > _rsH6M and not rs_nh1Y
rs_nh3M = not na(rsCurve) and not na(_rsH3M) and rsCurve > _rsH3M and not rs_nh1Y and not rs_nh6M
rs_nh_any = rs_nh1Y or rs_nh6M or rs_nh3M

_prH1Y = f_rrs_highest(high, lb1Y)[1]
_prH6M = f_rrs_highest(high, lb6M)[1]
_prH3M = f_rrs_highest(high, lb3M)[1]

price_nh1Y = not na(_prH1Y) and high > _prH1Y
price_nh6M = not na(_prH6M) and high > _prH6M
price_nh3M = not na(_prH3M) and high > _prH3M

rs_nh_period      = rs_nh1Y ? '1Y' : rs_nh6M ? '6M' : '3M'
price_nh_matching = rs_nh1Y ? price_nh1Y : rs_nh6M ? price_nh6M : price_nh3M

f_nhColor() =>
    leadsPrice = not price_nh_matching
    leadsPrice ? col_nhLP : rs_nh1Y ? col_nh1Y : rs_nh6M ? col_nh6M : col_nh3M

var label newHigh = na

if rsNewHigh == 'Historical RS New Highs' and plotNewHigh and rs_nh_any
    newHigh := label.new(x = bar_index, y = rs, color = f_nhColor(),
                         style = label.style_circle, size = highLabel)

if rsNewHigh == 'Historical RS New Highs  Before Price' and plotNewHigh and rs_nh_any and not price_nh_matching
    newHigh := label.new(x = bar_index, y = rs, color = col_nhLP,
                         style = label.style_circle, size = highLabel)

if barstate.islast and rsNewHigh == 'RS New Highs' and plotNewHigh and rs_nh_any
    label.delete(newHigh)
    newHigh := label.new(x = bar_index, y = rs, color = f_nhColor(),
                         style = label.style_circle, size = highLabel)

if barstate.islast and rsNewHigh == 'RS New Highs Before Price' and plotNewHigh and rs_nh_any and not price_nh_matching
    label.delete(newHigh)
    newHigh := label.new(x = bar_index, y = rs, color = col_nhLP,
                         style = label.style_circle, size = highLabel)

if plotNewHigh and rs_nh_any
    _leadsPrice = not price_nh_matching
    _ttNH = _leadsPrice
          ? '🟢 RS LEADS PRICE (' + rs_nh_period + ')\nRS new ' + rs_nh_period + ' high before price\nLeading strength signal'
          : '🔵 RS NEW HIGH (' + rs_nh_period + ')\nRS at a ' + rs_nh_period + ' new high'
    label.new(bar_index, rs, '',
              style     = label.style_circle,
              color     = color.new(color.white, 100),
              textcolor = color.new(color.white, 100),
              size      = highLabel,
              tooltip   = _ttNH)

// ── RS New Lows ───────────────────────────────────────────────────────────────
_rsL  = f_rrs_lowest(rsCurve, prevlookback2)[1]
_prL  = f_rrs_lowest(low,     prevlookback2)[1]
rs_nl    = not na(rsCurve) and not na(_rsL) and rsCurve < _rsL
price_nl = not na(low)     and not na(_prL) and low     < _prL

var label newLow = na

if rsNewLow == 'Historical RS New Lows' and plotNewLow and rs_nl
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)

if rsNewLow == 'Historical RS New Lows  Before Price' and plotNewLow and rs_nl and not price_nl
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)

if barstate.islast and rsNewLow == 'RS New Lows' and plotNewLow and rs_nl
    label.delete(newLow)
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)

if barstate.islast and rsNewLow == 'RS New Lows Before Price' and plotNewLow and rs_nl and not price_nl
    label.delete(newLow)
    newLow := label.new(x = bar_index, y = rs, color = redDotCol,
                        style = label.style_circle, size = lowLabel)

if plotNewLow and rs_nl
    label.new(bar_index, rs, '',
              style     = label.style_circle,
              color     = color.new(color.white, 100),
              textcolor = color.new(color.white, 100),
              size      = lowLabel,
              tooltip   = '🔴 RS NEW LOW\nRS at a ' + str.tostring(prevlookback2) + '-bar low\nRelative weakness — avoid or reduce')

// ── RS Ratings (Percentile-based) ─────────────────────────────────────────────
n63  = bar_index < 63  ? bar_index : 63
n126 = bar_index < 126 ? bar_index : 126
n189 = bar_index < 189 ? bar_index : 189
n252 = bar_index < 252 ? bar_index : 252

closeDa    = request.security(syminfo.tickerid, 'D', close)
spxCloseDa = request.security('SP:SPX', 'D', close)

perfTicker63  = closeDa / closeDa[n63]
perfTicker126 = closeDa / closeDa[n126]
perfTicker189 = closeDa / closeDa[n189]
perfTicker252 = closeDa / closeDa[n252]

perfComp63  = spxCloseDa / spxCloseDa[n63]
perfComp126 = spxCloseDa / spxCloseDa[n126]
perfComp189 = spxCloseDa / spxCloseDa[n189]
perfComp252 = spxCloseDa / spxCloseDa[n252]

float rs_stock = 0.4 * perfTicker63 + 0.2 * perfTicker126 + 0.2 * perfTicker189 + 0.2 * perfTicker252
float rs_ref   = 0.4 * perfComp63 + 0.2 * perfComp126 + 0.2 * perfComp189 + 0.2 * perfComp252

float totalRsScore = rs_stock / rs_ref * 100
float totalRsRating = -1

curveRsPerf = request.seed('seed_fred6725_rs_rating', 'RSRATING', close)
delta = ta.barssince(na(curveRsPerf) != true)

var array<float> different_values = array.new_float(7)
var int counter = 0

float first = 0
float scnd  = 0
float thrd  = 0
float frth  = 0
float ffth  = 0
float sxth  = 0
float svth  = 0

if not allowReplay
    for i = delta to 34 + delta by 1
        close_value = nz(curveRsPerf[i])
        if not array.includes(different_values, close_value) and counter < 7 and close_value != 0
            array.set(different_values, counter, close_value)
            counter := counter + 1

    first := array.get(different_values, 0)
    scnd  := array.get(different_values, 1)
    thrd  := array.get(different_values, 2)
    frth  := array.get(different_values, 3)
    ffth  := array.get(different_values, 4)
    sxth  := array.get(different_values, 5)
    svth  := array.get(different_values, 6)

if allowReplay
    first := first2
    scnd  := scnd2
    thrd  := thrd2
    frth  := frth2
    ffth  := ffth2
    sxth  := sxth2
    svth  := svth2

f_attributePercentile(score, tallerPerf, smallerPerf, rangeUp, rangeDn, weight) =>
    sum = score + (score - smallerPerf) * weight
    if sum > tallerPerf - 1
        sum := tallerPerf - 1
    k1 = smallerPerf / rangeDn
    k2 = (tallerPerf - 1) / rangeUp
    k3 = (k1 - k2) / (tallerPerf - 1 - smallerPerf)
    RsRating = sum / (k1 - k3 * (score - smallerPerf))
    if RsRating > rangeUp
        RsRating := rangeUp
    if RsRating < rangeDn
        RsRating := rangeDn
    RsRating

if totalRsScore >= first
    totalRsRating := 99
else if totalRsScore <= svth
    totalRsRating := 1
else if totalRsScore < first and totalRsScore >= scnd
    totalRsRating := f_attributePercentile(totalRsScore, first, scnd, 98, 90, 0.33)
else if totalRsScore < scnd and totalRsScore >= thrd
    totalRsRating := f_attributePercentile(totalRsScore, scnd, thrd, 89, 70, 2.1)
else if totalRsScore < thrd and totalRsScore >= frth
    totalRsRating := f_attributePercentile(totalRsScore, thrd, frth, 69, 50, 0)
else if totalRsScore < frth and totalRsScore >= ffth
    totalRsRating := f_attributePercentile(totalRsScore, frth, ffth, 49, 30, 0)
else if totalRsScore < ffth and totalRsScore >= sxth
    totalRsRating := f_attributePercentile(totalRsScore, ffth, sxth, 29, 10, 0)
else if totalRsScore < sxth and totalRsScore >= svth
    totalRsRating := f_attributePercentile(totalRsScore, sxth, svth, 9, 2, 0)

for i = 0 to 6 by 1
    if nz(array.get(different_values, i)) == 0 and not allowReplay
        totalRsRating := -1



// ── 3-Month and 6-Month RS Ratings ───────────────────────────────────────────
rsScore3m = perfTicker63  / perfComp63  * 100
rsScore6m = perfTicker126 / perfComp126 * 100

float rsRating3m = -1
float rsRating6m = -1

if rsScore3m >= first
    rsRating3m := 99
else if rsScore3m <= svth
    rsRating3m := 1
else if rsScore3m < first and rsScore3m >= scnd
    rsRating3m := f_attributePercentile(rsScore3m, first, scnd, 98, 90, 0.33)
else if rsScore3m < scnd and rsScore3m >= thrd
    rsRating3m := f_attributePercentile(rsScore3m, scnd, thrd, 89, 70, 2.1)
else if rsScore3m < thrd and rsScore3m >= frth
    rsRating3m := f_attributePercentile(rsScore3m, thrd, frth, 69, 50, 0)
else if rsScore3m < frth and rsScore3m >= ffth
    rsRating3m := f_attributePercentile(rsScore3m, frth, ffth, 49, 30, 0)
else if rsScore3m < ffth and rsScore3m >= sxth
    rsRating3m := f_attributePercentile(rsScore3m, ffth, sxth, 29, 10, 0)
else if rsScore3m < sxth and rsScore3m >= svth
    rsRating3m := f_attributePercentile(rsScore3m, sxth, svth, 9, 2, 0)

if rsScore6m >= first
    rsRating6m := 99
else if rsScore6m <= svth
    rsRating6m := 1
else if rsScore6m < first and rsScore6m >= scnd
    rsRating6m := f_attributePercentile(rsScore6m, first, scnd, 98, 90, 0.33)
else if rsScore6m < scnd and rsScore6m >= thrd
    rsRating6m := f_attributePercentile(rsScore6m, scnd, thrd, 89, 70, 2.1)
else if rsScore6m < thrd and rsScore6m >= frth
    rsRating6m := f_attributePercentile(rsScore6m, thrd, frth, 69, 50, 0)
else if rsScore6m < frth and rsScore6m >= ffth
    rsRating6m := f_attributePercentile(rsScore6m, frth, ffth, 49, 30, 0)
else if rsScore6m < ffth and rsScore6m >= sxth
    rsRating6m := f_attributePercentile(rsScore6m, ffth, sxth, 29, 10, 0)
else if rsScore6m < sxth and rsScore6m >= svth
    rsRating6m := f_attributePercentile(rsScore6m, sxth, svth, 9, 2, 0)

for i = 0 to 6 by 1
    if nz(array.get(different_values, i)) == 0 and not allowReplay
        rsRating3m := -1
        rsRating6m := -1

// Calculate RS Rating Changes on the last bar using the fully-populated seed bounds
f_calculateRating(score, f, s, t, fr, ff, sx, sv) =>
    float rating = -1
    if score >= f
        rating := 99
    else if score <= sv
        rating := 1
    else if score < f and score >= s
        rating := f_attributePercentile(score, f, s, 98, 90, 0.33)
    else if score < s and score >= t
        rating := f_attributePercentile(score, s, t, 89, 70, 2.1)
    else if score < t and score >= fr
        rating := f_attributePercentile(score, t, fr, 69, 50, 0)
    else if score < fr and score >= ff
        rating := f_attributePercentile(score, fr, ff, 49, 30, 0)
    else if score < ff and score >= sx
        rating := f_attributePercentile(score, ff, sx, 29, 10, 0)
    else if score < sx and score >= sv
        rating := f_attributePercentile(score, sx, sv, 9, 2, 0)
    rating

bool isRatingValid = true
for i = 0 to 6 by 1
    if nz(array.get(different_values, i)) == 0 and not allowReplay
        isRatingValid := false

ratingToday  = isRatingValid ? f_calculateRating(totalRsScore, first, scnd, thrd, frth, ffth, sxth, svth) : -1
rating5dAgo  = isRatingValid ? f_calculateRating(totalRsScore[5], first, scnd, thrd, frth, ffth, sxth, svth) : -1
rating20dAgo = isRatingValid ? f_calculateRating(totalRsScore[20], first, scnd, thrd, frth, ffth, sxth, svth) : -1

ratingChange1w = (ratingToday != -1 and rating5dAgo != -1) ? (ratingToday - rating5dAgo) : na
ratingChange1m = (ratingToday != -1 and rating20dAgo != -1) ? (ratingToday - rating20dAgo) : na

// Fetch daily ratings when on non-daily charts
[t_t, t_3m, t_6m, t_1w, t_1m] = request.security(syminfo.tickerid, 'D', [ratingToday, rsRating3m, rsRating6m, ratingChange1w, ratingChange1m])

rToday  = timeframe.isdaily ? ratingToday : t_t
r3m     = timeframe.isdaily ? rsRating3m : t_3m
r6m     = timeframe.isdaily ? rsRating6m : t_6m
r1w     = timeframe.isdaily ? ratingChange1w : t_1w
r1m     = timeframe.isdaily ? ratingChange1m : t_1m

// Plot RS Rating Labels on Chart
labelText1 = ''
labelText2 = ''
if (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and rToday != -1
    labelText2 := '\n\n       ' + str.tostring(rToday, '#0')
if ratingOnly
    labelText1 := ''
    labelText2 := '\n    ' + str.tostring(rToday, '#0')

label1 = hideRSRat == false and barstate.islast ? label.new(bar_index, rs, text = labelText1, color = color.rgb(0, 0, 0, 100), size = size.normal, textcolor = colorRS, style = label.style_label_center, textalign = text.align_left, yloc = yloc.price) : na
label2 = hideRSRat == false and barstate.islast ? label.new(bar_index, rs, text = labelText2, color = color.rgb(0, 0, 0, 100), size = size.large, textcolor = colorRS, style = label.style_label_center, textalign = text.align_left, yloc = yloc.price) : na

label.delete(label1[1])
label.delete(label2[1])

f_getChangeText(val) =>
    na(val) ? 'N/A' : (val > 0 ? '+' : '') + str.tostring(val, '#0')

f_getChangeColor(val) =>
    na(val) ? color.white : (val > 0 ? color.green : val < 0 ? color.red : color.white)



// ── RS Trendline Calculation & Drawing ───────────────────────────────────────
ph = ta.pivothigh(rs, tlBars, tlBars)
var piv = pivData.new(na, na)
var label boLab = na
var trendLines = array.new<trendLine>()
touches = 0
bo = 0

if showTrendlines
    if not na(ph) and (na(piv.h) or rs[tlBars] > piv.h or bar_index - piv.b > tlNewH)
        piv.h := rs[tlBars]
        piv.b := bar_index[tlBars]

    if rs < piv.h
        tl = line.new(piv.b, piv.h, bar_index, rs, extend = extend.right, color = color.new(color.white,100), width = tlWidth)
        for i = 0 to bar_index - piv.b
            if rs[i] > tl.get_price(bar_index[i]) * (1+tlBuffer)
                tl.delete()
                touches := 0
                break
            else if rs[i] <= tl.get_price(bar_index[i]) * (1 + tlBuffer) and rs[i] >= tl.get_price(bar_index[i]) * (1 - tlBuffer)
                touches += 1
        if touches >= tlNumTouches
            tl.set_color(tlCol)
            trendLines.push(trendLine.new(tl, bar_index))
            if trendLines.size() > tlShowNum
                old = trendLines.shift()
                old.tl.delete()
        else
            tl.delete()
        if trendLines.size() > 1
            current = trendLines.last()
            for [idx,t] in trendLines
                if t.tl.get_price(piv.b) == current.tl.get_price(piv.b) and idx != trendLines.size()-1
                    t.tl.delete()
                    trendLines.remove(idx)

    for tl in trendLines
        if tl.active
            if not tlExt
                extended = tl.tl.get_price(bar_index+1)
                tl.tl.set_extend(extend.none)
                tl.tl.set_xy2(bar_index+1, extended)
            for i = 0 to bar_index - tl.lastB
                if rs[i] > tl.tl.get_price(bar_index[i]) * (1+tlBuffer)
                    bo := 1
                    tl.active := false
                    break

    if bo == 1 
        if tlShowBo
            label.delete(boLab)
            boLab := label.new(bar_index, rs, style = label.style_triangleup, size = size.auto, color = tlBoCol)

alertcondition(bo == 1, 'RS Trendline Breakout', 'RS Trendline Breakout')
alertcondition(touches >= tlNumTouches and touches[1] < tlNumTouches, 'RS Trendline Found', 'New RS Trendline')

// ── RS Pattern Recognition (Base & Cup) ───────────────────────────────────────
var array<float> aHP = array.new_float()   // pivot high prices
var array<float> aLP = array.new_float()   // pivot low prices
var array<int>   aHB = array.new_int()     // pivot high bar indices
var array<int>   aLB = array.new_int()     // pivot low bar indices

float _pH = ta.pivothigh(rs, i_pivLen, i_pivLen)
float _pL = ta.pivotlow (rs,  i_pivLen, i_pivLen)

if not na(_pH)
    array.unshift(aHP, rs[i_pivLen])
    array.unshift(aHB, bar_index[i_pivLen])
if not na(_pL)
    array.unshift(aLP, rs[i_pivLen])
    array.unshift(aLB, bar_index[i_pivLen])

// Derived Constants
int barsPerWeek = timeframe.isweekly ? 1 : 5
int pivLag      = 5 * barsPerWeek
int win13wk     = 13 * barsPerWeek
int win20wk     = 20 * barsPerWeek
int win10wk     = 10 * barsPerWeek

float bdF   = i_baseDepth / 100.0
int   bLenB = i_baseLen * barsPerWeek

// Pre-computed TA for RS series
float H25    = ta.highest(rs, pivLag)
float L25    = ta.lowest (rs,  pivLag)
float L103   = ta.lowest (rs,  win20wk + (timeframe.isweekly ? 1 : 3))
float H65s   = ta.highest(rs, win13wk)[pivLag + 1]

// Base Detection state variables
var float bTop   = na
var float bLow   = na
var int   bStart = na
var bool  isBase = false
var int   bCount = 0
var bool  isCup = false
bool      isFlatBase = false

bool newBase = false

if showPatterns and array.size(aHP) > 2
    bool _bH   = rs[pivLag] == array.get(aHP, 0) or
                 rs[pivLag] == array.get(aHP, 1) or
                 rs[pivLag] == array.get(aHP, 2)
    bool _bPH  = rs[pivLag] > H65s or (not na(bTop) and rs[pivLag] > bTop)
    bool _lUp  = (not i_requirePriorUptrend) or (L103 * 1.20 <= rs[pivLag])
    bool _dep  = rs[pivLag] * (1 - bdF) <= L25
    bool _noAb = H25 <= rs[pivLag]
    bool _noNe = isBase[pivLag] == false
    newBase   := _bH and _bPH and _lUp and _dep and _noAb and _noNe

if showPatterns
    if newBase and not isBase[1]
        bTop     := rs[pivLag]
        bLow     := L25
        bStart   := bar_index[pivLag]
        bCount   := pivLag
        isBase   := true
    
    if not newBase and isBase[1]
        isBase   := true
    
    if isBase
        bCount   := bCount + 1
    
    if isBase and rs < bLow and rs >= bTop * (1 - bdF)
        bLow := rs
    
    if isBase and (rs < bTop * (1 - bdF) or bCount > bLenB)
        isBase := false

    // Breakout detection
    bool rsPatternBreakout = isBase[1] and not na(bTop) and rs > bTop

    if rsPatternBreakout
        isBase := false

    // Classification
    float bDepPct = not na(bTop) and bTop > 0 and not na(bLow) ? (bTop - bLow) / bTop * 100 : na
    isFlatBase := isBase and not na(bDepPct) and bDepPct <= 15.0

    // Cup shape check
    bool detectCup = false
    int minCupLen = 6 * barsPerWeek
    if isBase and not na(bTop) and not na(bLow) and bCount >= minCupLen
        float mid  = bLow + (bTop - bLow) * 0.5
        int   tier = math.max(1, bCount / 3)
        bool depOk = bLow >= (1 - bdF) * bTop and bLow <= 0.92 * bTop
        bool lenOk = bCount <= bLenB
        bool posOk = mid <= rs
        
        int nV1 = 0
        int maxLoop1 = math.min(bar_index, bCount)
        if maxLoop1 >= 2 * tier
            for i = maxLoop1 to 2 * tier by 1
                if not na(rs[i]) and rs[i] >= mid
                    nV1 := nV1 + 1
        
        int nV2 = 0
        int maxLoop2 = math.min(bar_index, bCount - tier)
        if maxLoop2 >= tier
            for i = maxLoop2 to tier by 1
                if not na(rs[i]) and rs[i] <= mid
                    nV2 := nV2 + 1
        
        bool cT  = float(nV2) / float(tier) >= 0.85
        bool cT2 = float(nV1) / float(tier) >= 0.30
        detectCup := depOk and lenOk and posOk and cT and cT2

    if detectCup or isCup[1]
        isCup := true
    if not isBase
        isCup := false

    // Drawing
    var line rsHighLine = na
    var line rsLowLine = na

    color currentTopColor = isCup ? colCupTop : isFlatBase ? colFlatTop : colBaseTop
    color currentBotColor = isCup ? colCupBot : isFlatBase ? colFlatBot : colBaseBot

    if isBase
        if not isBase[1] or newBase
            line.delete(rsHighLine)
            line.delete(rsLowLine)
            rsHighLine := line.new(x1 = bStart, y1 = bTop, x2 = bar_index, y2 = bTop, color = currentTopColor, width = 2, style = line.style_dashed)
            rsLowLine  := line.new(x1 = bStart, y1 = bLow, x2 = bar_index, y2 = bLow, color = currentBotColor, width = 2, style = line.style_solid)
        else
            line.set_x2(rsHighLine, bar_index)
            line.set_x2(rsLowLine, bar_index)
            line.set_y1(rsLowLine, bLow)
            line.set_y2(rsLowLine, bLow)
            line.set_color(rsHighLine, currentTopColor)
            line.set_color(rsLowLine, currentBotColor)

    // Breakout Label
    if rsPatternBreakout
        label.new(bar_index, rs, text = isCup[1] ? "RS Cup BO" : isFlatBase[1] ? "RS Flat BO" : "RS Base BO", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

    // alertcondition(rsPatternBreakout, 'RS Base Breakout', 'RS base breakout triggered')

// ── RS/Price Bullish Divergence Detection ────────────────────────────────────
// Find pivot lows for Price
float prPivotLow = ta.pivotlow(low, i_pivLen, i_pivLen)

// Track values at confirmed pivot lows (i_pivLen bars ago)
float rsPl        = ta.valuewhen(not na(_pL), rs[i_pivLen], 0)
float prevRsPl    = ta.valuewhen(not na(_pL), rs[i_pivLen], 1)
float pricePl     = ta.valuewhen(not na(prPivotLow), low[i_pivLen], 0)
float prevPricePl = ta.valuewhen(not na(prPivotLow), low[i_pivLen], 1)

bool isBullDiv = not na(_pL) and not na(prPivotLow) and (rsPl > prevRsPl) and (pricePl < prevPricePl)


if showDivergence and isBullDiv
    label.new(x = bar_index[i_pivLen], y = rs[i_pivLen], text = "Bull Div", 
              style = label.style_label_down, color = colBullDiv, textcolor = color.white, size = size.small)

// ── Dashboard Table UI ────────────────────────────────────────────────────────
var table infoTable = na
if showDashboard and barstate.islast
    posTable = dashLocation == 'Top Right' ? position.top_right :
               dashLocation == 'Bottom Right' ? position.bottom_right :
               dashLocation == 'Top Left' ? position.top_left :
               position.bottom_left
               
    infoTable := table.new(position = posTable, columns = 2, rows = 7, 
                           bgcolor = color.new(color.black, 20), 
                           border_width = 1, border_color = color.gray)
    
    // Header
    table.cell(infoTable, 0, 0, 'RS Metric', text_color=color.white, text_size=size.small, bgcolor=color.rgb(24, 140, 202))
    table.cell(infoTable, 1, 0, 'Value', text_color=color.white, text_size=size.small, bgcolor=color.rgb(24, 140, 202))
    
    // Rows
    table.cell(infoTable, 0, 1, 'RS Rating (12M)', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, rToday == -1 ? 'N/A' : str.tostring(rToday, '#0'), 
               text_color = rToday >= 90 ? color.green : rToday >= 70 ? color.yellow : color.white, 
               text_size=size.small)
               
    table.cell(infoTable, 0, 2, 'RS Rating (6M)', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, r6m == -1 ? 'N/A' : str.tostring(r6m, '#0'), 
               text_color = r6m >= 90 ? color.green : r6m >= 70 ? color.yellow : color.white, 
               text_size=size.small)
               
    table.cell(infoTable, 0, 3, 'RS Rating (3M)', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, r3m == -1 ? 'N/A' : str.tostring(r3m, '#0'), 
               text_color = r3m >= 90 ? color.green : r3m >= 70 ? color.yellow : color.white, 
               text_size=size.small)

    // 1W Change
    table.cell(infoTable, 0, 4, 'RS Rating (1W Change)', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, f_getChangeText(r1w), text_color=f_getChangeColor(r1w), text_size=size.small)

    // 1M Change
    table.cell(infoTable, 0, 5, 'RS Rating (1M Change)', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, f_getChangeText(r1m), text_color=f_getChangeColor(r1m), text_size=size.small)

    // Current State
    int barsSinceNH = ta.barssince(rs_nh_any)
    int barsSinceNL = ta.barssince(rs_nl)
    
    currentState = rs_nh_any ? 'New High (' + rs_nh_period + ')' : 
                   rs_nl ? 'New Low' : 
                   (barsSinceNH >= 0 and barsSinceNH < 5) ? 'New High (Recent)' : 
                   (barsSinceNL >= 0 and barsSinceNL < 5) ? 'New Low (Recent)' : 
                   isCup ? 'Cup Base' : 
                   isFlatBase ? 'Flat Base' : 
                   isBase ? 'In Base' : 
                   'Neutral'
                   
    stateColor = (rs_nh_any or (barsSinceNH >= 0 and barsSinceNH < 5) or isCup or isFlatBase) ? color.green : 
                 (rs_nl or (barsSinceNL >= 0 and barsSinceNL < 5)) ? color.red : 
                 isBase ? color.gray : 
                 color.white
                 
    table.cell(infoTable, 0, 6, 'RS State', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, currentState, text_color=stateColor, text_size=size.small)




