declare upper;

# ──────────────────────────────────────────────────────────────────────────────
# HELPER FUNCTIONS
# ──────────────────────────────────────────────────────────────────────────────
script PivotHigh {
    input price = high;
    input leftLen = 9;
    input rightLen = 9;
    input instance = 1;
    def isPivot = price[rightLen] >= Highest(price[rightLen + 1], leftLen) and price[rightLen] > Highest(price, rightLen);
    plot Pivot = if isPivot then price[rightLen] else Double.NaN;
}

script PivotLow {
    input price = low;
    input leftLen = 9;
    input rightLen = 9;
    input instance = 1;
    def isPivot = price[rightLen] <= Lowest(price[rightLen + 1], leftLen) and price[rightLen] < Lowest(price, rightLen);
    plot Pivot = if isPivot then price[rightLen] else Double.NaN;
}

# ──────────────────────────────────────────────────────────────────────────────
# GLOBAL COLORS
# ──────────────────────────────────────────────────────────────────────────────
DefineGlobalColor("PosCandle", CreateColor(39, 54, 233));   # Positive Candle (Blue)
DefineGlobalColor("NegCandle", CreateColor(222, 50, 174));  # Negative Candle (Pink)
DefineGlobalColor("HVWPFP",    Color.YELLOW);                # Heavy Vol No Progress / Distribution
DefineGlobalColor("CompBase", Color.CYAN);
DefineGlobalColor("PartBase", Color.MAGENTA);
DefineGlobalColor("HalfBase", Color.YELLOW);
DefineGlobalColor("Cup",      CreateColor(146, 193, 131));
DefineGlobalColor("Flat",     CreateColor(255, 165, 0));
DefineGlobalColor("DB",       CreateColor(0, 200, 255));
DefineGlobalColor("HTF",      CreateColor(200, 60, 255));
DefineGlobalColor("Entry",    CreateColor(0, 122, 255));
DefineGlobalColor("Stop",     CreateColor(255, 59, 48));
DefineGlobalColor("Tgt",      CreateColor(52, 199, 89));

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 1: BARS & CANDLE COLORING (HVWPFP Distribution Highlight)
# ──────────────────────────────────────────────────────────────────────────────
input PaintBars                   = yes;
input ColorBasedOnPrevClose       = yes;
input HighlightHeavyVolNoProgress = yes;
input VolMultiplier               = 1.1;   # Volume must be x times higher than avg
input VolMaLength                 = 20;    # Volume MA Length
input MaxPriceProgressPct         = 0.9;   # Max price change % to consider no progress
input RecentHighLookback          = 20;    # Recent high lookback for distribution near high

def avgVol20 = Average(volume, VolMaLength);
def isHeavyVol = volume >= (avgVol20 * VolMultiplier);
def priceChangePct = if close[1] != 0 then (close - close[1]) / close[1] * 100 else 0;
def isMinimalProgress = AbsValue(priceChangePct) <= MaxPriceProgressPct;
def recentHigh20 = Highest(high, RecentHighLookback);
def isNearHigh = close >= (recentHigh20 * 0.95);

def isHVWPFP = HighlightHeavyVolNoProgress and isHeavyVol and isMinimalProgress and isNearHigh;
def isUpCandle = if ColorBasedOnPrevClose then close >= close[1] else close >= open;

AssignPriceColor(
    if !PaintBars then Color.CURRENT
    else if isHVWPFP then GlobalColor("HVWPFP")
    else if isUpCandle then GlobalColor("PosCandle")
    else GlobalColor("NegCandle")
);

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 2: MOVING AVERAGES (Daily & Weekly)
# ──────────────────────────────────────────────────────────────────────────────
input ShowDailyMAs  = yes;
input ShowWeeklyMAs = yes;

def isWeekly = GetAggregationPeriod() >= AggregationPeriod.WEEK;

# Daily Moving Averages (10 EMA, 21 EMA, 50 SMA, 200 SMA)
plot DailyMA10 = if !isWeekly and ShowDailyMAs then ExpAverage(close, 10) else Double.NaN;
plot DailyMA21 = if !isWeekly and ShowDailyMAs then ExpAverage(close, 21) else Double.NaN;
plot DailyMA50 = if !isWeekly and ShowDailyMAs then SimpleMovingAvg(close, 50) else Double.NaN;
plot DailyMA200 = if !isWeekly and ShowDailyMAs then SimpleMovingAvg(close, 200) else Double.NaN;

DailyMA10.SetDefaultColor(CreateColor(240, 141, 240));
DailyMA21.SetDefaultColor(CreateColor(68, 186, 76));
DailyMA50.SetDefaultColor(CreateColor(255, 33, 33));
DailyMA200.SetDefaultColor(Color.BLACK);
DailyMA200.SetLineWeight(2);

# Weekly Moving Averages (10 SMA, 20 EMA, 30 SMA, 40 SMA)
plot WeeklyMA10 = if isWeekly and ShowWeeklyMAs then SimpleMovingAvg(close, 10) else Double.NaN;
plot WeeklyMA20 = if isWeekly and ShowWeeklyMAs then ExpAverage(close, 20) else Double.NaN;
plot WeeklyMA30 = if isWeekly and ShowWeeklyMAs then SimpleMovingAvg(close, 30) else Double.NaN;
plot WeeklyMA40 = if isWeekly and ShowWeeklyMAs then SimpleMovingAvg(close, 40) else Double.NaN;

WeeklyMA10.SetDefaultColor(CreateColor(255, 33, 33));
WeeklyMA20.SetDefaultColor(CreateColor(240, 141, 240));
WeeklyMA30.SetDefaultColor(CreateColor(68, 186, 76));
WeeklyMA40.SetDefaultColor(Color.BLACK);
WeeklyMA40.SetLineWeight(2);

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 3: CHART PATTERN RECOGNITION INPUTS
# ──────────────────────────────────────────────────────────────────────────────
input ShowPattern                = yes;
input ShowTradeBoxes             = yes;
input ShowDetectionLabel         = yes;
input ShowStatusLabels           = yes;

# Base Parameters
input BaseDepthPct               = 35.0;  # Base Depth % (35% to 50%)
input BaseLengthWeeks            = 65;    # Length (Weeks)

# Double Bottom Parameters
input DBDepthPct                 = 50.0;  # Double Bottom Depth %
input DBLengthWeeks              = 65;    # DB Length (Weeks)
input DBMinPriorUptrendPct       = 15.0;  # Minimum prior uptrend % for Double Bottom
input DBMinLengthWeeks           = 7;     # Minimum total length in weeks for DB (7 weeks = 35 daily bars)
input DBRequireUndercut          = yes;   # If enabled, 2nd bottom low must undercut 1st bottom low

# Cup & Handle Parameters
input ShowCupHandle              = yes;
input HandleMinBars              = 5;     # Min handle length
input HandleMaxBars              = 25;    # Max handle length
input HandleMaxDeclinePct        = 12.0;  # Max decline % in handle
input HandleMinHeightPct         = 60.0;  # Handle min peak height %
input UseVolHandle               = yes;   # Require volume contraction during handle & expansion on breakout
input RequireCupForHandle        = yes;   # Handle must form in cup or double bottom
input HandleVolMaLength          = 50;    # Vol MA length for handle
input HandleMaxVolContractionPct = 50.0;  # Max Avg Vol % in handle vs MA
input HandleBreakoutVolMult      = 1.5;   # Breakout Bar Vol Multiplier vs MA

# High Tight Flag Parameters
input EnableHTF                  = yes;
input HTFMaxFlagDepthPct         = 25.0;  # Max flag depth % (pullback <= 25%)
input HTFMaxFlagBars             = 20;    # Max flag length (bars)
input HTFMinFlagBars             = 6;     # Min flag length (bars)
input HTFPriorUptrendMinPct       = 80.0;  # Flagpole prior uptrend min %
input HTFMaxPoleBars             = 40;    # Max flagpole length (bars)
input HTFMinPoleBars             = 5;     # Min flagpole length (bars)
input HTFBreakoutVolMult         = 1.1;   # Breakout volume multiplier

# ──────────────────────────────────────────────────────────────────────────────
# SECTION 4: PATTERN RECOGNITION ENGINE
# ──────────────────────────────────────────────────────────────────────────────
def bn = BarNumber();
def minLenBars = if isWeekly then Max(1, Ceil(BaseLengthWeeks / 5)) else BaseLengthWeeks * 5;
def dbMinBars  = if isWeekly then Max(1, Ceil(DBMinLengthWeeks)) else DBMinLengthWeeks * 5;
def hMinBars   = if isWeekly then Max(1, Ceil(HandleMinBars / 5)) else HandleMinBars;
def hMaxBars   = if isWeekly then Max(1, Ceil(HandleMaxBars / 5)) else HandleMaxBars;
def htfMinBars = if isWeekly then Max(1, Ceil(HTFMinFlagBars / 5)) else HTFMinFlagBars;
def htfMaxBars = if isWeekly then Max(1, Ceil(HTFMaxFlagBars / 5)) else HTFMaxFlagBars;
def htfPoleMax = if isWeekly then Max(1, Ceil(HTFMaxPoleBars / 5)) else HTFMaxPoleBars;

# Pivot Highs & Lows (pivot length = 9)
def pivHigh = PivotHigh(high, 9, 9, 9);
def pivLow  = PivotLow(low, 9, 9, 9);
def isPivHigh = !IsNaN(pivHigh);
def isPivLow  = !IsNaN(pivLow);

rec pivH1 = if isPivHigh then high[9] else pivH1[1];
rec pivH2 = if isPivHigh then pivH1[1] else pivH2[1];
rec pivH1Bar = if isPivHigh then bn[9] else pivH1Bar[1];
rec pivH2Bar = if isPivHigh then pivH1Bar[1] else pivH2Bar[1];

rec pivL1 = if isPivLow then low[9] else pivL1[1];
rec pivL2 = if isPivLow then pivL1[1] else pivL2[1];
rec pivL1Bar = if isPivLow then bn[9] else pivL1Bar[1];
rec pivL2Bar = if isPivLow then pivL1Bar[1] else pivL2Bar[1];

# Base Locator Condition
def high25 = GetValue(high, 25);
def highestBase = Highest(high, 25);
def lowestBaseLow = Lowest(low, 25);
def prior65High = GetValue(Highest(high, 65), 26);

def lowestIPOLeg  = Lowest(low[25], 103);

def isPivHighAt25 = high25 == pivH1 or high25 == pivH2;
def is13WkHigh = high25 >= prior65High;
def legUpCond = high25 >= lowestIPOLeg * 1.20;
def depthCond = high25 * (1 - BaseDepthPct / 100) <= lowestBaseLow;
def noCandleAbove = highestBase <= high25;

rec isBase;
rec startBasePrice;
rec startBaseBar;
rec lowBasePrice;
rec lowerBaseBar;
rec baseCount;

def noBaseInBase = !isBase[25];
def noSameBase = (bn - 25) > startBaseBar[1] or startBaseBar[1] == 0;

def baseCond = isPivHighAt25 and is13WkHigh and legUpCond and depthCond and noCandleAbove and noBaseInBase and noSameBase;

if bn == 1 {
    isBase = no;
    startBasePrice = 0;
    startBaseBar = 0;
    lowBasePrice = 0;
    lowerBaseBar = 0;
    baseCount = 0;
} else if baseCond and !isBase[1] {
    isBase = yes;
    startBasePrice = high25;
    startBaseBar = bn - 25;
    lowBasePrice = lowestBaseLow;
    lowerBaseBar = bn - GetValue(GetMinValueOffset(low, 25), 0);
    baseCount = 25;
} else if isBase[1] {
    if low < lowBasePrice[1] {
        isBase = yes;
        startBasePrice = startBasePrice[1];
        startBaseBar = startBaseBar[1];
        lowBasePrice = low;
        lowerBaseBar = bn;
        baseCount = baseCount[1] + 1;
    } else if (low < startBasePrice[1] * (1 - BaseDepthPct / 100) or baseCount[1] > minLenBars) {
        isBase = no;
        startBasePrice = 0;
        startBaseBar = startBaseBar[1];
        lowBasePrice = 0;
        lowerBaseBar = 0;
        baseCount = 0;
    } else if high > startBasePrice[1] {
        isBase = no;
        startBasePrice = 0;
        startBaseBar = startBaseBar[1];
        lowBasePrice = 0;
        lowerBaseBar = 0;
        baseCount = 0;
    } else {
        isBase = yes;
        startBasePrice = startBasePrice[1];
        startBaseBar = startBaseBar[1];
        lowBasePrice = lowBasePrice[1];
        lowerBaseBar = lowerBaseBar[1];
        baseCount = baseCount[1] + 1;
    }
} else {
    isBase = no;
    startBasePrice = 0;
    startBaseBar = startBaseBar[1];
    lowBasePrice = 0;
    lowerBaseBar = 0;
    baseCount = 0;
}

# ──────────────────────────────────────────────────────────────────────────────
# CUP PATTERN DETECTION
# ──────────────────────────────────────────────────────────────────────────────
def highCup = startBasePrice;
def lowCup = lowBasePrice;
def cupDepth = if highCup > 0 then (highCup - lowCup) / highCup else 0;
def middleOfCup = lowCup + (highCup - lowCup) * 0.5;

def condCupMaxDepth = lowCup >= (1 - BaseDepthPct / 100) * highCup;
def condCupMinDepth = lowCup <= 0.92 * highCup;
def condCupMaxLength = baseCount <= minLenBars;
def condCupMinLength = baseCount >= 30;
def condCupAbsPos   = high >= middleOfCup;

def bTier = Max(1, Floor(baseCount / 3));
def bFourth = Max(1, Floor(baseCount / 4));

def closesBelowMidInTier = fold i1 = 0 to 200 with c1 = 0 do
    c1 + (if i1 >= bTier and i1 <= baseCount - bTier and GetValue(close, i1) <= middleOfCup then 1 else 0);

def closesAboveMidInFourth = fold i2 = 0 to 200 with c2 = 0 do
    c2 + (if i2 >= 3 * bFourth and i2 <= baseCount and GetValue(close, i2) >= middleOfCup then 1 else 0);

def condThird = if bTier > 0 then (closesBelowMidInTier / bTier) >= 0.90 else no;
def condThirdTwo = if bFourth > 0 then (closesAboveMidInFourth / bFourth) >= 0.30 else no;
def cupForm = condThird and condThird[1] and condThirdTwo and condThirdTwo[1];

def detectCup = isBase and condCupMaxDepth and condCupMinDepth and condCupMaxLength and condCupMinLength and condCupAbsPos and cupForm;

rec isCup;
if bn == 1 {
    isCup = no;
} else if detectCup or isCup[1] {
    isCup = if isBase then yes else no;
} else {
    isCup = no;
}

# ──────────────────────────────────────────────────────────────────────────────
# DOUBLE BOTTOM PATTERN DETECTION (with Undercut logic)
# ──────────────────────────────────────────────────────────────────────────────
def firstPivHigh = pivH2;
def scndPivHigh  = pivH1;
def firstPivLow  = pivL2;
def scndPivLow   = pivL1;

def priorLow250 = Lowest(low, 250);
def condDBPriorTrend = firstPivHigh >= priorLow250 * (1.0 + DBMinPriorUptrendPct / 100.0);

def condDBPricesA = if DBRequireUndercut then scndPivLow < firstPivLow else scndPivLow <= firstPivLow;
def condDBPricesB = scndPivLow >= (1 - DBDepthPct / 100) * firstPivHigh and firstPivLow >= (1 - DBDepthPct / 100) * firstPivHigh;
def condDBPricesC = scndPivLow <= firstPivHigh * 0.90;
def condDBPricesD = scndPivHigh >= scndPivLow + (firstPivHigh - scndPivLow) * 0.35;
def condDBPricesE = scndPivHigh < firstPivHigh * 1.01;
def condDBPricesF = scndPivHigh >= firstPivLow + (firstPivHigh - firstPivLow) * 0.40;

def firstLegDepth = firstPivHigh - firstPivLow;
def scndLegDepth  = scndPivHigh  - scndPivLow;
def condDBPricesG = firstLegDepth > 0 and scndLegDepth > 0 and (firstLegDepth / scndLegDepth <= 3.0) and (scndLegDepth / firstLegDepth <= 3.0);

def firstPivTime = pivH2Bar;
def scndPivTime  = pivL2Bar;
def thrdPivTime  = pivH1Bar;
def frthPivTime  = pivL1Bar;

def condDBTimeA = firstPivTime < scndPivTime and scndPivTime < thrdPivTime and thrdPivTime < frthPivTime;
def condDBTimeB = frthPivTime - firstPivTime <= BaseLengthWeeks * 5;
def condDBTimeC = (bn - firstPivTime) >= dbMinBars;
def condDBTimeD = (scndPivTime - firstPivTime) >= 3 and (thrdPivTime - scndPivTime) >= 3 and (frthPivTime - thrdPivTime) >= 3;

def detectDoubleBottom = isBase and condDBPriorTrend and condDBPricesA and condDBPricesB and condDBPricesC and condDBPricesD and condDBPricesE and condDBPricesF and condDBPricesG and condDBTimeA and condDBTimeB and condDBTimeC and condDBTimeD;

rec isDoubleBottom;
if bn == 1 {
    isDoubleBottom = no;
} else if detectDoubleBottom or isDoubleBottom[1] {
    if low < scndPivLow and isDoubleBottom[1] {
        isDoubleBottom = no;
    } else if bn - thrdPivTime > BaseLengthWeeks * 5 {
        isDoubleBottom = no;
    } else {
        isDoubleBottom = if isBase then yes else no;
    }
} else {
    isDoubleBottom = no;
}

# ──────────────────────────────────────────────────────────────────────────────
# CUP-WITH-HANDLE PATTERN DETECTION (with Volume Contraction)
# ──────────────────────────────────────────────────────────────────────────────
def rightSide = isBase and bn > lowerBaseBar;

rec rightSideHighClose;
if !rightSide {
    rightSideHighClose = 0;
} else if close > rightSideHighClose[1] and close <= startBasePrice {
    rightSideHighClose = close;
} else {
    rightSideHighClose = rightSideHighClose[1];
}

def handlePeakTol = 1.05;
rec handlePeakBar;
if !rightSide or rightSideHighClose == 0 {
    handlePeakBar = 0;
} else if close > rightSideHighClose[1] * handlePeakTol and close <= startBasePrice {
    handlePeakBar = bn;
} else {
    handlePeakBar = handlePeakBar[1];
}

def handleBarCount = if rightSide and handlePeakBar > 0 then bn - handlePeakBar else 0;

rec handlePeakLocked;
if !rightSide or rightSideHighClose == 0 {
    handlePeakLocked = 0;
} else if handleBarCount == 0 {
    handlePeakLocked = rightSideHighClose;
} else {
    handlePeakLocked = handlePeakLocked[1];
}

rec handleLowPoint;
if !rightSide or handlePeakLocked == 0 {
    handleLowPoint = 0;
} else if low < handleLowPoint[1] or handleLowPoint[1] == 0 {
    handleLowPoint = low;
} else {
    handleLowPoint = handleLowPoint[1];
}

def handleDepthOK = handleLowPoint >= handlePeakLocked * (1.0 - HandleMaxDeclinePct / 100);
def handleMidOK   = handleLowPoint > (startBasePrice + lowBasePrice) * 0.5;

def volMaHandle = Average(volume, HandleVolMaLength);
def handleVolSum = fold hv = 0 to 25 with hvs = 0 do hvs + (if hv < handleBarCount then GetValue(volume, hv) else 0);
def volAvgHandle = if handleBarCount > 0 then handleVolSum / handleBarCount else volMaHandle;

def volContractionOK = !UseVolHandle or (handleBarCount > 0 and volAvgHandle <= volMaHandle * HandleMaxVolContractionPct / 100);
def requireCupOK     = !RequireCupForHandle or isCup or isDoubleBottom;

def handleForming = ShowCupHandle and rightSide and handlePeakLocked > 0 and handleBarCount >= hMinBars and handleBarCount <= hMaxBars and handleDepthOK and handleMidOK and volContractionOK and requireCupOK;

def volBreakoutOK = !UseVolHandle or volume >= HandleBreakoutVolMult * volMaHandle;
def handleBreakout = handleForming and close > handlePeakLocked and volBreakoutOK;

# ──────────────────────────────────────────────────────────────────────────────
# HIGH TIGHT FLAG (HTF) DETECTION
# ──────────────────────────────────────────────────────────────────────────────
def htfPoleLow = if isWeekly then Lowest(low, 8) else Lowest(low, 40);
def htfPoleGain = if htfPoleLow > 0 then (high - htfPoleLow) / htfPoleLow * 100 else 0;
def htfGainOK   = htfPoleGain >= HTFPriorUptrendMinPct;
def htfFreshHi  = high >= Highest(high, 65);
def htfNewPole  = EnableHTF and htfGainOK and htfFreshHi;

rec htfTop;
rec htfAge;
rec htfLowPt;

if htfNewPole {
    htfTop   = high;
    htfAge   = 0;
    htfLowPt = high;
} else if htfTop[1] > 0 and htfAge[1] < htfMaxBars and low >= htfTop[1] * (1.0 - HTFMaxFlagDepthPct / 100) and high <= htfTop[1] {
    htfTop   = htfTop[1];
    htfAge   = htfAge[1] + 1;
    htfLowPt = Min(htfLowPt[1], low);
} else {
    htfTop   = 0;
    htfAge   = 0;
    htfLowPt = 0;
}

def htfFlagForming = htfTop > 0 and htfAge >= htfMinBars and htfAge <= htfMaxBars;
def htfDetected    = htfFlagForming and !htfFlagForming[1];
def htfBreakoutVolOK = volume >= Average(volume, 20) * HTFBreakoutVolMult;
def htfBreakout    = htfTop[1] > 0 and htfAge[1] >= htfMinBars and close > htfTop[1] and htfBreakoutVolOK;

# ──────────────────────────────────────────────────────────────────────────────
# TRADE BOXES & CLOUDS
# ──────────────────────────────────────────────────────────────────────────────
def activePivot = if handleBreakout then handlePeakLocked
                  else if isDoubleBottom and close > scndPivHigh then scndPivHigh
                  else startBasePrice;

rec tradePivotPx;
rec tradeBars;
if bn == 1 {
    tradePivotPx = 0;
    tradeBars = 0;
} else if (detectCup or handleBreakout or detectDoubleBottom or htfBreakout) and tradePivotPx[1] == 0 {
    tradePivotPx = activePivot;
    tradeBars = 1;
} else if tradePivotPx[1] > 0 and tradeBars[1] < 15 and high <= tradePivotPx[1] * 1.25 and low >= tradePivotPx[1] * 0.92 {
    tradePivotPx = tradePivotPx[1];
    tradeBars = tradeBars[1] + 1;
} else {
    tradePivotPx = 0;
    tradeBars = 0;
}

def tradeActive = tradePivotPx > 0;

plot EntryZoneHi = if ShowTradeBoxes and tradeActive then tradePivotPx * 1.05 else Double.NaN;
plot EntryZoneLo = if ShowTradeBoxes and tradeActive then tradePivotPx * 1.00 else Double.NaN;
plot StopLossHi  = if ShowTradeBoxes and tradeActive then tradePivotPx * 0.95 else Double.NaN;
plot StopLossLo  = if ShowTradeBoxes and tradeActive then tradePivotPx * 0.92 else Double.NaN;
plot TargetZoneHi = if ShowTradeBoxes and tradeActive then tradePivotPx * 1.25 else Double.NaN;
plot TargetZoneLo = if ShowTradeBoxes and tradeActive then tradePivotPx * 1.20 else Double.NaN;

EntryZoneHi.Hide(); EntryZoneLo.Hide();
StopLossHi.Hide(); StopLossLo.Hide();
TargetZoneHi.Hide(); TargetZoneLo.Hide();

AddCloud(EntryZoneHi, EntryZoneLo, GlobalColor("Entry"), GlobalColor("Entry"));
AddCloud(StopLossHi,  StopLossLo,  GlobalColor("Stop"),  GlobalColor("Stop"));
AddCloud(TargetZoneHi, TargetZoneLo, GlobalColor("Tgt"),   GlobalColor("Tgt"));

# ──────────────────────────────────────────────────────────────────────────────
# BASE ACCUMULATION / DISTRIBUTION COUNTING
# ──────────────────────────────────────────────────────────────────────────────
def baseDaysCount = if isBase then baseCount else 0;

def accDays = fold a_i = 0 to 200 with a_c = 0 do
    a_c + (if a_i < baseDaysCount and GetValue(close, a_i) > GetValue(close, a_i + 1) and GetValue(volume, a_i) > GetValue(volume, a_i + 1) then 1 else 0);

def disDays = fold d_i = 0 to 200 with d_c = 0 do
    d_c + (if d_i < baseDaysCount and GetValue(close, d_i) < GetValue(close, d_i + 1) and GetValue(volume, d_i) > GetValue(volume, d_i + 1) then 1 else 0);

def neuDays = Max(0, baseDaysCount - accDays - disDays);

# ──────────────────────────────────────────────────────────────────────────────
# PLOTS, CURVES, ARROWS, BUBBLES & LABELS
# ──────────────────────────────────────────────────────────────────────────────
rec cupBreakoutPx;
rec cupBreakoutBars;
if (detectCup and close > startBasePrice) and cupBreakoutBars[1] == 0 {
    cupBreakoutPx = startBasePrice;
    cupBreakoutBars = 1;
} else if cupBreakoutBars[1] > 0 and cupBreakoutBars[1] < 10 {
    cupBreakoutPx = cupBreakoutPx[1];
    cupBreakoutBars = cupBreakoutBars[1] + 1;
} else {
    cupBreakoutPx = 0;
    cupBreakoutBars = 0;
}

rec dbBreakoutPx;
rec dbBreakoutBars;
if (detectDoubleBottom and close > scndPivHigh) and dbBreakoutBars[1] == 0 {
    dbBreakoutPx = scndPivHigh;
    dbBreakoutBars = 1;
} else if dbBreakoutBars[1] > 0 and dbBreakoutBars[1] < 10 {
    dbBreakoutPx = dbBreakoutPx[1];
    dbBreakoutBars = dbBreakoutBars[1] + 1;
} else {
    dbBreakoutPx = 0;
    dbBreakoutBars = 0;
}

rec handleBreakoutPx;
rec handleBreakoutBars;
if handleBreakout and handleBreakoutBars[1] == 0 {
    handleBreakoutPx = handlePeakLocked;
    handleBreakoutBars = 1;
} else if handleBreakoutBars[1] > 0 and handleBreakoutBars[1] < 10 {
    handleBreakoutPx = handleBreakoutPx[1];
    handleBreakoutBars = handleBreakoutBars[1] + 1;
} else {
    handleBreakoutPx = 0;
    handleBreakoutBars = 0;
}

plot BaseHighLine = if ShowPattern and isBase then startBasePrice else if ShowPattern and cupBreakoutBars > 0 then cupBreakoutPx else Double.NaN;
plot BaseLowLine  = if ShowPattern and isBase then lowBasePrice else Double.NaN;

BaseHighLine.SetDefaultColor(GlobalColor("Cup"));
BaseHighLine.SetStyle(Curve.SHORT_DASH);
BaseHighLine.SetLineWeight(2);

BaseLowLine.SetDefaultColor(GlobalColor("Cup"));
BaseLowLine.SetStyle(Curve.FIRM);
BaseLowLine.SetLineWeight(2);

# Handle Pivot Line
plot HandlePivotLine = if ShowCupHandle and handleForming then handlePeakLocked else if ShowCupHandle and handleBreakoutBars > 0 then handleBreakoutPx else Double.NaN;
HandlePivotLine.SetDefaultColor(GlobalColor("Cup"));
HandlePivotLine.SetStyle(Curve.SHORT_DASH);
HandlePivotLine.SetLineWeight(2);

# Curved Cup Line
plot CupBowl = if ShowPattern and isCup and !isDoubleBottom then
    if baseCount <= (baseCount / 2) then
        lowBasePrice + Sqr(((baseCount / 2) - baseCount) / Max(1, baseCount / 2)) * (startBasePrice - lowBasePrice)
    else
        lowBasePrice + Min(1, Sqr((baseCount - (baseCount / 2)) / Max(1, baseCount / 2))) * (startBasePrice - lowBasePrice)
else Double.NaN;

CupBowl.SetDefaultColor(GlobalColor("Cup"));
CupBowl.SetLineWeight(2);
CupBowl.HideBubble();
CupBowl.HideTitle();

# Double Bottom Pivot Line
plot DBPivotLine = if ShowPattern and isDoubleBottom then scndPivHigh else if ShowPattern and dbBreakoutBars > 0 then dbBreakoutPx else Double.NaN;
DBPivotLine.SetDefaultColor(GlobalColor("DB"));
DBPivotLine.SetStyle(Curve.LONG_DASH);
DBPivotLine.SetLineWeight(2);

# Breakout Arrows
plot CupBreakoutArrow = if ShowPattern and (detectCup and close > startBasePrice) then low * 0.99 else Double.NaN;
plot HandleBreakoutArrow = if ShowCupHandle and handleBreakout then low * 0.99 else Double.NaN;
plot DBBreakoutArrow = if ShowPattern and (detectDoubleBottom and close > scndPivHigh) then low * 0.99 else Double.NaN;
plot HTFBreakoutArrow = if EnableHTF and htfBreakout then low * 0.99 else Double.NaN;

CupBreakoutArrow.SetPaintingStrategy(PaintingStrategy.ARROW_UP);
CupBreakoutArrow.SetDefaultColor(GlobalColor("Cup"));
CupBreakoutArrow.SetLineWeight(4);

HandleBreakoutArrow.SetPaintingStrategy(PaintingStrategy.ARROW_UP);
HandleBreakoutArrow.SetDefaultColor(GlobalColor("Cup"));
HandleBreakoutArrow.SetLineWeight(4);

DBBreakoutArrow.SetPaintingStrategy(PaintingStrategy.ARROW_UP);
DBBreakoutArrow.SetDefaultColor(GlobalColor("DB"));
DBBreakoutArrow.SetLineWeight(4);

HTFBreakoutArrow.SetPaintingStrategy(PaintingStrategy.ARROW_UP);
HTFBreakoutArrow.SetDefaultColor(GlobalColor("HTF"));
HTFBreakoutArrow.SetLineWeight(4);

# Detection Chart Bubbles
AddChartBubble(ShowDetectionLabel and detectCup and !detectCup[1], low, "Cup", GlobalColor("Cup"), no);
AddChartBubble(ShowDetectionLabel and handleForming and !handleForming[1], low, "C+H", GlobalColor("Cup"), no);
AddChartBubble(ShowDetectionLabel and detectDoubleBottom and !detectDoubleBottom[1], low, "DB", GlobalColor("DB"), no);
AddChartBubble(ShowDetectionLabel and htfDetected, low, "HTF", GlobalColor("HTF"), no);

# Upper-Left Persistent Status Summary Labels
AddLabel(ShowStatusLabels and isCup and !handleForming,
    "Cup  D:" + AsPercent(cupDepth) + "  L:" + AsText(baseCount) + "b  A" + AsText(accDays) + " D" + AsText(disDays) + " N" + AsText(neuDays) + "  Piv:" + AsDollars(startBasePrice),
    GlobalColor("Cup"));

AddLabel(ShowStatusLabels and handleForming,
    "C+H  Hndl:" + AsText(handleBarCount) + "b  VolContr: OK  Piv:" + AsDollars(handlePeakLocked),
    GlobalColor("Cup"));

AddLabel(ShowStatusLabels and isDoubleBottom,
    "DB  Undercut: " + (if DBRequireUndercut then "YES" else "NO") + "  L:" + AsText(baseCount) + "b  Piv:" + AsDollars(scndPivHigh),
    GlobalColor("DB"));

AddLabel(ShowStatusLabels and htfFlagForming,
    "HTF Flag:" + AsText(htfAge) + "b  Piv:" + AsDollars(htfTop),
    GlobalColor("HTF"));

AddLabel(ShowStatusLabels and tradeActive,
    "TRADE ACTIVE  Piv:" + AsDollars(tradePivotPx) + "  Stop:" + AsDollars(tradePivotPx * 0.92) + "  Tgt:" + AsDollars(tradePivotPx * 1.20),
    GlobalColor("Entry"));